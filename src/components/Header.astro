---
interface SubNavItem {
    href: string;
    label: string;
}

interface NavSection {
    label: string;
    href?: string;
    children?: SubNavItem[];
}

const navItems: NavSection[] = [
    {
        href: "/",
        label: "Главная"
    },
    {
        href: "/korporativy-moskva",
        label: "Корпоративные мероприятия",
        children: [
            { href: "/novogodniy-korporativ", label: "Новогодний корпоратив" },
            { href: "/letnij-korporativ", label: "Летний корпоратив" },
            { href: "/korporativ-na-prirode", label: "Корпоратив на природе" },
            { href: "/art-korporativ", label: "Тематический корпоратив" },
            { href: "/yubilej-kompanii", label: "Юбилей компании" },
            { href: "/immersivnyj-korporativ", label: "Иммерсивные мероприятия" },
            { href: "/intellektualnye-igry", label: "Интеллектуальные игры" }
        ]
    },
    {
        href: "/delovye-meropriyatiya",
        label: "Деловые мероприятия",
        children: [
            { href: "/konferencii-i-forumy", label: "Конференции и форумы" },
            { href: "/strategicheskie-sessii-i-vorkshopy", label: "Стратегические сессии" },
            { href: "/seminary-i-treningi", label: "Семинары и тренинги" },
            { href: "/mice-delovoj-turizm", label: "MICE и Деловой туризм" },
            { href: "/prezentacii-novyh-produktov-launch-events", label: "Презентации новых продуктов" },
            { href: "/master-klassy", label: "Мастер-классы" }
        ]
    },
    {
        href: "/timbilding-moskva",
        label: "Тимбилдинг",
        children: [
            { href: "/aktivnye-timbildingi", label: "Активные тимбилдинги" },
            { href: "/kreativnye-timbildingi", label: "Креативные тимбилдинги" },
            { href: "/timbilding-na-prirode", label: "Тимбилдинг на природе" }
        ]
    },
    {
        href: "/festivali",
        label: "Фестивали",
        children: [
            { href: "/festivali", label: "Фестивали и городские события" },
            { href: "/gosudarstvennye-prazdniki", label: "Государственные праздники" }
        ]
    },
    {
        href: "/mediaproekty",
        label: "Медиапроекты",
        children: [
            { href: "/mediaproekty", label: "Медиапроекты" },
            { href: "/videoproduction", label: "Видеопродакшн" },
            { href: "/video-portfolio", label: "Видео мероприятий" }
        ]
    },
    {
        href: "/case",
        label: "Кейсы"
    },
    {
        href: "/blog",
        label: "Блог"
    },
    {
        href: "/o-nas",
        label: "О нас"
    },
    {
        href: "/tendery",
        label: "Тендеры"
    }
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-4">
            <!-- Logo -->
            <a href="/" class="flex-shrink-0 group">
                <svg
                    width="120"
                    height="32"
                    viewBox="0 0 120 32"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-8 transition-transform duration-300 group-hover:scale-[1.02]"
                >
                    <text
                        x="0"
                        y="24"
                        font-family="Inter, sans-serif"
                        font-weight="700"
                        font-size="20"
                        fill="#f15264"
                    >
                        TT
                    </text>
                    <text
                        x="32"
                        y="24"
                        font-family="Inter, sans-serif"
                        font-weight="500"
                        font-size="20"
                        fill="#1a1a1a"
                    >
                        Events
                    </text>
                </svg>
            </a>

            <!-- Mobile menu button with proper accessibility -->
            <button
                type="button"
                class="md:hidden flex flex-col gap-1.5 p-2 text-dark focus:outline-none mobile-menu-toggle"
                aria-label="Открыть меню"
                aria-expanded="false"
                id="mobile-menu-button"
                aria-controls="main-nav"
            >
                <span class="block w-6 h-[2px] bg-current"></span>
                <span class="block w-6 h-[2px] bg-current"></span>
                <span class="block w-6 h-[2px] bg-current"></span>
            </button>

            <!-- Navigation with proper accessibility -->
            <nav
                class="md:flex absolute left-0 right-0 top-full bg-white border-b shadow-lg md:static md:shadow-none md:border-0 py-4 md:py-0 px-4 md:px-0 flex-col md:flex-row md:items-center md:gap-8 justify-end main-nav hidden md:block"
                id="main-nav"
                aria-label="Основная навигация"
                role="navigation"
            >
                <ul
                    class="flex flex-col gap-2 md:flex-row md:items-center md:gap-6 list-none p-0 m-0 w-full"
                >
                    {navItems.map((section) => (
                        <li class="relative group">
                            {section.href ? (
                                <a
                                    href={section.href}
                                    class="block py-2 md:py-4 text-base font-medium text-text hover:text-primary transition-colors duration-200"
                                >
                                    {section.label}
                                </a>
                            ) : (
                                <span class="block py-2 md:py-4 text-base font-medium text-text cursor-default">
                                    {section.label}
                                </span>
                            )}

                            {section.children && section.children.length > 0 && (
                                <ul class="absolute top-full left-0 mt-1 w-60 bg-white shadow-xl border border-gray-100 rounded-lg py-2 hidden group-hover:flex flex-col z-50">
                                    {section.children.map((child) => (
                                        <li>
                                            <a
                                                href={child.href}
                                                class="block px-4 py-2 text-sm text-text hover:bg-primary/10 hover:text-primary transition-colors duration-200"
                                            >
                                                {child.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </li>
                    ))}
                </ul>
            </nav>
        </div>
    </div>
</header>
