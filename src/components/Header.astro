---
// Navigation data
interface SubNavItem {
    href: string;
    label: string;
}

interface NavSection {
    label: string;
    href?: string;
    children?: SubNavItem[];
}

const navItems: NavSection[] = [
    {
        label: "Направления",
        children: [
            { href: "/services/corporate-events", label: "Корпоративные мероприятия" },
            { href: "/services/mice-business", label: "MICE и деловые события" },
            { href: "/services/team-building", label: "Тимбилдинг" },
            { href: "/services/festivals", label: "Фестивали и городские события" }
        ]
    },
    {
        href: "/case",
        label: "Кейсы"
    },
    {
        href: "/media",
        label: "Media"
    },
    {
        href: "/for-business",
        label: "Для бизнеса"
    },
    {
        href: "/tenders",
        label: "Тендеры и госзакупки (44-ФЗ / 223-ФЗ)"
    },
    {
        href: "/faq",
        label: "FAQ"
    },
    {
        href: "/kontakty",
        label: "Контакты"
    }
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            <!-- Logo -->
            <a href="/" class="flex-shrink-0 group" aria-label="TT Events">
                <svg
                    width="120"
                    height="32"
                    viewBox="0 0 120 32"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-8 transition-transform duration-200 group-hover:scale-[1.02]"
                >
                    <text
                        x="0" y="24"
                        font-family="Inter, sans-serif"
                        font-weight="700" font-size="20"
                        fill="#f15264"
                    >TT</text>
                    <text
                        x="32" y="24"
                        font-family="Inter, sans-serif"
                        font-weight="500" font-size="20"
                        fill="#1a1a1a"
                    >Events</text>
                </svg>
            </a>

            <!-- Desktop navigation -->
            <div class="hidden md:flex items-center gap-6">
                <nav aria-label="Основная навигация" class="flex items-center gap-6">
                    {navItems.map((item) => {
                        if (item.children && item.children.length > 0) {
                            const menuId = `nav-${item.label.toLowerCase().replace(/[^\wа-яё]/gi, '')}`;
                            return (
                                <div class="relative" id={menuId} data-dropdown>
                                    <button
                                        type="button"
                                        class="flex items-center gap-1 px-3 py-2 text-sm font-medium text-gray-700 hover:text-[#f15264] transition-colors rounded-md focus:outline-none"
                                        aria-haspopup="true"
                                        aria-controls={menuId + "-menu"}
                                        aria-expanded="false"
                                        data-dropdown-btn
                                    >
                                        {item.label}
                                        <svg class="w-3 h-3 text-gray-500 transition-transform dropdown-arrow" viewBox="0 0 10 6" fill="none">
                                            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </button>

                                    <ul
                                        class="absolute top-full left-0 mt-2 w-auto min-w-[240px] bg-white shadow-lg rounded-xl border border-gray-100 py-2 hidden"
                                        id={menuId + "-menu"}
                                        aria-label={item.label}
                                        data-dropdown-menu
                                    >
                                        {item.children.map((child) => (
                                            <li>
                                                <a
                                                    href={child.href}
                                                    class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-red-50 hover:text-[#f15264] transition-colors rounded-lg"
                                                >
                                                    {child.label}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            );
                        } else if (item.href) {
                            return (
                                <a
                                    href={item.href}
                                    class="px-3 py-2 text-sm font-medium text-gray-700 hover:text-[#f15264] transition-colors rounded-md"
                                >
                                    {item.label}
                                </a>
                            );
                        }
                    })}
                </nav>

                <!-- CTA button -->
                <div class="ml-4 pl-4 border-l border-gray-200">
                    <a
                        href="https://t.me/ttevents"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center px-5 py-2 text-sm font-medium text-white bg-[#f15264] rounded-lg hover:bg-[#e04155] transition-colors shadow-sm"
                    >
                        Обсудить проект
                    </a>
                </div>
            </div>

            <!-- Mobile menu toggle button -->
            <button
                type="button"
                class="md:hidden p-2 text-gray-700 focus:outline-none mobile-menu-btn"
                aria-label="Меню"
                aria-expanded="false"
                aria-controls="mobile-nav"
            >
                <svg class="w-6 h-6 menu-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M3 12h18M3 6h18M3 18h18" stroke-width="2" stroke-linecap="round"/>
                </svg>
                <svg class="w-6 h-6 menu-icon-close hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                    <path d="M6 18L18 6M6 6l12 12" stroke-width="2" stroke-linecap="round"/>
                </svg>
            </button>
        </div>

        <!-- Mobile navigation -->
        <nav id="mobile-nav" class="md:hidden hidden">
            <ul class="flex flex-col gap-1 border-t border-gray-100 bg-white py-2 pb-4">
                {navItems.map((item) => {
                    if (item.children && item.children.length > 0) {
                        const subId = `m-${item.label.toLowerCase().replace(/[^\wа-яё]/gi, '')}`;
                        return (
                            <li>
                                <button
                                    type="button"
                                    class="w-full flex items-center justify-between px-4 py-3 text-[15px] font-medium text-gray-800 hover:text-[#f15264] rounded-md focus:outline-none mobile-accordion-btn"
                                    aria-expanded="false"
                                    aria-controls={subId}
                                >
                                    <span>{item.label}</span>
                                    <svg class="w-4 h-4 text-gray-500 transition-transform accordion-arrow" viewBox="0 0 10 6" fill="none">
                                        <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                                <ul
                                    id={subId}
                                    class="hidden flex-col gap-1 mt-1 pl-4"
                                    aria-label={item.label}
                                >
                                    {item.children.map((child) => (
                                        <li>
                                            <a
                                                href={child.href}
                                                class="block px-4 py-2 text-[14px] text-gray-600 hover:text-[#f15264] rounded-md"
                                            >
                                                {child.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </li>
                        );
                    } else if (item.href) {
                        return (
                            <li>
                                <a
                                    href={item.href}
                                    class="block px-4 py-3 text-[15px] font-medium text-gray-800 hover:text-[#f15264] rounded-md"
                                >
                                    {item.label}
                                </a>
                            </li>
                        );
                    }
                })}

                <!-- Mobile CTA -->
                <li class="pt-2 mt-2 border-t border-gray-100">
                    <a
                        href="https://t.me/ttevents"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center justify-center px-4 py-3 text-sm font-medium text-white bg-[#f15264] rounded-lg hover:bg-[#e04155] transition-colors"
                    >
                        Обсудить проект
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</header>

<script>
(function () {
    // === Desktop dropdown (hover + click) ===
    const dropdowns = document.querySelectorAll('[data-dropdown]');

    function closeAllDropdowns() {
        dropdowns.forEach(dd => {
            const menu = dd.querySelector('[data-dropdown-menu]');
            const btn = dd.querySelector('[data-dropdown-btn]');
            const arrow = dd.querySelector('.dropdown-arrow');
            if (menu) menu.classList.add('hidden');
            if (btn) btn.setAttribute('aria-expanded', 'false');
            if (arrow) arrow.style.transform = '';
        });
    }

    function openDropdown(dd) {
        closeAllDropdowns();
        const menu = dd.querySelector('[data-dropdown-menu]');
        const btn = dd.querySelector('[data-dropdown-btn]');
        const arrow = dd.querySelector('.dropdown-arrow');
        if (menu) menu.classList.remove('hidden');
        if (btn) btn.setAttribute('aria-expanded', 'true');
        if (arrow) arrow.style.transform = 'rotate(180deg)';
    }

    // Hover open
    document.querySelector('header')?.addEventListener('mouseenter', (e) => {
        const dd = e.target.closest('[data-dropdown]');
        if (dd) openDropdown(dd);
    }, true);

    // Click toggle
    dropdowns.forEach(dd => {
        dd.addEventListener('click', (e) => {
            const btn = dd.querySelector('[data-dropdown-btn]');
            if (btn && e.target.closest === btn || e.composedPath().includes(btn)) {
                e.preventDefault();
                openDropdown(dd);
            }
        });
    });

    // Close on leave header
    document.querySelector('header')?.addEventListener('mouseleave', closeAllDropdowns);

    // === Mobile menu ===
    const mobileBtn = document.querySelector('.mobile-menu-btn');
    const mobileNav = document.getElementById('mobile-nav');
    const iconOpen = document.querySelector('.menu-icon-open');
    const iconClose = document.querySelector('.menu-icon-close');

    function toggleMobileMenu() {
        const isOpen = !mobileNav?.classList.contains('hidden');

        if (isOpen) {
            mobileNav.classList.add('hidden');
            mobileBtn.setAttribute('aria-expanded', 'false');
            iconOpen?.classList.remove('hidden');
            iconClose?.classList.add('hidden');
            // Close all accordions
            document.querySelectorAll('[id^="m-"]').forEach(m => m.classList.add('hidden'));
            document.querySelectorAll('.mobile-accordion-btn').forEach(b => b.setAttribute('aria-expanded', 'false'));
        } else {
            mobileNav.classList.remove('hidden');
            mobileBtn.setAttribute('aria-expanded', 'true');
            iconOpen?.classList.add('hidden');
            iconClose?.classList.remove('hidden');
        }
    }

    mobileBtn?.addEventListener('click', toggleMobileMenu);

    // Mobile accordion
    document.querySelectorAll('.mobile-accordion-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            const targetId = btn.getAttribute('aria-controls');
            const menu = targetId ? document.getElementById(targetId) : null;
            const arrow = btn.querySelector('.accordion-arrow');

            if (!menu) return;

            const isOpen = !menu.classList.contains('hidden');

            // Close others
            document.querySelectorAll('[id^="m-"]').forEach(m => m !== menu && m.classList.add('hidden'));
            document.querySelectorAll('.mobile-accordion-btn').forEach(b => b !== btn && b.setAttribute('aria-expanded', 'false'));

            if (isOpen) {
                menu.classList.add('hidden');
                btn.setAttribute('aria-expanded', 'false');
                arrow?.removeProperty('transform');
            } else {
                menu.classList.remove('hidden');
                btn.setAttribute('aria-expanded', 'true');
                arrow?.style.setProperty('transform', 'rotate(180deg)');
            }
        });
    });

    // Close mobile menu on link click
    document.querySelectorAll('#mobile-nav a').forEach(link => {
        if (link.closest('.mobile-accordion-btn') === null) {
            link.addEventListener('click', () => toggleMobileMenu());
        }
    });
})();
</script>
