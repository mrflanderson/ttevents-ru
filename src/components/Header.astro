---
interface SubNavItem {
    href: string;
    label: string;
}

interface NavSection {
    label: string;
    href?: string;
    children?: SubNavItem[];
}

const navItems: NavSection[] = [
    {
        href: "/",
        label: "Главная"
    },
    {
        href: "/korporativy-moskva",
        label: "Корпоративные мероприятия",
        children: [
            { href: "/novogodniy-korporativ", label: "Новогодний корпоратив" },
            { href: "/letnij-korporativ", label: "Летний корпоратив" },
            { href: "/korporativ-na-prirode", label: "Корпоратив на природе" },
            { href: "/art-korporativ", label: "Тематический корпоратив" },
            { href: "/yubilej-kompanii", label: "Юбилей компании" },
            { href: "/immersivnyj-korporativ", label: "Иммерсивные мероприятия" },
            { href: "/intellektualnye-igry", label: "Интеллектуальные игры" }
        ]
    },
    {
        href: "/delovye-meropriyatiya",
        label: "Деловые мероприятия",
        children: [
            { href: "/konferencii-i-forumy", label: "Конференции и форумы" },
            { href: "/strategicheskie-sessii-i-vorkshopy", label: "Стратегические сессии" },
            { href: "/seminary-i-treningi", label: "Семинары и тренинги" },
            { href: "/mice-delovoj-turizm", label: "MICE и Деловой туризм" },
            { href: "/prezentacii-novyh-produktov-launch-events", label: "Презентации новых продуктов" },
            { href: "/master-klassy", label: "Мастер-классы" }
        ]
    },
    {
        href: "/timbilding-moskva",
        label: "Тимбилдинг",
        children: [
            { href: "/aktivnye-timbildingi", label: "Активные тимбилдинги" },
            { href: "/kreativnye-timbildingi", label: "Креативные тимбилдинги" },
            { href: "/timbilding-na-prirode", label: "Тимбилдинг на природе" }
        ]
    },
    {
        href: "/festivali",
        label: "Фестивали",
        children: [
            { href: "/festivali", label: "Фестивали и городские события" },
            { href: "/gosudarstvennye-prazdniki", label: "Государственные праздники" }
        ]
    },
    {
        href: "/mediaproekty",
        label: "Медиапроекты",
        children: [
            { href: "/mediaproekty", label: "Медиапроекты" },
            { href: "/videoproduction", label: "Видеопродакшн" },
            { href: "/video-portfolio", label: "Видео мероприятий" }
        ]
    },
    {
        href: "/case",
        label: "Кейсы"
    },
    {
        href: "/blog",
        label: "Блог"
    },
    {
        href: "/o-nas",
        label: "О нас"
    },
    {
        href: "/tendery",
        label: "Тендеры"
