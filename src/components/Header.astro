---
interface NavItem {
    href: string;
    label: string;
}

const navItems: NavItem[] = [
    { href: "/", label: "Главная" },
    { href: "/uslugi", label: "Услуги" },
    { href: "/case", label: "Кейсы" },
    { href: "/blog", label: "Блог" },
    { href: "/o-nas", label: "О нас" },
    { href: "/kontakty", label: "Контакты" },
];
---

<header class="sticky top-0 z-50 bg-white shadow-sm" client:once>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-4">
            <!-- Logo -->
            <a href="/" class="flex-shrink-0">
                <svg
                    width="120"
                    height="28"
                    viewBox="0 0 120 28"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-7"
                >
                    <text
                        x="0"
                        y="22"
                        font-family="Inter, sans-serif"
                        font-weight="700"
                        font-size="18"
                        fill="#1a1a1a"
                    >
                        TT
                    </text>
                    <text
                        x="28"
                        y="22"
                        font-family="Inter, sans-serif"
                        font-weight="400"
                        font-size="18"
                        fill="#666"
                    >
                        Events
                    </text>
                </svg>
            </a>

            <!-- Mobile menu button -->
            <button
                type="button"
                class="md:hidden flex flex-col gap-1 bg-none border-none cursor-pointer p-2 rounded-md focus:outline-none"
                aria-label="Открыть меню"
                client:load
            >
                <span class="block w-6 h-[2px] bg-dark"></span>
                <span class="block w-6 h-[2px] bg-dark"></span>
                <span class="block w-6 h-[2px] bg-dark"></span>
            </button>

            <!-- Navigation -->
            <nav
                class="md:block absolute left-0 right-0 top-full bg-white shadow-md md:static md:shadow-none md:border-0 py-4 md:py-0 px-4 md:px-0 md:flex md:flex-row md:items-center md:gap-8 md:justify-end"
                client:load
            >
                <ul
                    class="flex flex-col md:flex-row md:items-center md:gap-8 list-none p-0 m-0"
                >
                    {
                        navItems.map((item) => (
                            <li>
                                <a
                                    href={item.href}
                                    class="block py-2 md:py-0 text-text font-medium hover:text-primary transition-colors"
                                >
                                    {item.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </div>
    </div>
</header>
