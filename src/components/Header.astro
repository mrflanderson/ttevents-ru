---
interface SubNavItem {
    href: string;
    label: string;
}

interface NavSection {
    label: string;
    href?: string;
    children?: SubNavItem[];
}

const navItems: NavSection[] = [
    {
        href: "/",
        label: "Главная"
    },
    {
        label: "Направления",
        children: [
            { href: "/services/corporate-events", label: "Корпоративные мероприятия" },
            { href: "/services/mice-business", label: "MICE и деловые события" },
            { href: "/services/team-building", label: "Тимбилдинг" },
            { href: "/services/festivals", label: "Фестивали и городские события" }
        ]
    },
    {
        href: "/case",
        label: "Кейсы"
    },
    {
        href: "/media",
        label: "Media"
    },
    {
        href: "/for-business",
        label: "Для бизнеса"
    },
    {
        href: "/faq",
        label: "FAQ"
    },
    {
        href: "/kontakty",
        label: "Контакты"
    }
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center py-4">
            <!-- Logo -->
            <a href="/" class="flex-shrink-0 group" aria-label="TT Events">
                <svg
                    width="120"
                    height="32"
                    viewBox="0 0 120 32"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-8 transition-transform duration-300 group-hover:scale-[1.02]"
                    aria-hidden="true"
                >
                    <text
                        x="0"
                        y="24"
                        font-family="Inter, sans-serif"
                        font-weight="700"
                        font-size="20"
                        fill="#f15264"
                    >
                        TT
                    </text>
                    <text
                        x="32"
                        y="24"
                        font-family="Inter, sans-serif"
                        font-weight="500"
                        font-size="20"
                        fill="#1a1a1a"
                    >
                        Events
                    </text>
                </svg>
            </a>

            <!-- Desktop navigation + CTA -->
            <div class="hidden md:flex items-center gap-8">
                <nav aria-label="Основная навигация" class="flex items-center gap-8">
                    {navItems.map((section) => {
                        const hasChildren = section.children && section.children.length > 0;
                        const menuId = hasChildren ? `menu-${section.label.toLowerCase().replace(/[^\wа-яё]/gi, '').trim()}` : null;

                        return (
                            <div class="relative group"> {section.href && !hasChildren ? (
                                <a
                                    href={section.href}
                                    class="block py-4 text-base font-medium text-text hover:text-primary transition-colors duration-200"
                                >
                                    {section.label}
                                </a>
                            ) : hasChildren ? (
                                <div class="relative">
                                    <button
                                        type="button"
                                        class="inline-flex items-center gap-1 py-4 text-base font-medium text-text hover:text-primary transition-colors duration-200"  aria-haspopup="true" aria-controls={menuId} aria-expanded="false" aria-label={`${section.label}, открыть подменю`}
                                        data-dropdown-trigger
                                    >
                                        {section.label}
                                    </button>

                                    <ul
                                        id={menuId}
                                        class="absolute top-full left-0 mt-1 w-60 bg-white shadow-xl border border-gray-100 rounded-lg py-2 hidden flex-col z-50"
                                        aria-label={section.label}
                                    >
                                        {section.children.map((child) => (
                                            <li>
                                                <a
                                                    href={child.href}
                                                    class="block px-4 py-2 text-sm text-text hover:bg-primary/10 hover:text-primary transition-colors duration-200"
                                                >
                                                    {child.label}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ) : (
                                <span class="block py-4 text-base font-medium text-text cursor-default">
                                    {section.label}
                                </span>
                            )}
                            </div>
                        );
                    })}
                </nav>

                <!-- CTA -->
                <a
                    href="https://t.me/ttevents"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-[#f15264] rounded-lg hover:bg-[#e04155] transition-colors"
                >
                    Обсудить проект
                </a>
            </div>

            <!-- Mobile menu button with proper accessibility -->
            <button
                type="button"
                class="md:hidden flex flex-col gap-1.5 p-2 text-dark focus:outline-none mobile-menu-toggle"
                aria-label="Открыть меню"
                aria-expanded="false"
                aria-controls="mobile-main-nav"
                id="mobile-menu-button"
            >
                <span class="block w-6 h-[2px] bg-current"></span>
                <span class="block w-6 h-[2px] bg-current"></span>
                <span class="block w-6 h-[2px] bg-current"></span>
            </button>

            <!-- Mobile navigation wrapper -->
            <div
              class="md:hidden absolute left-0 right-0 top-full bg-white border-b border-gray-100 shadow-lg overflow-y-auto"
              id="mobile-main-nav"
              aria-label="Основная навигация (мобильное меню)"
              role="region"
              style="
                max-height: 0;
                opacity: 0;
                display: none;
                transition: max-height 0.25s ease-out, opacity 0.22s ease-out;
                padding-top: 0;
                padding-bottom: 0;
              "
            >
              <nav>
                <ul
                  class="flex flex-col gap-2 list-none p-0 m-0 w-full px-4 pt-3 pb-4"
                >
                  {navItems.map((section) => {
                    const hasChildren = section.children && section.children.length > 0;
                    const submenuId = hasChildren ? `mobile-menu-${section.label.toLowerCase().replace(/[^\\wа-яё]/gi, '').trim()}` : null;

                    return (
                      <li class="relative">
                        {section.href && !hasChildren ? (
                          <a
                            href={section.href}
                            class="block min-h-[44px] px-2 py-2.5 text-[15px] font-medium text-gray-800 hover:text-primary transition-colors duration-150 rounded"
                            data-mobile-nav-link
                          >
                            {section.label}
                          </a>
                        ) : hasChildren ? (
                          <>
                            <button
                              type="button"
                              class="w-full flex justify-between items-center min-h-[44px] px-2 py-2.5 text-[15px] font-medium text-gray-800 hover:text-primary transition-colors duration-150 rounded"
                              aria-controls={submenuId}
                              aria-expanded="false"
                              aria-haspopup="true"
                              aria-label={`${section.label}, открыть подменю`}
                              data-mobile-accordion
                            >
                              <span>{section.label}</span>
                              <span class="ml-2 w-5 h-5 flex items-center justify-center">
                                <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                                  <path d="M1 1L5 5L9 1" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" strokeLinejoin="round"/>
                                </svg>
                              </span>
                            </button>
                            <div
                              id={submenuId}
                              class="mt-1 mb-1 pl-2 border-l border-gray-100 flex flex-col gap-1 overflow-hidden"
                              style="max-height:0; opacity:0; transition: max-height 0.22s ease, opacity 0.18s ease;"
                              aria-label={section.label}
                            >
                              {section.children.map((child) => (
                                <a
                                  href={child.href}
                                  class="block min-h-[44px] px-2 py-1.5 text-[15px] text-gray-700 hover:text-primary transition-colors duration-150 rounded"
                                  data-mobile-nav-link
                                >
                                  {child.label}
                                </a>
                              ))}
                            </div>
                          </>
                        ) : (
                          <span class="block min-h-[44px] px-2 py-2.5 text-[15px] font-medium text-gray-700">
                            {section.label}
                          </span>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </nav>
            </div>
          </div>
        </div>
      </header>

<script>
    // Desktop dropdown accessibility: hover-friendly + keyboard support
    (function () {
        const header = document.querySelector('header');
        if (!header) return;

        const dropdowns = [];

        header.querySelectorAll('[data-dropdown-trigger]').forEach((el) => {
            const btn = el;
            const menu = btn.parentElement?.querySelector('ul[id]');
            if (!menu) return;
            dropdowns.push({ button: btn, menu });
        });

        // Mouse: hover to show
        header.addEventListener('mouseenter', (e) => {
            const t = e.target;
            const btn = t?.closest('[data-dropdown-trigger]');
            if (!btn) return;
            const dd = dropdowns.find((d) => d.button === btn);
            if (!dd) return;

            dropdowns.forEach((d) => {
                d.menu.classList.add('hidden');
                d.button.setAttribute('aria-expanded', 'false');
            });

            dd.menu.classList.remove('hidden');
            dd.menu.classList.add('flex');
            dd.button.setAttribute('aria-expanded', 'true');
        });

        // Click / keyboard: toggle dropdown
        dropdowns.forEach((dd) => {
            dd.button.addEventListener('click', (e) => {
                e.preventDefault();
                const willExpand = dd.button.getAttribute('aria-expanded') !== 'true';

                dropdowns.forEach((d) => {
                    d.menu.classList.add('hidden');
                    d.button.setAttribute('aria-expanded', 'false');
                });

                if (willExpand) {
                    dd.menu.classList.remove('hidden');
                    dd.menu.classList.add('flex');
                    dd.button.setAttribute('aria-expanded', 'true');
                    dd.menu.querySelector('a')?.focus();
                }
            });
        });

        // Keyboard handling
        dropdowns.forEach((dd) => {
            const links = Array.from(dd.menu.querySelectorAll('a'));
            dd.button.addEventListener('keydown', (e) => {
                const key = e.key;
                const expanded = dd.button.getAttribute('aria-expanded') === 'true';

                if (key === 'ArrowDown' && !expanded) {
                    e.preventDefault();
                    dropdowns.forEach((d) => {
                        d.menu.classList.add('hidden');
                        d.button.setAttribute('aria-expanded', 'false');
                    });
                    dd.menu.classList.remove('hidden');
                    dd.menu.classList.add('flex');
                    dd.button.setAttribute('aria-expanded', 'true');
                    links[0]?.focus();
                    return;
                }

                if (key === 'Escape') {
                    e.preventDefault();
                    dd.menu.classList.add('hidden');
                    dd.button.setAttribute('aria-expanded', 'false');
                    dd.button.focus();
                    return;
                }
            });

            dd.menu.addEventListener('keydown', (e) => {
                const key = e.key;
                const current = document.activeElement;
                const idx = links.indexOf(current);

                if (key === 'ArrowDown') {
                    e.preventDefault();
                    const next = links[(idx + 1) % links.length];
                    next?.focus();
                } else if (key === 'ArrowUp') {
                    e.preventDefault();
                    const prev = links[(idx - 1 + links.length) % links.length];
                    prev?.focus();
                } else if (key === 'Escape') {
                    e.preventDefault();
                    dd.menu.classList.add('hidden');
                    dd.button.setAttribute('aria-expanded', 'false');
                    dd.button.focus();
                } else if (key === 'Tab') {
                    dd.menu.classList.add('hidden');
                }
            });
        });

        // Mobile menu logic: reliable toggle, smooth open/close, auto-close on link
        const mobileButton = document.getElementById('mobile-menu-button');
        const mobileNav = document.getElementById('mobile-main-nav');
        const accordionButtons = header.querySelectorAll('[data-mobile-accordion]');
        const mobileLinks = header.querySelectorAll('[data-mobile-nav-link]');

        let previousElement = null;
        let isOpen = false;

        function getMaxHeight(el) {
            const s = getComputedStyle(el);
            const scrollH = el.scrollHeight;
            // Clamp to a sane range so animation is smooth but not insane
            return Math.min(scrollH, 900);
        }

        function openMobileMenu() {
            if (!mobileButton || !mobileNav) return;
            isOpen = true;
            previousElement = document.activeElement;

            mobileButton.setAttribute('aria-expanded', 'true');
            mobileButton.setAttribute('aria-label', 'Закрыть меню');
            mobileNav.style.display = 'block';

            const mh = getMaxHeight(mobileNav);
            mobileNav.style.maxHeight = '0px';

            // Force reflow so transition triggers
            mobileNav.offsetHeight;

            mobileNav.style.maxHeight = mh + 'px';
            mobileNav.style.opacity = '1';
        }

        function closeMobileMenu(restoreFocus = true) {
            if (!mobileButton || !mobileNav) return;
            isOpen = false;

            mobileButton.setAttribute('aria-expanded', 'false');
            mobileButton.setAttribute('aria-label', 'Открыть меню');
            mobileNav.style.maxHeight = '0px';
            mobileNav.style.opacity = '0';

            // After transition, fully hide
            setTimeout(() => {
                mobileNav.style.display = 'none';
            }, 250);

            if (restoreFocus && previousElement && document.body.contains(previousElement)) {
                previousElement.focus();
            }
        }

        function toggleMobileMenu() {
            if (isOpen) {
                closeMobileMenu();
            } else {
                openMobileMenu();
            }
        }

        // Accordion behavior for submenus inside mobile menu
        function toggleAccordion(btn) {
            const targetId = btn.getAttribute('aria-controls');
            const menu = targetId ? document.getElementById(targetId) : null;
            if (!menu) return;

            const isExpanded = btn.getAttribute('aria-expanded') === 'true';

            if (!isExpanded) {
                // Expand with animation
                btn.setAttribute('aria-expanded', 'true');
                menu.style.display = 'flex';
                const mh = getMaxHeight(menu);
                menu.style.maxHeight = '0px';
                menu.offsetHeight;
                menu.style.maxHeight = mh + 'px';
                menu.style.opacity = '1';
            } else {
                // Collapse
                btn.setAttribute('aria-expanded', 'false');
                menu.style.maxHeight = '0px';
                menu.style.opacity = '0';
                setTimeout(() => {
                    menu.style.display = 'none';
                }, 220);
            }
        }

        // Close mobile menu when clicking any navigation link inside it
        function handleMobileLinkClick() {
            // Allow navigation, but close menu after a short delay
            setTimeout(closeMobileMenu, 60);
        }

        if (mobileButton) {
            mobileButton.addEventListener('click', () => {
                toggleMobileMenu();
            });
        }

        accordionButtons.forEach((btn) => {
            btn.addEventListener('click', () => {
                toggleAccordion(btn);
            });
        });

        mobileLinks.forEach((link) => {
            link.addEventListener('click', () => {
                handleMobileLinkClick();
            });
        });

        // Close on Escape
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && isOpen) {
                closeMobileMenu();
                mobileButton.focus();
            }
        });
    })();
</script>
