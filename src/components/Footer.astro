---
type FooterLink = { href: string; label: string };

type FooterSection = {
  title: string;
  links: FooterLink[];
};

const companySection: FooterSection = {
  title: 'Компания',
  links: [
    { href: '/o-nas', label: 'О нас' },
    { href: '/kontakty', label: 'Контакты' },
    { href: '/tendery', label: 'Тендеры' },
  ],
};

const directionsSection: FooterSection = {
  title: 'Направления',
  links: [
    { href: '/services/corporate-events', label: 'Корпоративные мероприятия' },
    { href: '/services/mice-business', label: 'MICE и деловые события' },
    { href: '/services/team-building', label: 'Тимбилдинг' },
    { href: '/services/festivals', label: 'Фестивали и городские события' },
  ],
};

const resourcesSection: FooterSection = {
  title: 'Ресурсы',
  links: [
    { href: '/case', label: 'Кейсы' },
    { href: '/media', label: 'Media' },
    { href: '/faq', label: 'FAQ' },
  ],
};

const footerSections: FooterSection[] = [
  companySection,
  directionsSection,
  resourcesSection,
];

const phone = '+7 (916) 906-44-90';
const phoneLink = 'tel:+79169064490';
const email = 'mail@ttevents.ru';
const emailLink = `mailto:${email}`;
---

<footer class="relative bg-gradient-to-b from-[#0f172a] to-[#020617] text-white overflow-hidden">
  <!-- Subtle background pattern -->
  <div class="absolute inset-0 opacity-5 bg-[radial-gradient(#ffffff_1px,transparent_1px)] bg-[size:20px_20px]"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    {/* Header row: logo + short description */}
    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8 gap-4">
      <a href="/" class="inline-flex items-center">
        <span class="text-2xl font-bold bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent hover:from-[#f15264] hover:to-[#ff7b8a] transition-all duration-300">
          TT Events
        </span>
      </a>
      <p class="text-sm text-gray-300 max-w-md">
        Агентство полного цикла: корпоративы, MICE, тимбилдинги, фестивали. 2000+ проектов с 2006 года.
      </p>
    </div>

    {/* Main grid: sections + contacts */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {footerSections.map((section) => (
        <div>
          <h4 class="text-xs font-semibold uppercase tracking-widest text-gray-300 mb-3">
            {section.title}
          </h4>
          <ul class="space-y-2">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-gray-300 hover:text-[#f15264] transition-colors duration-150"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      {/* Contacts column */}
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-gray-300 mb-3">
          Контакты
        </h4>
        <div class="flex flex-col gap-2 text-sm text-gray-300">
          <a
            href={phoneLink}
            class="hover:text-[#f15264] transition-colors duration-150"
          >
            {phone}
          </a>
          <a
            href={emailLink}
            class="hover:text-[#f15264] transition-colors duration-150"
          >
            {email}
          </a>
          <p class="text-xs text-gray-400">
            Для B2B-запросов и тендеров — напишите на e-mail или оставьте запрос на сайте.
          </p>
        </div>
      </div>
    </div>

    {/* Bottom bar */}
    <div class="mt-10 pt-6 border-t border-white/10 flex flex-col md:flex-row md:items-center md:justify-between gap-2">
      <p class="text-xs text-gray-400">
        © {new Date().getFullYear()} TT Events. Все права защищены.
      </p>
      <nav class="flex flex-wrap items-center gap-4 text-xs text-gray-400">
        <a href="/o-nas" class="hover:text-[#f15264] transition-colors duration-150">
          О нас
        </a>
        <a href="/case" class="hover:text-[#f15264] transition-colors duration-150">
          Кейсы
        </a>
        <a href="/media" class="hover:text-[#f15264] transition-colors duration-150">
          Media
        </a>
        <a href="/faq" class="hover:text-[#f15264] transition-colors duration-150">
          FAQ
        </a>
        <a href="/tendery" class="hover:text-[#f15264] transition-colors duration-150">
          Тендеры
        </a>
      </nav>
    </div>
  </div>
</footer>
