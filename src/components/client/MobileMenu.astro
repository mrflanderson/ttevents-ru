<!--
  MobileMenu.astro — Client-side mobile menu behavior.
  - Synced with Header.astro routes and structure.
  - Reliable toggle, smooth animation, auto-close on link click.
-->
<div id="mobile-menu-root" class="sr-only">
  <!-- This component exists only to attach behavior via a script. -->
</div>

<script is:inline>
  (function () {
    // Guard: ensure we are on mobile-size and elements exist.
    const mobileButton = document.getElementById('mobile-menu-button');
    const mobileNav = document.getElementById('mobile-main-nav');
    if (!mobileButton || !mobileNav) return;

    const accordionButtons = mobileNav.querySelectorAll('[data-mobile-accordion]');
    const mobileLinks = mobileNav.querySelectorAll('a[data-mobile-nav-link]');

    let previousElement = null;
    let isOpen = false;

    // Helpers for smooth expand/collapse
    function getMaxHeight(el) {
      const h = el.scrollHeight;
      return Math.min(h, 900);
    }

    function ensureTransitionStyles() {
      if (mobileNav.dataset._mmInit === '1') return;
      mobileNav.dataset._mmInit = '1';

      Object.assign(mobileNav.style, {
        maxHeight: '0px',
        opacity: '0',
        overflowY: 'auto',
        transition: 'max-height 0.25s ease-out, opacity 0.22s ease-out'
      });
    }

    function openMenu() {
      ensureTransitionStyles();
      isOpen = true;
      previousElement = document.activeElement;

      mobileButton.setAttribute('aria-expanded', 'true');
      mobileButton.setAttribute('aria-label', 'Закрыть меню');
      mobileNav.style.display = 'block';

      const mh = getMaxHeight(mobileNav);
      mobileNav.style.maxHeight = '0px';
      mobileNav.offsetHeight; // reflow
      mobileNav.style.maxHeight = mh + 'px';
      mobileNav.style.opacity = '1';
    }

    function closeMenu(restoreFocus = true) {
      if (!isOpen && mobileNav.style.display === 'none') return;
      isOpen = false;

      mobileButton.setAttribute('aria-expanded', 'false');
      mobileButton.setAttribute('aria-label', 'Открыть меню');
      mobileNav.style.maxHeight = '0px';
      mobileNav.style.opacity = '0';

      setTimeout(() => {
        mobileNav.style.display = 'none';
      }, 250);

      if (restoreFocus && previousElement && document.body.contains(previousElement)) {
        previousElement.focus();
      }
    }

    function toggleMenu() {
      if (isOpen) closeMenu();
      else openMenu();
    }

    // Toggle button
    mobileButton.addEventListener('click', () => {
      toggleMenu();
    });

    // Accordion: Направления / sub-items
    accordionButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('aria-controls');
        const menu = targetId ? document.getElementById(targetId) : null;
        if (!menu) return;

        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        if (!isExpanded) {
          btn.setAttribute('aria-expanded', 'true');
          menu.style.display = 'flex';
          const mh = getMaxHeight(menu);
          menu.style.maxHeight = '0px';
          menu.offsetHeight;
          menu.style.maxHeight = mh + 'px';
          menu.style.opacity = '1';
        } else {
          btn.setAttribute('aria-expanded', 'false');
          menu.style.maxHeight = '0px';
          menu.style.opacity = '0';
          setTimeout(() => {
            menu.style.display = 'none';
          }, 220);
        }
      });
    });

    // Close menu when a nav link is clicked
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        // Short delay to allow navigation while closing menu
        setTimeout(() => closeMenu(), 60);
      });
    });

    // Escape key closes menu
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closeMenu();
        mobileButton.focus();
      }
    });

    // Optional: close when clicking outside mobile menu
    document.addEventListener('mousedown', (e) => {
      if (!isOpen) return;
      const target = e.target;
      const isInside = mobileNav.contains(target);
      const isButton = target === mobileButton || mobileButton.contains(target);
      if (!isInside && !isButton) {
        closeMenu();
      }
    });
  })();
</script>
