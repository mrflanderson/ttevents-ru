---
// src/components/client/MobileMenu.astro
// Client-side mobile menu handler (runs via is:inline script, no Astro hydration directive)
---

<div class="mobile-menu-handler">
    <style>
        .main-nav.active {
            display: flex;
        }

        .mobile-menu-toggle.active span:first-child {
            transform: translateY(6px) rotate(45deg);
        }
        .mobile-menu-toggle.active span:nth-child(2) {
            opacity: 0;
        }
        .mobile-menu-toggle.active span:last-child {
            transform: translateY(-6px) rotate(-45deg);
        }
    </style>

    <script is:inline>
        (function () {
            const toggle = document.querySelector('.mobile-menu-toggle');
            const nav = document.getElementById('mobile-main-nav') || document.querySelector('.main-nav');
            if (!toggle || !nav) return;

            let previousElement = document.activeElement;

            function getFocusableElements(container) {
                return Array.from(
                    container.querySelectorAll(
                        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
                    )
                );
            }

            function openMenu() {
                previousElement = document.activeElement;
                nav.classList.add('active');
                toggle.classList.add('active');
                toggle.setAttribute('aria-expanded', 'true');
                toggle.setAttribute('aria-label', 'Закрыть меню');

                const firstFocusable = getFocusableElements(nav)[0];
                (firstFocusable || nav).focus();
            }

            function closeMenu() {
                nav.classList.remove('active');
                toggle.classList.remove('active');
                toggle.setAttribute('aria-expanded', 'false');
                toggle.setAttribute('aria-label', 'Открыть меню');

                if (previousElement && document.body.contains(previousElement)) {
                    previousElement.focus();
                } else {
                    toggle.focus();
                }
            }

            toggle.addEventListener('click', () => {
                const isOpen = nav.classList.contains('active');
                if (isOpen) closeMenu();
                else openMenu();
            });

            const accordions = document.querySelectorAll('[data-mobile-accordion]');
            accordions.forEach((btn) => {
                btn.addEventListener('click', () => {
                    const targetId = btn.getAttribute('aria-controls');
                    const menu = targetId ? document.getElementById(targetId) : null;
                    if (!menu) return;

                    const expanded = btn.getAttribute('aria-expanded') === 'true';
                    btn.setAttribute('aria-expanded', String(!expanded));
                    menu.classList.toggle('hidden');
                });
            });

            nav.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    e.preventDefault();
                    closeMenu();
                    toggle.focus();
                    return;
                }

                if (e.key === 'Tab') {
                    const focusables = getFocusableElements(nav);
                    if (!focusables.length) return;

                    const first = focusables[0];
                    const last = focusables[focusables.length - 1];
                    const current = document.activeElement;

                    if (e.shiftKey && current === first) {
                        e.preventDefault();
                        last.focus();
                    } else if (!e.shiftKey && current === last) {
                        e.preventDefault();
                        first.focus();
                    }
                }
            });
        })();
    </script>
</div>
