---
interface Props {
    title: string;
    href: string;
    image?: string;
    category?: string;
}

const {
    title,
    href,
    image = "/g/s3/mosaic/images/default-case.jpg",
    category = "Кейс",
} = Astro.props;
---

<article
    class="bg-white rounded-xl shadow-card hover:-translate-y-1 transition-all duration-300 overflow-hidden"
>
    <a href={href} class="block text-inherit no-underline">
        <div class="relative h-48 overflow-hidden">
            <img
                src={image}
                alt={title}
                width="400"
                height="300"
                sizes="(max-width: 768px) 100vw, 33vw"
                loading="lazy"
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
            />
            <span
                class="absolute top-4 left-4 bg-primary text-white text-xs font-semibold px-3 py-1 rounded"
            >
                {category}
            </span>
        </div>
        <div class="p-6">
            <h3 class="text-lg font-heading font-semibold">{title}</h3>
        </div>
    </a>
</article>
