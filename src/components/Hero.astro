---
interface Props {
    title: string;
    subtitle?: string;
    ctaText: string;
    ctaHref: string;
    ctaSecondaryText?: string;
    ctaSecondaryHref?: string;
    videoSrc?: string;
    poster?: string;
    backgroundImage?: string;
}

const {
    title,
    subtitle,
    ctaText,
    ctaHref,
    ctaSecondaryText,
    ctaSecondaryHref,
    videoSrc = "/video/hero_new2.mp4",
    poster = "/video/hero_new2.png",
    backgroundImage = "/video/hero_new2.png",
} = Astro.props;
---

<section class="relative min-h-[650px] flex items-center text-white overflow-hidden overflow-x-hidden">
    <!-- Video Background -->
    <video
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        poster={poster}
        class="absolute inset-0 w-full h-full object-cover"
    >
        <source src={videoSrc} type="video/mp4" />
    </video>
    <div class="absolute inset-0 bg-black/50"></div>



    <!-- Content Container -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="max-w-[860px]">
            <h1
                class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-4 leading-tight text-white"
            >
                {title}
            </h1>

            {subtitle && (
                <p class="text-lg md:text-xl text-white/90 mb-8 max-w-2xl">
                    {subtitle}
                </p>
            )}

            <div class="flex flex-col sm:flex-row gap-4 items-center w-full">
                <a
                    href={ctaHref}
                    class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 rounded-lg font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg hover:shadow-xl transition-all duration-300 min-h-[44px]"
                >
                    {ctaText}
                </a>
                {ctaSecondaryText && ctaSecondaryHref && (
                    <a
                        href={ctaSecondaryHref}
                        class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3.5 rounded-lg font-semibold bg-white/10 border-2 border-white/20 hover:bg-white hover:text-primary text-white backdrop-blur-sm shadow-lg hover:shadow-xl transition-all duration-300 min-h-[44px]"
                    >
                        {ctaSecondaryText}
                    </a>
                )}
            </div>
        </div>
    </div>

    <!-- Subtle Gradient at Bottom for Depth -->
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-black/80 to-transparent z-10 pointer-events-none"></div>
</section>
