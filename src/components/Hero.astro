---
interface Props {
    title: string;
    subtitle?: string;
    ctaText: string;
    ctaHref: string;
    videoSrc?: string;
    backgroundImage?: string;
}

const {
    title,
    subtitle,
    ctaText,
    ctaHref,
    videoSrc = "/f/m24_v2.mp4",
    backgroundImage = "/g/s3/mosaic/images/hero-bg.jpg",
} = Astro.props;
---

<section
    class="relative min-h-[600px] flex items-center text-white overflow-hidden"
>
    <img
        src={backgroundImage}
        alt=""
        class="absolute inset-0 w-full h-full object-cover"
        aria-hidden="true"
    />
    <div class="absolute inset-0 bg-black/50"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="max-w-[800px]">
            <h1
                class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-4"
            >
                {title}
            </h1>
            {
                subtitle && (
                    <p class="text-lg md:text-xl text-white/90 mb-10">
                        {subtitle}
                    </p>
                )
            }
            <a
                href={ctaHref}
                class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg hover:shadow-xl transition-all duration-300"
            >
                {ctaText}
            </a>
        </div>
    </div>

    {
        videoSrc && (
            <video
                autoplay
                muted
                loop
                playsinline
                class="absolute inset-0 w-full h-full object-cover -z-10"
                preload="none"
            >
                <source src={videoSrc} type="video/mp4" />
            </video>
        )
    }
</section>
