---
import '../styles/global.css';

interface Props {
  title: string;
  subtitle?: string;
  ctaText: string;
  ctaHref: string;
  videoSrc?: string;
  backgroundImage?: string;
}

const { title, subtitle, ctaText, ctaHref, videoSrc = '/f/m24_v2.mp4', backgroundImage = '/g/s3/mosaic/images/hero-bg.jpg' } = Astro.props;
---

<section class="hero" style="background-image: url('{backgroundImage}');">
  <div class="hero-overlay"></div>
  <div class="container">
    <div class="hero-content">
      <h1>{title}</h1>
      {subtitle && <p class="subtitle">{subtitle}</p>}
      <a href={ctaHref} class="btn btn-primary">{ctaText}</a>
    </div>
  </div>
  {videoSrc && <video autoplay muted loop playsinline class="hero-video" preload="none">
    <source src={videoSrc} type="video/mp4">
  </video>}
</section>

<style>
  .hero {
    position: relative;
    background-size: cover;
    background-position: center;
    min-height: 600px;
    display: flex;
    align-items: center;
    color: white;
  }
  
  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
  }
  
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }
  
  .hero h1 {
    font-size: 3rem;
    margin-bottom: var(--spacing-md);
  }
  
  .hero .subtitle {
    font-size: 1.25rem;
    margin-bottom: var(--spacing-xl);
    opacity: 0.9;
  }
  
  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }
  
  @media (max-width: 768px) {
    .hero h1 {
      font-size: 2rem;
    }
  }
</style>
