---
// Universal page hero for inner pages (e.g. /tendery, /faq, /for-business)
// Props: title, subtitle, ctaLabel/ctaHref (optional), backgroundImage

interface ButtonLink {
  label?: string;
  href?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  cta?: ButtonLink;
  backgroundImage?: string;
}

const { title, subtitle, cta, backgroundImage = "/images/tender-hero.jpg" } = Astro.props;
---

<section class="relative min-h-[420px] md:min-h-[500px] flex items-center text-white overflow-hidden">
  <img
    src={backgroundImage}
    alt={title}
    loading="eager"
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div class="absolute inset-0 bg-black/60"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-[800px]">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-4 leading-tight">
        {title}
      </h1>
      {subtitle && (
        <p class="text-lg md:text-xl text-white/90 mb-8 max-w-xl">
          {subtitle}
        </p>
      )}
      {cta?.label && cta.href && (
        <a
          href={cta.href}
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg hover:shadow-xl transition-all duration-300"
        >
          {cta.label}
        </a>
      )}
    </div>
  </div>
</section>
