---
// Universal process/timeline section (horizontal on desktop, vertical on mobile)
interface Step {
  number?: number;
  label: string;
  description: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  steps: Step[];
}

const { title = "Как мы работаем", subtitle = "От задачи до реализации. Без лишних шагов.", steps } = Astro.props;
---

<section class="py-20 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-10">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-3">
        {title}
      </h2>
      {subtitle && (
        <p class="text-lg text-gray-500 max-w-2xl">
          {subtitle}
        </p>
      )}
    </div>

    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      {steps.map((step, index) => (
        <>
          <div class="flex-1 flex flex-col">
            <div class="flex items-center gap-3">
              <div class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-primary text-primary text-sm font-semibold">
                {step.number ?? index + 1}
              </div>
              <span class="text-sm font-medium text-gray-900">{step.label}</span>
            </div>
            <p class="text-xs text-gray-500 ml-11">
              {step.description}
            </p>
          </div>
          {index < steps.length - 1 && (
            <div class="hidden md:flex flex-1 items-center">
              <div class="h-px w-full bg-gray-200"></div>
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>
