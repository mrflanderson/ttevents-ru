---
// Layout.astro: thin wrapper that delegates to BaseLayout and keeps existing behavior.
// All pages use this component; BaseLayout is the single source of truth for SEO shell.

import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import MobileMenu from "./client/MobileMenu.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  canonicalURL?: string; // legacy prop name (still used across pages)
  jsonLd?: object;
}

const {
  title,
  description,
  keywords,
  ogTitle,
  ogDescription,
  ogImage,
  canonicalURL,
  jsonLd,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  canonical={canonicalURL}
  jsonLd={jsonLd}
>
  <!-- Inject existing header, footer, mobile menu into BaseLayout body -->
  <Header />
  <main class="flex-1">
    <slot />
  </main>
  <Footer />
  <MobileMenu />
</BaseLayout>
