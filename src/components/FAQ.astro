---
interface Props {
    items: Array<{ question: string; answer: string }>;
}

const { items } = Astro.props;
---

<section id="faq" class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
            class="text-3xl md:text-4xl lg:text-5xl font-bold text-center mb-12 text-dark font-heading"
        >
            Часто задаваемые вопросы
        </h2>

        <Accordion items={items} />
    </div>
</section>

---
// Reactive Accordion Component
interface AccordionProps {
    items: Array<{ question: string; answer: string }>;
}

function Accordion({ items }: AccordionProps) {
    let openIndex = -1 as number | null;

    const toggleItem = (index: number) => {
        openIndex = openIndex === index ? null : index;
    };

    return (
        <div class="max-w-3xl mx-auto">
            {items.map((item, i) => (
                <AccordionItem
                    item={item}
                    isOpen={openIndex === i}
                    toggle={() => toggleItem(i)}
                    index={i}
                />
            ))}
        </div>
    );
}

---
// Single Accordion Item with transitions
interface ItemProps {
    item: { question: string; answer: string };
    isOpen: boolean;
    toggle: () => void;
    index: number;
}

function AccordionItem({ item, isOpen, toggle, index }: ItemProps) {
    return (
        <div
            class={`border-b border-gray-200 transition-all duration-300 ${isOpen ? 'bg-white/50' : ''}`}
        >
            <button
                class="w-full flex justify-between items-center py-6 bg-none border-none cursor-pointer text-left font-heading text-lg md:text-xl font-semibold text-dark hover:text-primary transition-colors duration-200"
                onClick={toggle}
                aria-expanded={isOpen ? 'true' : 'false'}
            >
                <span>{item.question}</span>
                <span class="text-2xl text-primary transition-transform duration-300 ease-in-out ${isOpen ? 'rotate-45' : ''}">
                    +
                </span>
            </button>

            <div
                class={`overflow-hidden transition-[max-height] duration-300 ease-in-out ${isOpen ? 'max-h-[1000px]' : 'max-h-0'}`}
            >
                <p class="pb-6 pt-2 text-text-light leading-relaxed">{item.answer}</p>
            </div>
        </div>
    );
}
