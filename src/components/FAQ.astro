---
interface Props {
    items: Array<{ question: string; answer: string }>;
}

const { items } = Astro.props;
---

<section id="faq" class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2
            class="text-3xl md:text-4xl lg:text-5xl font-bold text-center mb-12 text-dark font-heading"
        >
            Часто задаваемые вопросы
        </h2>

        <div class="max-w-3xl mx-auto">
            {items.map((item) => (
                <details class="group border-b border-gray-200 transition-all duration-300 open:bg-white/50">
                    <summary class="flex justify-between items-center py-6 cursor-pointer list-none text-left font-heading text-lg md:text-xl font-semibold text-dark hover:text-primary transition-colors duration-200">
                        <span>{item.question}</span>
                        <span class="text-2xl text-primary shrink-0 ml-4 group-[&[open]]:rotate-45 transition-transform duration-300 ease-in-out">
                            +
                        </span>
                    </summary>
                    <div class="overflow-hidden transition-[max-height] duration-300 ease-in-out max-h-[1000px] group-[&[closed]]:max-h-0">
                        <p class="pb-6 pt-2 text-text-light leading-relaxed">{item.answer}</p>
                    </div>
                </details>
            ))}
        </div>
    </div>
</section>
