---
type Props = {
  partners: Array<{ name: string; src: string }>;
};

const { partners } = Astro.props;
---

<section class="py-16 md:py-20 bg-gradient-to-b from-slate-50 to-white" aria-label="Наши партнёры">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Title -->
    <div class="text-center mb-12 md:mb-16">
      <h2
        class="text-[clamp(1.5rem,3vw,2.5rem)] font-heading font-bold tracking-tight mb-3"
      >
        Нам доверяют
      </h2>
      <p class="text-sm md:text-base text-gray-500 max-w-xl mx-auto">
        Более 180 компаний выбрали TT Events для своих проектов с 2006 года
      </p>
    </div>

    <!-- Logo Grid — Clean, non-animated, accessible -->
    <div class="relative overflow-hidden rounded-2xl bg-white/60 shadow-[0_1px_3px_rgba(0,0,0,0.06)] backdrop-blur-sm">
      <div class="p-6 md:p-8">
        <!-- Mobile: 2 per row -->
        <div class="grid grid-cols-2 sm:hidden gap-4">
          {partners.map((partner) => (
            <div class="flex items-center justify-center py-3 rounded-xl bg-white shadow-sm">
              <img
                src={partner.src}
                alt={`Партнёр ${partner.name}`}
                loading="lazy"
                width="100"
                height="40"
                class="h-auto max-h-[28px] w-auto max-w-full object-contain opacity-65 hover:opacity-90 transition-opacity grayscale-[35%] hover:grayscale-0"
              />
            </div>
          ))}
        </div>

        <!-- Tablet: 3 per row -->
        <div class="hidden sm:grid md:hidden grid-cols-3 gap-4">
          {partners.map((partner) => (
            <div class="flex items-center justify-center py-3 rounded-xl bg-white shadow-sm">
              <img
                src={partner.src}
                alt={`Партнёр ${partner.name}`}
                loading="lazy"
                width="120"
                height="48"
                class="h-auto max-h-[32px] w-auto max-w-full object-contain opacity-65 hover:opacity-90 transition-opacity grayscale-[35%] hover:grayscale-0"
              />
            </div>
          ))}
        </div>

        <!-- Desktop: elegant carousel with smooth marquee -->
        <div class="hidden md:block">
          <div class="relative overflow-hidden py-4">
            <div class="flex gap-6 animate-marquee">
              {partners.map((partner) => (
                <div class="flex-shrink-0 flex items-center justify-center w-[180px] h-[64px] rounded-xl bg-white shadow-sm">
                  <img
                    src={partner.src}
                    alt={`Партнёр ${partner.name}`}
                    loading="lazy"
                    width="140"
                    height="50"
                    class="h-auto max-h-[36px] w-auto max-w-full object-contain opacity-70 hover:opacity-100 transition-all duration-200 grayscale-[40%] hover:grayscale-0 hover:scale-[1.03]"
                  />
                </div>
              ))}
              <!-- Duplicate for seamless loop -->
              {partners.map((partner) => (
                <div class="flex-shrink-0 flex items-center justify-center w-[180px] h-[64px] rounded-xl bg-white shadow-sm">
                  <img
                    src={partner.src}
                    alt={`Партнёр ${partner.name}`}
                    loading="lazy"
                    width="140"
                    height="50"
                    class="h-auto max-h-[36px] w-auto max-w-full object-contain opacity-70 hover:opacity-100 transition-all duration-200 grayscale-[40%] hover:grayscale-0 hover:scale-[1.03]"
                  />
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Trust indicators -->
    <div class="mt-8 flex items-center justify-center gap-6 md:gap-8 text-xs md:text-sm text-gray-400">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1a9 9 0 110 18 9 9 0 010-18zm3.5 7.5l-4 6-.5-.7L10.2 9l-5.7 3-.5-.7L10 2.8l2.5 1.7z"/></svg>
        Надёжность
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm1 12H9v-2h2v2zm0-4H9V6h2v4z"/></svg>
        Прозрачность
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="M9 4a5 5 0 00-5 5v1a5 5 0 0010 0V9a5 5 0 00-5-5zm0 8a3 3 0 100-6 3 3 0 000 6z"/></svg>
        Долгосрочное партнёрство
      </span>
    </div>
  </div>
</section>
