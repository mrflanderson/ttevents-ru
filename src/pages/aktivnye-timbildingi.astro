---
import Layout from '../components/Layout.astro';

const pageTitle = 'Активный тимбилдинг';
const pageDescription = 'Активный тимбилдинг в Москве: спортивные игры, командные соревнования.';
const keywords = 'активный тимбилдинг, спортивные игры';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Активный тимбилдинг</h1>
            <p>Спортивные игры и соревнования</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <p>Активный тимбилдинг включает:</p>
            <ul class="feature-list mt-2">
                <li>Командные виды спорта</li>
                <li>Соревнования на выносливость</li>
                <li>Эстафеты и квесты</li>
                <li>Веревочные курсы</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Заказать</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>