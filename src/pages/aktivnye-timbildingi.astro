---
import Layout from "../components/Layout.astro";
import PageHero from "../components/sections/PageHero.astro";

const pageTitle =
    "Активный тимбилдинг для сотрудников в Москве — организация под ключ | TT Events";
const pageDescription =
    "Активный тимбилдинг для сотрудников в Москве и Подмосковье. Квесты, спартакиады, командные игры и корпоративные экспедиции. Опыт 15+ лет. Рассчитаем программу за 24 часа.";
const keywords =
    "активный тимбилдинг для сотрудников, тимбилдинг на природе Москва, выездной тимбилдинг для компании, командные игры для сотрудников, корпоративный тимбилдинг";

const heroImage = "/images/it_teambuilding.jpg";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <!-- Hero Section -->
    <PageHero
        title="Активный тимбилдинг для сотрудников в Москве"
        subtitle="Спортивные турниры, корпоративные спартакиады, командные квесты и полосы препятствий. Опыт 15+ лет. Рассчитаем программу за 24 часа."
        cta={{ label: "Получить расчёт бюджета", href: "/kontakty" }}
        backgroundImage={heroImage}
    />

    <section class="py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="text-sm text-text-light">
                Все активные тимбилдинги →
                <a href="/services/team-building/aktivnye" class="underline hover:text-primary">
                    /services/team-building/aktivnye
                </a>
            </p>
        </div>
    </section>
</Layout>
