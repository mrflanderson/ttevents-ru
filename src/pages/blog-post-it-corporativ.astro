---
import Layout from "../components/Layout.astro";

const pageTitle =
    "Корпоратив для IT-компании — идеи, сценарий и кейс выездного корпоратива";
const pageDescription =
    "Как организовать корпоратив для распределенной IT-команды: идеи, сценарий, реальные кейсы и результаты. Выездной корпоратив под ключ.";
const keywords =
    "корпоратив для it-компании, тимбилдинг для разработчиков, выездной корпоратив it, организация корпоратива для it";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="py-16 md:py-24">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4">
                <a href="/" class="hover:text-primary">Главная</a> / <a
                    href="/blog"
                    class="hover:text-primary">Блог</a
                > / <span class="font-medium text-text"
                    >Корпоратив для IT-компании</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Корпоратив для IT-компании — идеи, сценарий и кейс
            </h1>
            <div class="prose prose-lg max-w-none">
                <p class="text-lg text-text-light mb-6">
                    IT-команды — особенная аудитория. Разработчикам и
                    продуктовым командам не нужны скучные банкеты. Нужен формат,
                    где можно реально отдохнуть, познакомиться и получить заряд
                    энергии.
                </p>
                <h2 class="text-2xl font-heading font-bold text-dark mb-4 mt-8">
                    Кейс: IT-компания в Подмосковье
                </h2>
                <p class="text-text-light mb-6">
                    Организация выездного корпоратива для 80 человек. Формат —
                    активный день на природе с элементами тимбилдинга и вечерним
                    барбекю.
                </p>
                <h2 class="text-2xl font-heading font-bold text-dark mb-4 mt-8">
                    Формат: Active Team Day
                </h2>
                <p class="text-text-light mb-6">
                    Утром — командные квесты и спортивные активности. Днем —
                    свободное время, настольные игры, зона отдыха. Вечером —
                    барбекю и живая музыка.
                </p>
            </div>
        </div>
    </div>
</Layout>
