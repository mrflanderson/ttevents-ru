---
import Layout from '../components/Layout.astro';

const pageTitle = 'Тимбилдинг в Москве';
const pageDescription = 'Тимбилдинг в Москве: командные игры, квесты, спортивные программы. Активный и интеллектуальный тимбилдинг для команд.';
const keywords = 'тимбилдинг, командные игры, квесты, тимбилдинг москва';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Тимбилдинг в Москве</h1>
            <p>Мероприятия, которые объединяют команду</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <div class="grid grid-3">
                <a href="/aktivnye-timbildingi" class="service-card"><h3>Активный тимбилдинг</h3><p>Спортивные игры и соревнования</p></a>
                <a href="/kreativnye-timbildingi" class="service-card"><h3>Креативный тимбилдинг</h3><p>Творческие задания</p></a>
                <a href="/kvesty-i-igry" class="service-card"><h3>Квесты и игры</h3><p>Командные квесты</p></a>
                <a href="/timbilding-na-prirode" class="service-card"><h3>Тимбилдинг на природе</h3><p>Выездные программы</p></a>
            </div>
        </div>
    </div>
</Layout>

<style>
.service-card { background: var(--color-white); padding: var(--space-lg); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); display: block; }
.service-card h3 { font-size: var(--font-size-base); margin-bottom: var(--space-sm); }
.service-card p { font-size: var(--font-size-sm); color: var(--color-secondary); }
</style>