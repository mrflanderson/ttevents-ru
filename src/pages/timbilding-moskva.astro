---
import Layout from "../components/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Hero from "../components/Hero.astro";
import FAQ from "../components/FAQ.astro";

const pageTitle =
    "Тимбилдинги в Москве — активные и креативные мероприятия для команды | TT Events";
const pageDescription =
    "Тимбилдинги в Москве: активные, креативные и тимбилдинги на природе. Формат от 10 до 500+ человек. Индивидуальная программа для вашей команды.";
const keywords =
    "тимбилдинг москва, активный тимбилдинг, тимбилдинг на природе, мероприятия для команды, тимбилдинги";

const formats = [
    { title: "Активный тимбилдинг", href: "/aktivnye-timbildingi", count: 45 },
    {
        title: "Креативный тимбилдинг",
        href: "/kreativnye-timbildingi",
        count: 35,
    },
    {
        title: "Тимбилдинг на природе",
        href: "/timbilding-na-prirode",
        count: 50,
    },
    { title: "Квест-тимбилдинг", href: "/kvesty-i-igry", count: 30 },
];

const faqItems = [
    {
        question: "Какой минимальный состав команды для тимбилдинга?",
        answer: "Минимальный состав — от 10 человек. Оптимально — 30-80 участников. Работаем с командами до 500+ человек.",
    },
    {
        question: "Можно ли провести тимбилдинг в помещении?",
        answer: "Да, мы предлагаем indoor-форматы: квесты в лофтах, активные игры, мастер-классы. Также работаем в загородных отелях.",
    },
    {
        question: "Как долго длится тимбилдинг?",
        answer: "Стандартный формат — 3-5 часов. Полнодневный — 6-8 часов. У нас есть и multi-day форматы для глубокой проработки командных задач.",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    canonicalURL="/timbilding-moskva"
>
    <div class="page-service">
        <!-- Hero Section -->
        <Hero
            title="Тимбилдинги в Москве"
            subtitle="Активные и креативные форматы для сплочения команды. От 10 до 500+ участников."
            ctaText="Обсудить формат"
            ctaHref="/kontakty"
            backgroundImage="/images/timbilding-bg.jpg"
        />

        <!-- About Section -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div
                    class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
                >
                    <div>
                        <h2
                            class="text-3xl md:text-4xl font-bold text-dark font-heading mb-6"
                        >
                            Тимбилдинг — это не игра, а стратегический
                            инструмент
                        </h2>
                        <p class="text-lg text-text-light mb-4">
                            Мы проектируем тимбилдинги под конкретные
                            бизнес-задачи: улучшение коммуникации, разрешение
                            конфликтов, мотивация команды.
                        </p>
                        <p class="text-lg text-text-light mb-6">
                            Каждый формат разрабатывается индивидуально на
                            основе брифинга с HR-директором или руководителем.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <a href="/kontakty" class="btn-primary"
                                >Получить программу</a
                            >
                            <a href="/case" class="btn-outline"
                                >Смотреть кейсы</a
                            >
                        </div>
                    </div>
                    <div class="rounded-xl overflow-hidden shadow-card">
                        <img
                            src="/images/timbilding-main.jpg"
                            alt="Тимбилдинг для команды"
                            width="600"
                            height="400"
                            class="w-full h-auto"
                            loading="lazy"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- Formats Grid -->
        <section class="py-16 md:py-24 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="section-title mb-16">Форматы тимбилдингов</h2>
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8"
                >
                    {formats.map((format) => <ServiceCard {...format} />)}
                </div>
            </div>
        </section>

        <!-- Advantages -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2
                    class="text-3xl md:text-4xl font-bold text-center mb-12 text-dark font-heading"
                >
                    Преимущества TT Events
                </h2>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
                >
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            150+
                        </div>
                        <h3 class="text-xl font-semibold mb-2">Тимбилдингов</h3>
                        <p class="text-text-light">Реализованных в Москве</p>
                    </div>
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            30+
                        </div>
                        <h3 class="text-xl font-semibold mb-2">
                            Уникальных форматов
                        </h3>
                        <p class="text-text-light">Разработано под задачи</p>
                    </div>
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            10+
                        </div>
                        <h3 class="text-xl font-semibold mb-2">
                            Загородных площадок
                        </h3>
                        <p class="text-text-light">Партнёры для выездных</p>
                    </div>
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            100%
                        </div>
                        <h3 class="text-xl font-semibold mb-2">
                            Индивидуальный подход
                        </h3>
                        <p class="text-text-light">Без шаблонов</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <FAQ items={faqItems} />
    </div>
</Layout>
