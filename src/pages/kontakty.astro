---
import Layout from "../components/Layout.astro";

const pageMeta = {
    title: "Контакты — TT Events",
    description:
        "Свяжитесь с TT Events: +7 (916) 906-44-90, mail@ttevents.ru. Организация корпоративных мероприятий в Москве и по всей России с 2006 года.",
    ogTitle: "Контакты — TT Events",
    ogDescription:
        "Event-агентство полного цикла в Москве. Свяжитесь с нами для расчёта бюджета мероприятия.",
};

const contactInfo = {
    phone1: "+7 (916) 906-44-90",
    phone2: "+7 (916) 408-60-90",
    email: "mail@ttevents.ru",
    address: "Москва",
    hours: "Пн-Пт: 10:00–19:00",
};

const quickLinks = [
    { title: "Корпоративные мероприятия", href: "/korporativy-moskva" },
    { title: "Тимбилдинги", href: "/timbilding-moskva" },
    { title: "Новогодние корпоративы", href: "/novogodniy-korporativ" },
    { title: "Деловые мероприятия", href: "/delovye-meropriyatiya" },
    { title: "Конференции", href: "/konferencii-i-forumy" },
    { title: "Фестивали", href: "/festivaly-i-gorodskie-meropriyatiya" },
];
---

<Layout {...pageMeta}>
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4" aria-label="Навигация">
                <a href="/" class="hover:text-primary">Главная</a> / <span
                    class="font-medium text-text"
                    aria-current="page">Контакты</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Свяжитесь с нами
            </h1>
            <p class="text-lg text-text-light max-w-3xl mb-12">
                Рассчитаем стоимость мероприятия за 1 день и предложим 3
                концепции под ваш бюджет.
            </p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
                <div class="bg-white rounded-xl p-8 shadow-card">
                    <h2 class="text-xl font-heading font-semibold mb-6 text-dark">
                        Контакты
                    </h2>
                    <div class="space-y-4">
                        <div class="flex items-start gap-3">
                            <svg class="w-5 h-5 text-primary mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                            </svg>
                            <div>
                                <p class="text-dark font-medium">Телефон:</p>
                                <a href="tel:+79169064490" class="text-text-light hover:text-primary">{contactInfo.phone1}</a><br />
                                <a href="tel:+79164086090" class="text-text-light hover:text-primary">{contactInfo.phone2}</a>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <svg class="w-5 h-5 text-primary mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                            <div>
                                <p class="text-dark font-medium">Email:</p>
                                <a href="mailto:mail@ttevents.ru" class="text-text-light hover:text-primary">{contactInfo.email}</a>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <svg class="w-5 h-5 text-primary mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <div>
                                <p class="text-dark font-medium">Режим работы:</p>
                                <p class="text-text-light">{contactInfo.hours}</p>
                            </div>
                        </div>
                        <div class="flex items-start gap-3">
                            <svg class="w-5 h-5 text-primary mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <div>
                                <p class="text-dark font-medium">Адрес:</p>
                                <p class="text-text-light">{contactInfo.address}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-xl p-8 shadow-card">
                    <h2 class="text-xl font-heading font-semibold mb-6 text-dark">
                        Быстрые ссылки
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {quickLinks.map((link) => (
                            <a
                                href={link.href}
                                class="block p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors"
                            >
                                {link.title}
                            </a>
                        ))}
                    </div>
                </div>
            </div>

            <!-- CTA Section -->
            <div class="bg-primary text-white rounded-xl p-12 text-center">
                <h2 class="text-2xl md:text-3xl font-heading font-bold mb-4">
                    Готовы обсудить ваш проект?
                </h2>
                <p class="text-lg mb-8 max-w-2xl mx-auto">
                    Позвоните нам или оставьте заявку — мы ответим в течение 1 часа в рабочее время.
                </p>
                <div class="flex flex-wrap justify-center gap-4">
                    <a href="tel:+79169064490" class="inline-flex items-center justify-center px-8 py-3 rounded-lg font-semibold bg-white text-primary hover:bg-gray-100 transition-all duration-300">
                        Позвонить сейчас
                    </a>
                    <a href="mailto:mail@ttevents.ru" class="inline-flex items-center justify-center px-8 py-3 rounded-lg font-semibold bg-transparent border-2 border-white text-white hover:bg-white hover:text-primary transition-all duration-300">
                        Написать нам
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>
