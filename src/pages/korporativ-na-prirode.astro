---
import Layout from '../components/Layout.astro';

const pageTitle = 'Корпоратив на природе';
const pageDescription = 'Выездные корпоративные мероприятия за городом. Базы отдыха, загородные клубы, мероприятия на природе.';
const keywords = 'корпоратив на природе, выездное мероприятие, база отдыха, загородный клуб';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Корпоратив на природе</h1>
            <p>Выездные мероприятия за городом</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <p>Выездной корпоратив — отличный способ сплотить команду:</p>
            <ul class="feature-list mt-2">
                <li>Базы отдыха</li>
                <li>Загородные клубы</li>
                <li>Программы на природе</li>
                <li>Коттеджи</li>
                <li>Комплексный отдых</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Организовать выезд</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.feature-list li { margin-bottom: var(--space-sm); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>