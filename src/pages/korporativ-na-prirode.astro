---
import Layout from "../components/Layout.astro";
import FAQSection from "../components/sections/FAQSection.astro";

const pageMeta = {
    title: "Корпоратив на природе — TT Events",
    description:
        "Организация корпоративов на природе в Подмосковье. Пикники, кемпинги, спортивные активности и отдых на свежем воздухе для команд от 10 до 1000+ человек.",
    ogTitle: "Корпоратив на природе — TT Events",
    ogDescription:
        "Профессиональная организация корпоративов на природе для бизнеса.",
};

const services = [
    { title: "Корпоративный пикник", href: "/korporativ-na-prirode" },
    { title: "Кемпинг-мероприятие", href: "/korporativ-na-prirode" },
    { title: "Спортивные активности", href: "/sportivnye-meropriyatiya" },
    { title: "Тимбилдинг на природе", href: "/timilding-na-prirode" },
];

const faqItems = [
    {
        question: "Что включает организация корпоратива на природе?",
        answer: "Подбор площадки, организация транспорта, кейтеринг, техническое обеспечение и полный цикл реализации.",
    },
    {
        question: "Какой минимальный состав команды?",
        answer: "От 10 человек до 1000+. Подбираем формат под ваш состав.",
    },
    {
        question: "Сколько длится корпоратив на природе?",
        answer: "От 1 дня до 3 дней. Стандарт — 1 день (8-10 часов).",
    },
];
---

<!--
  TT Events — Tailwind CSS Migration
  Generated on: 2026-05-17
-->
<Layout {...pageMeta}>
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4" aria-label="Навигация">
                <a href="/" class="hover:text-primary">Главная</a> / <span
                    class="font-medium text-text"
                    aria-current="page">Корпоратив на природе</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Корпоратив на природе
            </h1>
            <p class="text-lg text-text-light max-w-3xl mb-12">
                Организация корпоративов на природе в Подмосковье. Пикники,
                кемпинги, спортивные активности и отдых на свежем воздухе для
                команд от 10 до 1000+ человек.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    services.map((service) => (
                        <a
                            href={service.href}
                            class="block p-6 bg-white rounded-xl shadow-card hover:shadow-card-hover transition-all duration-300"
                            aria-label={service.title}
                        >
                            <h3 class="text-xl font-heading font-semibold text-dark hover:text-primary transition-colors">
                                {service.title}
                            </h3>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <FAQSection items={faqItems} />

    <!-- Hub link -->
    <section class="py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="text-sm text-text-light">
                Все корпоративные мероприятия → <a href="/services/corporate-events" class="underline hover:text-primary">/services/corporate-events</a>
            </p>
        </div>
    </section>
</Layout>
