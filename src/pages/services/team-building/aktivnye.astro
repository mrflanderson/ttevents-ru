---
import Layout from "@/components/Layout.astro";

const pageTitle = "Активные тимбилдинги — TT Events";
const pageDescription = "TT Events организует активные тимбилдинги: спорт, ориентирование, гонки, экшн-форматы.";
const keywords = "активный тимбилдинг, тимбилдинг спорт, тимбилдинг активный";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords} canonicalURL="/services/team-building/aktivnye">
    <div class="page-service">
        <section class="py-16 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <nav class="text-sm text-text-light mb-4">
                    <a href="/" class="hover:text-primary">Главная</a> / <a href="/services" class="hover:text-primary">Услуги</a> / <a href="/services/team-building" class="hover:text-primary">Тимбилдинг</a> / <span class="font-medium text-text">Активные тимбилдинги</span>
                </nav>
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-6">Активные тимбилдинги</h1>
                <p class="text-lg text-text-light mb-8">
                    Динамичные форматы, которые объединяют команду через действие: спорт, ориентирование, гонки, экшн.
                </p>
                <ul class="list-disc list-inside space-y-2 text-text-light mb-8">
                    <li>Загородние и городские маршруты.</li>
                    <li>Эстафеты, миссии, симуляции, гонки команд.</li>
                    <li>Безопасность, инструкторы, экипировка.</li>
                </ul>
                <div class="flex flex-wrap gap-4 mb-8">
                    <a href="/kontakty" class="btn-primary">Обсудить тимбилдинг</a>
                    <a href="/services/team-building" class="btn-outline">← Тимбилдинг</a>
                </div>
                <p class="text-sm text-text-light">Примеры → <a href="/case" class="underline hover:text-primary">/case</a></p>
            </div>
        </section>
    </div>
</Layout>
