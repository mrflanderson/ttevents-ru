---
import Layout from "@/components/Layout.astro";

const pageTitle = "Квесты и игры для тимбилдинга — TT Events";
const pageDescription = "TT Events организует квесты и игры для тимбилдинга: логика, детектив, миссии, живые сценарии.";
const keywords = "квест для тимбилдинга, игры тимбилдинг, интеллектуальные игры";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords} canonicalURL="/services/team-building/kvesty-i-igry">
    <div class="page-service">
        <section class="py-16 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <nav class="text-sm text-text-light mb-4">
                    <a href="/" class="hover:text-primary">Главная</a> / <a href="/services" class="hover:text-primary">Услуги</a> / <a href="/services/team-building" class="hover:text-primary">Тимбилдинг</a> / <span class="font-medium text-text">Квесты и игры</span>
                </nav>
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-6">Квесты и игры</h1>
                <p class="text-lg text-text-light mb-8">
                    Игры, квесты и сценарии, где команда взаимодействует, решает задачи, открывает новые роли друг друга.
                </p>
                <ul class="list-disc list-inside space-y-2 text-text-light mb-8">
                    <li>Городские и закрытые квест-форматы.</li>
                    <li>Детективы, бизнес-симуляции, миссии.</li>
                    <li>Пост-разбор и вывод в управленческие практики.</li>
                </ul>
                <div class="flex flex-wrap gap-4 mb-8">
                    <a href="/kontakty" class="btn-primary">Обсудить квест</a>
                    <a href="/services/team-building" class="btn-outline">← Тимбилдинг</a>
                </div>
                <p class="text-sm text-text-light">Примеры → <a href="/case" class="underline hover:text-primary">/case</a></p>
            </div>
        </section>
    </div>
</Layout>
