---
import Layout from "@/components/Layout.astro";

const pageTitle = "City Events — TT Events";
const pageDescription = "TT Events организует city events: городские мероприятия, фестивали, арт-зоны, публичные активности.";
const keywords = "city event, городской фестиваль, городское мероприятие";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords} canonicalURL="/services/festivals/city-events">
    <div class="page-service">
        <section class="py-16 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <nav class="text-sm text-text-light mb-4">
                    <a href="/" class="hover:text-primary">Главная</a> / <a href="/services" class="hover:text-primary">Услуги</a> / <a href="/services/festivals" class="hover:text-primary">Фестивали</a> / <span class="font-medium text-text">City Events</span>
                </nav>
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-6">City Events</h1>
                <p class="text-lg text-text-light mb-8">
                    Городские мероприятия, которые формируют имидж территорий, брендов и продуктов.
                    Фестивали, фуд-парки, арт-зоны, публичные активности.
                </p>
                <ul class="list-disc list-inside space-y-2 text-text-light mb-8">
                    <li>Пространственное планирование и зонирование.</li>
                    <li>Программирование, сцена, медиа, интерактивы.</li>
                    <li>Безопасность, логистика, связь с властями и партнёрами.</li>
                </ul>
                <div class="flex flex-wrap gap-4 mb-8">
                    <a href="/kontakty" class="btn-primary">Обсудить проект</a>
                    <a href="/services/festivals" class="btn-outline">← Фестивали</a>
                </div>
                <p class="text-sm text-text-light">Примеры → <a href="/case" class="underline hover:text-primary">/case</a></p>
            </div>
        </section>
    </div>
</Layout>
