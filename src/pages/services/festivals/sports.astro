---
import Layout from "@/components/Layout.astro";

const pageTitle = "Спортивные мероприятия — TT Events";
const pageDescription = "TT Events организует спортивные мероприятия: старты, забеги, корпоративные лиги, family-зоны.";
const keywords = "спортивные мероприятия, спорт фестиваль, организация старта";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords} canonicalURL="/services/festivals/sports">
    <div class="page-service">
        <section class="py-16 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <nav class="text-sm text-text-light mb-4">
                    <a href="/" class="hover:text-primary">Главная</a> / <a href="/services" class="hover:text-primary">Услуги</a> / <a href="/services/festivals" class="hover:text-primary">Фестивали</a> / <span class="font-medium text-text">Спортивные мероприятия</span>
                </nav>
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-6">Спортивные мероприятия</h1>
                <p class="text-lg text-text-light mb-8">
                    Спортивные события, корпоративные лиги, фестивальные и family-форматы с полным сопровождением.
                </p>
                <ul class="list-disc list-inside space-y-2 text-text-light mb-8">
                    <li>Маршруты, стартовые зоны, финишные городки.</li>
                    <li>Медиасопровождение, прямые трансляции.</li>
                    <li>Безопасность, медпункты, волонтёры.</li>
                </ul>
                <div class="flex flex-wrap gap-4 mb-8">
                    <a href="/kontakty" class="btn-primary">Обсудить проект</a>
                    <a href="/services/festivals" class="btn-outline">← Фестивали</a>
                </div>
                <p class="text-sm text-text-light">Примеры → <a href="/case" class="underline hover:text-primary">/case</a></p>
            </div>
        </section>
    </div>
</Layout>
