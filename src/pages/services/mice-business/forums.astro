---
import Layout from "@/components/Layout.astro";

const pageTitle = "Форумы — TT Events";
const pageDescription = "TT Events организует крупные форумы: многосоставные программы, десятки сцен, сложная координация.";
const keywords = "форум, организация форума, деловой форум";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords} canonicalURL="/services/mice-business/forums">
    <div class="page-service">
        <section class="py-16 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <nav class="text-sm text-text-light mb-4">
                    <a href="/" class="hover:text-primary">Главная</a> / <a href="/services" class="hover:text-primary">Услуги</a> / <a href="/services/mice-business" class="hover:text-primary">Деловые мероприятия</a> / <span class="font-medium text-text">Форумы</span>
                </nav>
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-6">Форумы</h1>
                <p class="text-lg text-text-light mb-8">
                    Многозадачные и высокопубличные события с сотнями участников, спикеров и партнёров.
                    Мы обеспечиваем координацию, техобеспечение и единый визуал.
                </p>
                <ul class="list-disc list-inside space-y-2 text-text-light mb-8">
                    <li>Мульти-площадочные форматы и параллельные секции.</li>
                    <li>Техническое сопровождение и режиссура событий.</li>
                    <li>Визуальная коммуникация, навигация, регистрация.</li>
                </ul>
                <div class="flex flex-wrap gap-4 mb-8">
                    <a href="/kontakty" class="btn-primary">Обсудить форум</a>
                    <a href="/services/mice-business" class="btn-outline">← Деловые мероприятия</a>
                </div>
                <p class="text-sm text-text-light">Примеры → <a href="/case" class="underline hover:text-primary">/case</a></p>
            </div>
        </section>
    </div>
</Layout>
