---
import Layout from "@/components/Layout.astro";

const pageTitle =
    "Иммерсивные мероприятия — TT Events";
const pageDescription =
    "TT Events организует иммерсивные корпоративные мероприятия: интерактив, квест, живое действие и полное погружение.";
const keywords = "иммерсивный корпоратив, иммерсивное мероприятие, интерактивный корпоратив";
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    canonicalURL="/services/corporate-events/immersivnye"
>
    <div class="page-service">
        <section class="py-16 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <nav class="text-sm text-text-light mb-4">
                    <a href="/" class="hover:text-primary">Главная</a> / <a href="/services" class="hover:text-primary">Услуги</a> / <a href="/services/corporate-events" class="hover:text-primary">Корпоративные мероприятия</a> / <span class="font-medium text-text">Иммерсивные мероприятия</span>
                </nav>
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-6">
                    Иммерсивные мероприятия
                </h1>
                <p class="text-lg text-text-light mb-8">
                    Гости не просто наблюдают — они часть истории.
                    Сценарии, где каждый зритель становится участником, а пространство превращается в мир.
                </p>
                <ul class="list-disc list-inside space-y-2 text-text-light mb-8">
                    <li>Исторические, фантастические, детективные миры.</li>
                    <li>Ролевые сценарии и интерактив.</li>
                    <li>Спецэффекты, реквизит, костюмы, живое действие.</li>
                </ul>
                <div class="flex flex-wrap gap-4 mb-8">
                    <a href="/kontakty" class="btn-primary">Обсудить иммерсивное мероприятие</a>
                    <a href="/services/corporate-events" class="btn-outline">← Все корпоративные мероприятия</a>
                </div>
                <p class="text-sm text-text-light">Примеры → <a href="/case" class="underline hover:text-primary">/case</a></p>
            </div>
        </section>
    </div>
</Layout>
