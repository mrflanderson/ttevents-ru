---
import Layout from '../components/Layout.astro';

const pageTitle = 'Идеи IT-корпоратива';
const pageDescription = 'Идеи для IT-корпоратива. Современные форматы для IT-команд.';
const keywords = 'IT-корпоратив, тимбилдинг для айтишников';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Идеи IT-корпоратива</h1>
            <p>Современные форматы для IT-команд</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <ul class="feature-list mt-2">
                <li>Хакатоны</li>
                <li>Игровые форматы</li>
                <li>Квестинг</li>
                <li>Креативные мастер-классы</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Заказать</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>