---
import Layout from "../components/Layout.astro";

const pageTitle =
    "Идеи корпоратива для IT-компании: 20 форматов, которые реально работают";
const pageDescription =
    "20 идей корпоратива для IT-компании без кринжа и обязаловки. Выездные форматы, настольные игры, тимбилдинг на природе и не только.";
const keywords =
    "идеи корпоратива для it-компании, тимбилдинг для разработчиков, выездной корпоратив it";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="py-16 md:py-24">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4">
                <a href="/" class="hover:text-primary">Главная</a> / <a
                    href="/blog"
                    class="hover:text-primary">Блог</a
                > / <span class="font-medium text-text"
                    >Идеи корпоратива для IT</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Идеи корпоратива для IT-компании: 20 форматов
            </h1>
            <div class="prose prose-lg max-w-none">
                <p class="text-lg text-text-light mb-6">
                    IT-специалисты — особенная аудитория. Они ценят честность,
                    свободу и активность. Вот форматы, которые работают
                    безотказно.
                </p>
                <h2 class="text-2xl font-heading font-bold text-dark mb-4 mt-8">
                    1. Board Game Party
                </h2>
                <p class="text-text-light mb-6">
                    Настольные игры в лофтовом пространстве. Разработчики
                    обожают настолки. Добавляем бар и легкую атмосферу.
                </p>
                <h2 class="text-2xl font-heading font-bold text-dark mb-4 mt-8">
                    2. Полевая кухня
                </h2>
                <p class="text-text-light mb-6">
                    Команды готовят вместе под руководством шеф-повара. Весело,
                    ароматно и объединяет.
                </p>
            </div>
        </div>
    </div>
</Layout>
