---
import Layout from '../components/Layout.astro';

const pageTitle = 'Блог — Статьи и идеи';
const pageDescription = 'Блог TT Events: идеи для корпоративов, тренды мероприятий, полезные советы.';
const keywords = 'блог, статьи, идеи для корпоративов';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Блог</h1>
            <p>Полезные статьи и идеи</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <div class="grid grid-2">
                <article class="blog-card"><h3>Как организовать корпоратив</h3><p>Пошаговая инструкция.</p></article>
                <article class="blog-card"><h3>Тренды 2026</h3><p>Актуальные форматы.</p></article>
                <article class="blog-card"><h3>Как выбрать агентство</h3><p>Критерии выбора.</p></article>
                <article class="blog-card"><h3>Идеи для тимбилдинга</h3><p>Популярные программы.</p></article>
            </div>
        </div>
    </div>
</Layout>

<style>
.blog-card { background: var(--color-white); padding: var(--space-lg); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
.blog-card h3 { font-size: var(--font-size-lg); margin-bottom: var(--space-sm); }
.blog-card p { color: var(--color-secondary); }
</style>