---
import Layout from '../components/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/blog.css';
import '../scripts/articles.js';

const pageMeta = {
  title: 'TT Events — Блог: идеи и тренды для корпоративов 2026',
  description: 'Блог TT Events: актуальные идеи, тренды и советы по организации корпоративных мероприятий в Москве. Тренды 2026 года.',
  keywords: 'блог, корпоративы, тренды 2026, идеи мероприятий',
  ogTitle: 'TT Events — Блог',
  ogDescription: 'Блог TT Events: актуальные идеи, тренды и советы по организации корпоративных мероприятий.',
  ogImage: '/g/s3/mosaic/images/og-blog.jpg',
};

const articles = [
  {
    title: 'Как выбрать event-агентство в Москве: взгляд изнутри рынка',
    date: '10.04.2026',
    excerpt: 'Рынок event-услуг в Москве перегрет. Агентств много, презентации у всех аккуратные, кейсы визуально похожие. На этапе выбора легко создать впечатление, что разницы почти нет.',
    href: '/blog/post/kak-vybrat-event-agentstvo-v-moskve',
    image: '/thumb/2/joDLIwU7aXPfUrjKyG5WRA/300r200/d/logo_plus.png',
  },
  {
    title: 'Идеи корпоратива для IT-компании: 20 форматов, которые реально работают',
    date: '20.03.2026',
    excerpt: 'Классический корпоратив с тамадой и конкурсами «под стол» здесь не просто не работает — он может навредить. Но это не значит, что команде не нужен отдых.',
    href: '/blog/post/it-corporativ-idei',
    image: '/thumb/2/yNuQVhQGCjoKdCUdnKqJ_g/300r200/d/it_corp2.jpg',
  },
  {
    title: 'Корпоратив для IT-компании — идеи, сценарий и кейс выездного корпоратива',
    date: '19.03.2026',
    excerpt: 'Ситуация, знакомая многим HR-директорам и лидам: сотрудники в разных городах, общение только в рабочих чатах, на общих созвонах — неловкое молчание.',
    href: '/blog/post/it-corporativ',
    image: '/thumb/2/DxL27GMDs-RFKf5CH9zRog/300r200/d/it_teambuilding.jpg',
  },
  {
    title: 'Как провести Launch Event: 10 форматов презентации нового продукта',
    date: '08.03.2026',
    excerpt: 'Launch Event — это ключевое событие для вывода нового продукта на рынок. Грамотно организованная презентация помогает сформировать позиционирование бренда.',
    href: '/blog/post/kak-provesti-launch-event-10-formatov-prezentacii-novogo-produkta',
    image: '/thumb/2/M6Vqm8zGbVjj3JBa731Hog/300r200/d/screenshot_2026-02-27_030714.png',
  },
  {
    title: 'Корпоратив на 9 Мая для компании: 12 идей мероприятий ко Дню Победы (сценарии и форматы 2026)',
    date: '06.03.2026',
    excerpt: '9 Мая — один из самых значимых праздников в России. Для компаний это не просто дата в календаре, а возможность провести сильное объединяющее событие для сотрудников.',
    href: '/blog/post/korporativ-na-9-maya-dlya-kompanii-12-idej-meropriyatij-ko-dnyu-pobedy-scenarii-i-formaty-2026',
    image: '/thumb/2/U_7cvJKPMm-qgcT5eEm-OQ/300r200/d/080524-013.jpg',
  },
  {
    title: 'Почему русские народные мотивы так популярны на корпоративе в 2026 году',
    date: '02.03.2026',
    excerpt: 'В 2026 году корпоративы уходят от стандартных банкетов к глубокому эмоциональному опыту. Один из лидеров тренда — интеграция русских народных мотивов через иммерсивные форматы.',
    href: '/blog/post/pochemu-russkie-narodnye-motivy-populyarny',
    image: '/thumb/2/qsdWbhMHrqYnLVJqvT8UkQ/300r200/d/e973db0ce3eb560e4.jpg',
  },
  {
    title: 'Корпоратив на 9 Мая 2026 в Москве: 18 душевных идей',
    date: '02.03.2026',
    excerpt: 'День Победы выпадает на пятницу — идеальный момент собрать команду и провести по-настоящему трогательный праздник! Живые истории ветеранов, ретро-бал 1945 года.',
    href: '/blog/korporativ-na-9-maya-2026-v-moskve',
    image: '/thumb/2/kNyHxpVQtmXvdnU__GPboQ/300r200/d/55406392_3.jpg',
  },
  {
    title: 'Тренды корпоративов 2026: что точно зайдёт вашей команде',
    date: '01.03.2026',
    excerpt: 'Если ваши сотрудники после корпоратива обсуждают только качество еды и очередь в гардероб — бюджет потрачен зря. В 2026 году корпоративное мероприятие перестало быть просто «вечеринкой за счет компании».',
    href: '/blog/3-trenda',
    image: '/thumb/2/XM-bDudFBc-GjWEKlmvZ3w/300r200/d/05_09_2024_reba_den_goroda_magoimaev_1min_v2mp4_20260211_003808433.jpg',
  },
  {
    title: 'Организация корпоративов в Москве 2026 — цены, форматы и реальные кейсы',
    date: '28.02.2026',
    excerpt: 'Привет! Мы — агентство TT Event (Театр Традиций). С 2006 года помогаем компаниям организовывать корпоративы в Москве и Подмосковье.',
    href: '/blog/organizatsiya-korporativov-moskva-2026',
    image: '/thumb/2/ZKMlOwrHg5gzbEcRun0t1Q/300r200/d/pexels-pavel-danilyuk-6405655_2.jpg',
  },
];
---

<Layout {...pageMeta}>
  <Header />
  
  <main class="blog-page">
    <section class="blog-hero">
      <div class="container">
        <div class="blog-breadcrumbs">
          <a href="/">Главная</a>
          <span>/</span>
          <span class="current">Блог</span>
        </div>
        <h1>Идеи и тренды для корпоративов и мероприятий 2026</h1>
      </div>
    </section>
    
    <section class="blog-content">
      <div class="container">
        <div class="articles-grid">
          {articles.map(article => (
            <article class="article-card">
              <a href={article.href} class="article-card-link">
                <div class="article-card-image">
                  <img 
                    src={article.image} 
                    alt={article.title} 
                    class="lazy-load"
                    data-src={article.image}
                    width="300" 
                    height="200"
                    loading="lazy"
                  >
                </div>
                <div class="article-card-content">
                  <time class="article-date">{article.date}</time>
                  <h3 class="article-title">{article.title}</h3>
                  <p class="article-excerpt">{article.excerpt}</p>
                  <span class="read-more">Читать далее →</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
    
    <section class="blog-contacts">
      <div class="container">
        <h2>Контакты</h2>
        <div class="contacts-grid">
          <div class="contact-item">
            <a href="tel:+79169064490">+7 (916) 906-44-90</a>
            <a href="https://t.me/+79169064490" target="_blank">Telegram</a>
          </div>
          <div class="contact-item">
            <a href="tel:+79164086090">+7 (916) 408-60-90</a>
            <a href="https://t.me/+79164086090" target="_blank">Telegram</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  .blog-page {
    position: relative;
  }
  
  .blog-hero {
    padding: 40px 0;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  }
  
  .blog-breadcrumbs {
    margin-bottom: 20px;
    font-size: 14px;
    color: #666;
  }
  
  .blog-breadcrumbs a {
    color: var(--color-primary);
    text-decoration: none;
  }
  
  .blog-breadcrumbs .current {
    color: var(--color-text);
    font-weight: 600;
  }
  
  .blog-hero h1 {
    font-size: 2.5rem;
    margin: 0;
    color: var(--color-dark);
  }
  
  .blog-content {
    padding: 60px 0;
  }
  
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
  }
  
  .article-card {
    background: white;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }
  
  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  
  .article-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  
  .article-card-image {
    height: 200px;
    overflow: hidden;
  }
  
  .article-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .article-card-content {
    padding: var(--spacing-lg);
  }
  
  .article-date {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 11px;
    color: #8e8e93;
    margin-bottom: 8px;
    padding-top: 4px;
    display: block;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
  
  .article-title {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 22px;
    line-height: 1.2;
    color: var(--color-dark);
    margin: 0 0 12px 0;
    padding: 0 4px;
    text-decoration: none;
    display: block;
    text-align: center;
  }
  
  .article-excerpt {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.5;
    color: var(--color-text);
    margin: 0;
    text-align: left;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .read-more {
    display: block;
    margin-top: 12px;
    color: var(--color-primary);
    font-weight: 600;
    text-align: center;
  }
  
  .blog-contacts {
    padding: 40px 0;
    background: var(--color-bg-alt);
  }
  
  .blog-contacts h2 {
    font-size: 1.8rem;
    margin-bottom: 30px;
    color: var(--color-dark);
  }
  
  .contacts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }
  
  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  
  .contact-item a {
    font-size: 1.3rem;
    color: var(--color-dark);
    text-decoration: none;
    font-weight: 600;
  }
  
  .contact-item a:hover {
    color: var(--color-primary);
  }
  
  @media (max-width: 768px) {
    .blog-hero h1 {
      font-size: 2rem;
    }
    
    .articles-grid {
      grid-template-columns: 1fr;
    }
    
    .article-title {
      font-size: 18px;
    }
    
    .article-excerpt {
      -webkit-line-clamp: 5;
    }
  }
</style>
