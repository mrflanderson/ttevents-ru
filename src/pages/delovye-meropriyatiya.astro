---
import Layout from '../components/Layout.astro';

const pageTitle = 'Деловые мероприятия';
const pageDescription = 'Организация деловых мероприятий: конференции, форумы, презентации, стратегические сессии.';
const keywords = 'деловые мероприятия, конференция, форум, презентация';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Деловые мероприятия</h1>
            <p>Профессиональная организация бизнес-событий</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <div class="grid grid-3">
                <div class="service-card"><h3>Конференции и форумы</h3><p>Крупные мероприятия</p></div>
                <div class="service-card"><h3>Стратегические сессии</h3><p>Рабочие сессии</p></div>
                <div class="service-card"><h3>Презентации</h3><p>Launch events</p></div>
                <div class="service-card"><h3>Семинары и тренинги</h3><p>Обучающие</p></div>
                <div class="service-card"><h3>Деловой туризм</h3><p>Выездные</p></div>
            </div>
        </div>
    </div>
</Layout>

<style>
.service-card { background: var(--color-white); padding: var(--space-lg); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
.service-card h3 { font-size: var(--font-size-base); margin-bottom: var(--space-sm); }
.service-card p { font-size: var(--font-size-sm); color: var(--color-secondary); }
</style>