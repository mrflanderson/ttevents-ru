---
import Layout from "../components/Layout.astro";

const pageMeta = {
    title: "Деловые мероприятия в Москве — конференции и форумы | TT Events",
    description:
        "Создаем площадки для диалога бизнеса и общества. Конференции, форумы, стратегические сессии, семинары и тренинги. Опыт работы с Агентством общественных проектов и ВДНХ.",
    ogTitle: "Деловые мероприятия в Москве — конференции и форумы | TT Events",
    ogDescription:
        "Организация экспертных конференций и стратегических сессий, которые формируют репутацию вашего бренда.",
};

const services = [
    {
        title: "Конференции и форумы",
        href: "/konferencii-i-forumy",
    },
    {
        title: "Стратегические сессии",
        href: "/strategicheskie-sessii-i-vorkshopy",
    },
    {
        title: "Семинары и тренинги",
        href: "/seminary-i-treningi",
    },
    {
        title: "MICE и деловой туризм",
        href: "/mice-delovoj-turizm",
    },
];

const faqItems = [
    {
        question: "Что включает организация делового мероприятия?",
        answer: "Разработка концепции, подбор площадки, техническое обеспечение, координация программы, логистика и полный цикл реализации.",
    },
    {
        question: "Какой минимальный состав команды?",
        answer: "От 10 человек до 1000+. Подбираем формат под ваш состав.",
    },
    {
        question: "Сколько длится деловое мероприятие?",
        answer: "От 2 часов до 3 дней. Стандарт — 1-2 дня.",
    },
];
---

<!--
  TT Events — Tailwind CSS Migration
  Generated on: 2026-05-17
-->
<Layout {...pageMeta}>
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4" aria-label="Навигация">
                <a href="/" class="hover:text-primary">Главная</a> / <span
                    class="font-medium text-text"
                    aria-current="page">Деловые мероприятия</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Деловые мероприятия в Москве
            </h1>
            <p class="text-lg text-text-light max-w-3xl mb-12">
                Создаем площадки для диалога бизнеса и общества. Конференции,
                форумы, стратегические сессии, семинары и тренинги. Опыт работы
                с Агентством общественных проектов и ВДНХ.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    services.map((service) => (
                        <a
                            href={service.href}
                            class="block p-6 bg-white rounded-xl shadow-card hover:shadow-card-hover transition-all duration-300"
                            aria-label={service.title}
                        >
                            <h3 class="text-xl font-heading font-semibold text-dark hover:text-primary transition-colors">
                                {service.title}
                            </h3>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="py-16 md:py-24">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2
                class="text-2xl md:text-3xl font-bold text-dark font-heading mb-8 text-center"
            >
                Часто задаваемые вопросы
            </h2>
            <div class="divide-y divide-gray-200">
                {
                    faqItems.map((item) => (
                        <div class="py-4">
                            <details>
                                <summary class="font-semibold cursor-pointer text-dark list-none">
                                    {item.question}
                                </summary>
                                <p class="mt-2 text-text-light leading-relaxed">
                                    {item.answer}
                                </p>
                            </details>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
