---
import Layout from "../components/Layout.astro";
const pageMeta = {
    title: "Event-агентство в Москве — TT Events",
    description:
        "TT Events — event-агентство полного цикла в Москве с 2006 года. Организация корпоративных мероприятий, фестивалей, тимбилдингов, деловых форумов и launch events.",
    ogTitle: "Event-агентство в Москве — TT Events",
    ogDescription:
        "Event-агентство полного цикла в Москве с 2006 года. Более 2000 проектов.",
};

const services = [
    { title: "Корпоративные мероприятия", href: "/korporativy-moskva" },
    {
        title: "Фестивали и городские события",
        href: "/festivaly-i-gorodskie-meropriyatiya",
    },
    { title: "Тимбилдинги", href: "/timbilding-moskva" },
    { title: "Деловые мероприятия", href: "/delovye-meropriyatiya" },
];

const faqItems = [
    {
        question: "Что делает event-агентство?",
        answer: "Полный цикл организации мероприятий: от концепции до проведения. Режиссура, техническое обеспечение, артисты и координация.",
    },
    {
        question: "Какой минимальный состав команды?",
        answer: "От 10 человек до 1000+. Подбираем формат под ваш состав.",
    },
    {
        question: "Сколько длится мероприятие?",
        answer: "От 2 часов до 3 дней. Стандарт — 4-6 часов.",
    },
];
---

<!--
  TT Events — Tailwind CSS Migration
  Generated on: 2026-05-17
-->
<Layout {...pageMeta}>
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4" aria-label="Навигация">
                <a href="/" class="hover:text-primary">Главная</a> / <span
                    class="font-medium text-text"
                    aria-current="page">Event-агентство</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Event-агентство в Москве
            </h1>
            <p class="text-lg text-text-light max-w-3xl mb-12">
                TT Events — event-агентство полного цикла в Москве с 2006 года.
                Организация корпоративных мероприятий, фестивалей, тимбилдингов,
                деловых форумов и launch events.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    services.map((service) => (
                        <a
                            href={service.href}
                            class="block p-6 bg-white rounded-xl shadow-card hover:shadow-card-hover transition-all duration-300"
                            aria-label={service.title}
                        >
                            <h3 class="text-xl font-heading font-semibold text-dark hover:text-primary transition-colors">
                                {service.title}
                            </h3>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="py-16 md:py-24">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2
                class="text-2xl md:text-3xl font-bold text-dark font-heading mb-8 text-center"
            >
                Часто задаваемые вопросы
            </h2>
            <div class="divide-y divide-gray-200">
                {
                    faqItems.map((item) => (
                        <div class="py-4">
                            <details>
                                <summary class="font-semibold cursor-pointer text-dark list-none">
                                    {item.question}
                                </summary>
                                <p class="mt-2 text-text-light leading-relaxed">
                                    {item.answer}
                                </p>
                            </details>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
