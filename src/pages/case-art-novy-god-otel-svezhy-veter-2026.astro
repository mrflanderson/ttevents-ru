---
import Layout from "../components/Layout.astro";

const pageTitle = "Новый год 2026 в SPA-отеле «Свежий Ветер» (Подмосковье)";
const pageDescription =
    "Новый год 2026 в SPA-отеле «Свежий Ветер» — арт-концепция для IT-компании";
const keywords =
    "новый год 2026 спa отель свежий ветер, арт-корпоратив новый год";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="py-16 md:py-24">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4">
                <a href="/" class="hover:text-primary">Главная</a> / <a
                    href="/case"
                    class="hover:text-primary">Кейсы</a
                > / <span class="font-medium text-text"
                    >Новый год 2026 в SPA-отеле</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Новый год 2026 в SPA-отеле «Свежий Ветер»
            </h1>
            <div class="prose prose-lg max-w-none">
                <p class="text-lg text-text-light mb-6">
                    Кейс: арт-концепция для IT-компании в загородном SPA-отеле
                    Подмосковья. Концепция — art-pop вечеринка с живыми
                    артистами и фото-зоной.
                </p>
                <h2 class="text-2xl font-heading font-bold text-dark mb-4 mt-8">
                    Формат
                </h2>
                <p class="text-text-light mb-6">
                    Вечерний банкет с живым выступлением артистов. Интерактивы с
                    живыми актерами и фотозона в стиле арт-галереи.
                </p>
            </div>
        </div>
    </div>
</Layout>
