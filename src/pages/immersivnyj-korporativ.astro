---
import Layout from '../components/Layout.astro';

const pageTitle = 'Иммерсивный корпоратив';
const pageDescription = 'Иммерсивный театр и необычные форматы. Театрализованные шоу, квесты, перформансы.';
const keywords = 'иммерсивный театр, театрализованный корпоратив, перформанс';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Иммерсивный корпоратив</h1>
            <p>Театрализованные шоу и квесты</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <ul class="feature-list mt-2">
                <li>Иммерсивный театр</li>
                <li>Театрализованные шоу</li>
                <li>Квест-перформансы</li>
                <li>Интерактивные представления</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Заказать</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>