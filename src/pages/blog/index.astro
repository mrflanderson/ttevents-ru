---
import { getCollection } from "astro:content";
import Layout from "../../components/Layout.astro";
import Hero from "../../components/Hero.astro";
import FAQ from "../../components/FAQ.astro";

const pageTitle = "Блог — статьи и новости event-агентства | TT Events";
const pageDescription =
    "Блог TT Events: идеи для корпоративов, тимбилдингов, конференции. Экспертные статьи о организации мероприятий в Москве с 2006 года.";
const keywords =
    "блог event агентства, статьи корпоративы, идеи мероприятий москва, новости ивент-индустрии";

const allPosts = await getCollection("blog");
const articles = allPosts
    .filter((p) => p.data.published !== false)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
    .map((p) => {
        const slug = p.id; // e.g. "3-trendy-organizacii-korporativov-2026"
        return {
            title: p.data.title,
            href: `/blog/${slug}`,
            category: p.data.tags?.[0] || "Статья",
            coverImage: p.data.coverImage,
            description: p.data.description,
        };
    });

const faqItems = [
    {
        question: "Какие темы освещаются в блоге?",
        answer: "Идеи для корпоративов, тимбилдингов, конференций, тренды в ивент-индустрии, советы по организации мероприятий.",
    },
    {
        question: "Можно ли заказать статью или гостевой пост?",
        answer: "Да, мы готовы поделиться экспертизой для ваших публикаций.",
    },
    {
        question: "Как часто выходят новые материалы?",
        answer: "Регулярно — мы публикуем актуальные идеи и кейсы после каждого масштабного проекта.",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    canonicalURL="/blog"
>
    <div class="page-service">
        <!-- Hero Section -->
        <Hero
            title="Блог TT Events"
            subtitle="Экспертные статьи о корпоративах, тимбилдингах, конференциях и трендах event-индустрии."
            ctaText="Получить консультацию"
            ctaHref="/kontakty"
            backgroundImage="/images/blog-hero-bg.jpg"
        />

        <!-- About Section -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-dark font-heading mb-6"
                    >
                        Делимся экспертизой
                    </h2>
                    <p class="text-lg text-text-light mb-4">
                        В нашем блоге мы публикуем актуальные идеи для
                        корпоративов, тимбилдингов и конференций, а также
                        аналитику по трендам event-индустрии.
                    </p>
                    <p class="text-lg text-text-light mb-8">
                        Каждая статья основана на реальном опыте проведения
                        мероприятий — от 50 до 10 000+ участников. Мы не просто
                        пишем, а делимся тем, что работает.
                    </p>
                    <div class="flex flex-wrap justify-center gap-4">
                        <a href="/kontakty" class="btn-primary"
                            >Получить консультацию</a
                        >
                        <a href="/case" class="btn-outline">Смотреть кейсы</a>
                    </div>
                </div>
            </div>
        </section>

        <!-- Articles Grid -->
        <section class="py-16 md:py-24 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="section-title mb-16">Последние публикации</h2>
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8"
                >
                    {
                        articles.map((article) => (
                            <article class="bg-white rounded-xl shadow-card hover:-translate-y-1 transition-all duration-300 overflow-hidden">
                                <a
                                    href={article.href}
                                    class="block text-inherit no-underline"
                                >
                                    <div class="relative h-48 overflow-hidden">
                                        <img
                                            src={article.coverImage ?? "/images/blog-hero-bg.jpg"}
                                            alt={article.title}
                                            width="400"
                                            height="300"
                                            sizes="(max-width: 768px) 100vw, 33vw"
                                            loading="lazy"
                                            class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                                        />
                                        <span class="absolute top-4 left-4 bg-primary text-white text-xs font-semibold px-3 py-1 rounded">
                                            {article.category}
                                        </span>
                                    </div>
                                    <div class="p-6">
                                        <h3 class="text-lg font-heading font-semibold">
                                            {article.title}
                                        </h3>
                                    </div>
                                </a>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Advantages -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2
                    class="text-3xl md:text-4xl font-bold text-center mb-12 text-dark font-heading"
                >
                    Почему стоит читать наш блог
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            2000+
                        </div>
                        <h3 class="text-xl font-semibold mb-2">Мероприятий</h3>
                        <p class="text-text-light">Опыт за каждым советом</p>
                    </div>
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            100+
                        </div>
                        <h3 class="text-xl font-semibold mb-2">
                            Статей в блоге
                        </h3>
                        <p class="text-text-light">Экспертный контент</p>
                    </div>
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            100K+
                        </div>
                        <h3 class="text-xl font-semibold mb-2">
                            Читателей в год
                        </h3>
                        <p class="text-text-light">Вовлечённая аудитория</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <FAQ items={faqItems} />
    </div>
</Layout>
