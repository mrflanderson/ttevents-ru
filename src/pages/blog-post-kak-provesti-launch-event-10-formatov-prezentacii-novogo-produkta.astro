---
import Layout from "../components/Layout.astro";

const pageTitle =
    "Как провести launch event — 10 форматов презентации нового продукта";
const pageDescription =
    "10 форматов презентации нового продукта: от иммерсивного шоу до арт-инсталляции. Как провести launch event в Москве и не забыть о деталях.";
const keywords =
    "launch event москва, презентация нового продукта, презентация продукта, организация launch event";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="py-16 md:py-24">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4">
                <a href="/" class="hover:text-primary">Главная</a> / <a
                    href="/blog"
                    class="hover:text-primary">Блог</a
                > / <span class="font-medium text-text"
                    >10 форматов launch event</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Как провести launch event — 10 форматов презентации нового
                продукта
            </h1>
            <div class="prose prose-lg max-w-none">
                <p class="text-lg text-text-light mb-6">
                    Презентация нового продукта — это не просто показ слайдов.
                    Это история, которую нужно рассказать через пространство,
                    свет и взаимодействие. Вот форматы, которые работают.
                </p>
                <h2 class="text-2xl font-heading font-bold text-dark mb-4 mt-8">
                    1. Иммерсивное шоу
                </h2>
                <p class="text-text-light mb-6">
                    Гости погружаются в историю продукта через визуальные
                    инсталляции и живое выступление артистов.
                </p>
                <h2 class="text-2xl font-heading font-bold text-dark mb-4 mt-8">
                    2. Арт-инсталляция
                </h2>
                <p class="text-text-light mb-6">
                    Продукт представлен как арт-объект. Гости взаимодействуют с
                    инсталляцией, делают фото и делятся впечатлениями.
                </p>
            </div>
        </div>
    </div>
</Layout>
