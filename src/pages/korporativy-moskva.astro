---
import Layout from "../components/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import Hero from "../components/Hero.astro";
import FAQ from "../components/FAQ.astro";

const pageTitle =
    "Корпоративные мероприятия в Москве — организация корпоративов под ключ | TT Events";
const pageDescription =
    "Организация корпоративных мероприятий в Москве любой сложности: банкеты, шоу-программы, тимбилдинги, новогодние корпоративы, летние выезды. Более 20 лет опыта.";
const keywords =
    "корпоративные мероприятия москва, организация корпоратива, корпоратив под ключ, проведение корпоратива";

const subServices = [
    { title: "Банкет/шоу-программа", href: "/classic", count: 120 },
    {
        title: "Новогодний корпоратив",
        href: "/novogodniy-korporativ",
        count: 85,
    },
    { title: "Летний корпоратив", href: "/letnij-korporativ", count: 95 },
    {
        title: "Корпоратив на природе",
        href: "/korporativ-na-prirode",
        count: 70,
    },
    { title: "Тематический корпоратив", href: "/art-korporativ", count: 60 },
    { title: "Юбилей компании", href: "/yubilej-kompanii", count: 50 },
    {
        title: "Иммерсивные мероприятия",
        href: "/immersivnyj-korporativ",
        count: 40,
    },
    {
        title: "Интеллектуальные игры",
        href: "/intellektualnye-igry",
        count: 55,
    },
];

const faqItems = [
    {
        question: "Сколько стоит организация корпоратива?",
        answer: "Стоимость зависит от формата, количества гостей и уровня сервиса. Базовый пакет от 150 000 ₽. Мы подготовим индивидуальное коммерческое предложение после уточнения деталей.",
    },
    {
        question: "Какие гарантии вы предоставляете?",
        answer: "Мы работаем по договору с фиксированной сметой. Полная организация включает техническое обеспечение, развлечения, кейтеринг и координацию в день мероприятия.",
    },
    {
        question: "За какое время нужно бронировать?",
        answer: "Рекомендуем бронировать за 1-2 месяца для небольших мероприятий и за 3-4 месяца для крупных событий с программой и арендой площадки.",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    canonicalURL="/korporativy-moskva"
>
    <div class="page-service">
        <!-- Hero Section -->
        <Hero
            title="Корпоративные мероприятия в Москве"
            subtitle="Организация корпоративов любой сложности с 2006 года. Более 2000 реализованных проектов."
            ctaText="Обсудить мероприятие"
            ctaHref="/kontakty"
            backgroundImage="/g/s3/mosaic/images/korporativ-bg.jpg"
        />

        <!-- About Section -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div
                    class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
                >
                    <div>
                        <h2
                            class="text-3xl md:text-4xl font-bold text-dark font-heading mb-6"
                        >
                            Корпоративные мероприятия — это не просто праздник,
                            а стратегическая задача
                        </h2>
                        <p class="text-lg text-text-light mb-4">
                            TT Events организует корпоративные мероприятия
                            любого масштаба: от камерных встреч команды до
                            масштабных корпоративов на 1000+ гостей.
                        </p>
                        <p class="text-lg text-text-light mb-6">
                            Мы создаём уникальные программы, которые решают
                            бизнес-задачи: повышение лояльности, мотивация
                            команды, укрепление партнёрских отношений.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <a href="/kontakty" class="btn-primary"
                                >Получить предложение</a
                            >
                            <a href="/case" class="btn-outline"
                                >Смотреть кейсы</a
                            >
                        </div>
                    </div>
                    <div class="rounded-xl overflow-hidden shadow-card">
                        <img
                            src="/g/s3/mosaic/images/korporativ-main.jpg"
                            alt="Корпоративное мероприятие"
                            width="600"
                            height="400"
                            class="w-full h-auto"
                            loading="lazy"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- Services Grid -->
        <section class="py-16 md:py-24 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="section-title mb-16">
                    Форматы корпоративных мероприятий
                </h2>
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8"
                >
                    {subServices.map((service) => <ServiceCard {...service} />)}
                </div>
            </div>
        </section>

        <!-- Advantages -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2
                    class="text-3xl md:text-4xl font-bold text-center mb-12 text-dark font-heading"
                >
                    Почему выбирают TT Events
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            20+
                        </div>
                        <h3 class="text-xl font-semibold mb-2">Лет опыта</h3>
                        <p class="text-text-light">
                            Организация мероприятий с 2006 года
                        </p>
                    </div>
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            2000+
                        </div>
                        <h3 class="text-xl font-semibold mb-2">
                            Реализованных проектов
                        </h3>
                        <p class="text-text-light">
                            Корпоративы, тимбилдинги, конференции
                        </p>
                    </div>
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            100%
                        </div>
                        <h3 class="text-xl font-semibold mb-2">
                            Гарантия качества
                        </h3>
                        <p class="text-text-light">
                            Полное сопровождение мероприятия
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <FAQ items={faqItems} />
    </div>
</Layout>
