---
import Layout from '../components/Layout.astro';

const pageTitle = 'Корпоративные мероприятия в Москве';
const pageDescription = 'Организация корпоративов в Москве: банкеты, шоу-программы, новогодние мероприятия, тематические вечеринки. TT Events — опыт 15 лет, 2000+ проектов.';
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="page-header">
        <div class="container">
            <h1>Корпоративные мероприятия</h1>
            <p>Создаём мероприятия, о которых говорят и вспоминают с теплом</p>
        </div>
    </div>

    <div class="page-content">
        <div class="container">
            <div class="grid grid-3">
                <a href="/classic" class="service-card">
                    <h2>Банкет / Шоу-программа</h2>
                    <p>Классический формат: банкет с развлекательной программой</p>
                </a>
                
                <a href="/novogodniy-korporativ" class="service-card">
                    <h2>Новогодний корпоратив</h2>
                    <p>Новогодние мероприятия — от банкетов до шоу</p>
                </a>
                
                <a href="/letnij-korporativ" class="service-card">
                    <h2>Летний корпоратив</h2>
                    <p>Мероприятия на открытом воздухе</p>
                </a>
                
                <a href="/korporativ-na-prirode" class="service-card">
                    <h2>Корпоратив на природе</h2>
                    <p>Выездные мероприятия за городом</p>
                </a>
                
                <a href="/art-korporativ" class="service-card">
                    <h2>Тематический корпоратив</h2>
                    <p>Арт-вечеринки, иммерсивные шоу</p>
                </a>
                
                <a href="/yubilej-kompanii" class="service-card">
                    <h2>Юбилей компании</h2>
                    <p>Торжественные мероприятия</p>
                </a>
            </div>
        </div>
    </div>

    <section class="section cta-section">
        <div class="container text-center">
            <h2>Нужна консультация?</h2>
            <a href="tel:+79169064490" class="btn btn-primary">+7 (916) 906-44-90</a>
        </div>
    </section>
</Layout>

<style>
.service-card {
    background: var(--color-white);
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: all var(--transition);
    display: block;
}

.service-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    color: var(--color-primary);
}

.service-card h2 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-sm);
}

.service-card p {
    color: var(--color-secondary);
    font-size: var(--font-size-sm);
}

.cta-section {
    background: var(--color-white);
    padding: var(--space-2xl) 0;
    margin-top: var(--space-2xl);
}
</style>