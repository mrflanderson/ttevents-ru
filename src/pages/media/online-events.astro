---
import Layout from "../../components/Layout.astro";

const pageTitle = "Онлайн-мероприятия — TT Events";
const pageDescription = "TT Events организует онлайн и гибридные мероприятия: live-трансляции, мульти-камера, интерактивы.";
const keywords = "онлайн мероприятия, гибридные мероприятия, live-трансляции";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords} canonicalURL="/media/online-events">
    <div class="page-service">
        <section class="py-16 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <nav class="text-sm text-text-light mb-4">
                    <a href="/" class="hover:text-primary">Главная</a> / <a href="/media" class="hover:text-primary">Media</a> / <span class="font-medium text-text">Онлайн-мероприятия</span>
                </nav>
                <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-6">Онлайн-мероприятия</h1>
                <p class="text-lg text-text-light mb-8">
                    Live-трансляции, гибридные события, мульти-камера, интерактивы, платформы, модерация.
                    Полное техническое сопровождение.
                </p>
                <ul class="list-disc list-inside space-y-2 text-text-light mb-8">
                    <li>Мульти-камера, звук, свет, режиссура эфиров.</li>
                    <li>Работа с платформами и кастомными landing.</li>
                    <li>Онлайн-интерактивы: чаты, опросы, Q&A, модерация.</li>
                </ul>
                <div class="flex flex-wrap gap-4 mb-8">
                    <a href="/kontakty" class="btn-primary">Обсудить онлайн-мероприятие</a>
                    <a href="/media" class="btn-outline">← Media</a>
                </div>
            </div>
        </section>
    </div>
</Layout>
