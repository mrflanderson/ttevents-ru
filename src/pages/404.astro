---
import Layout from "../components/Layout.astro";

const pageTitle = "Страница не найдена — TT Events";
const pageDescription =
    "Запрошенная страница не найдена. TT Events — организация корпоративных мероприятий в Москве.";
---

<Layout title={pageTitle} description={pageDescription}>
    <main
        class="min-h-[60vh] flex items-center justify-center text-center py-16 px-4"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="text-8xl font-bold text-red-600">404</h1>
            <p class="text-2xl font-semibold mt-4">Страница не найдена</p>
            <p class="text-xl text-gray-600 mb-8">
                Извините, запрошенная страница не существует или была
                перемещена.
            </p>
            <nav class="flex gap-4 justify-center flex-wrap">
                <a
                    href="/"
                    class="inline-flex items-center px-6 py-3 rounded-lg font-semibold bg-red-600 hover:bg-red-700 text-white"
                    >На главную</a
                >
                <a
                    href="/case"
                    class="inline-flex items-center px-6 py-3 rounded-lg font-semibold bg-gray-100 hover:bg-gray-200 text-gray-900"
                    >Наши кейсы</a
                >
                <a
                    href="/korporativy-moskva"
                    class="inline-flex items-center px-6 py-3 rounded-lg font-semibold bg-gray-100 hover:bg-gray-200 text-gray-900"
                    >Корпоративы</a
                >
            </nav>
        </div>
    </main>
</Layout>
