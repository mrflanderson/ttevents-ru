---
import Layout from '../components/Layout.astro';

const pageTitle = 'Страница не найдена — TT Events';
const pageDescription = 'Запрошенная страница не найдена. TT Events — организация корпоративных мероприятий в Москве.';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="not-found">
    <div class="container">
      <h1>404</h1>
      <p class="subtitle">Страница не найдена</p>
      <p class="description">Извините, запрошенная страница не существует или была перемещена.</p>
      <div class="links">
        <a href="/" class="btn btn-primary">На главную</a>
        <a href="/case" class="btn btn-secondary">Наши кейсы</a>
        <a href="/korporativy-moskva" class="btn btn-secondary">Корпоративы</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1rem;
  }

  h1 {
    font-size: 8rem;
    font-weight: 700;
    color: var(--primary-color, #e53935);
    margin: 0;
    line-height: 1;
  }

  .subtitle {
    font-size: 2rem;
    font-weight: 600;
    margin: 1rem 0;
  }

  .description {
    font-size: 1.25rem;
    color: #666;
    margin-bottom: 2rem;
  }

  .links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    font-weight: 500;
  }

  .btn-primary {
    background: #e53935;
    color: white;
  }

  .btn-secondary {
    background: #f5f5f5;
    color: #333;
  }
</style>