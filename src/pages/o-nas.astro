---
import Layout from "../components/Layout.astro";
import FAQSection from "../components/sections/FAQSection.astro";

const pageMeta = {
    title: "О нас — TT Events",
    description:
        "TT Events — event-агентство полного цикла в Москве с 2006 года. Более 2000 проектов: корпоративы, тимбилдинги, launch events, фестивали и арт-концепции.",
    ogTitle: "О нас — TT Events",
    ogDescription:
        "Event-агентство полного цикла в Москве. Более 2000 проектов с 2006 года.",
};

const services = [
    { title: "Корпоративные мероприятия", href: "/korporativy-moskva" },
    { title: "Тимбилдинги", href: "/timbilding-moskva" },
    { title: "Деловые мероприятия", href: "/delovye-meropriyatiya" },
    {
        title: "Launch Events",
        href: "/prezentacii-novyh-produktov-launch-events",
    },
];

const faqItems = [
    {
        question: "Сколько лет работает TT Events?",
        answer: "С 2006 года. Более 18 лет опыта в организации мероприятий.",
    },
    {
        question: "Сколько проектов реализовано?",
        answer: "Более 2000 проектов с 2006 года.",
    },
    {
        question: "Какой минимальный состав команды?",
        answer: "От 10 человек до 1000+. Подбираем формат под ваш состав.",
    },
];
---

<!--
  TT Events — Tailwind CSS Migration
  Generated on: 2026-05-17
-->
<Layout {...pageMeta}>
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4" aria-label="Навигация">
                <a href="/" class="hover:text-primary">Главная</a> / <span
                    class="font-medium text-text"
                    aria-current="page">О нас</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                TT Events — о нас
            </h1>
            <p class="text-lg text-text-light max-w-3xl mb-12">
                Event-агентство полного цикла в Москве с 2006 года. Более 2000
                проектов: корпоративы, тимбилдинги, launch events, фестивали и
                арт-концепции.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    services.map((service) => (
                        <a
                            href={service.href}
                            class="block p-6 bg-white rounded-xl shadow-card hover:shadow-card-hover transition-all duration-300"
                            aria-label={service.title}
                        >
                            <h3 class="text-xl font-heading font-semibold text-dark hover:text-primary transition-colors">
                                {service.title}
                            </h3>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <FAQSection items={faqItems} />
</Layout>
