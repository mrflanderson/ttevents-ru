---
import Layout from '../components/Layout.astro';

const pageTitle = 'О нас — TT Events';
const pageDescription = 'TT Events — event-агентство полного цикла в Москве с 2006 года. Более 2000 проектов, собственный театр, команда профессионалов.';
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="page-header">
        <div class="container">
            <h1>О нас</h1>
            <p>Event-агентство полного цикла</p>
        </div>
    </div>

    <div class="page-content">
        <div class="container">
            <div class="content-block">
                <h2>Кто мы</h2>
                <p>TT Events (Театр Традиций) — event-агентство полного цикла в Москве. С 2006 года создаём мероприятия, которые объединяют людей и создают незабываемые эмоции.</p>
                
                <h2>Наши преимущества</h2>
                <ul>
                    <li>Более 2000 реализованных проектов</li>
                    <li>Собственный театр и команда артистов</li>
                    <li>Полный цикл — от идеи до видеосъёмки</li>
                    <li>Своё техническое оснащение</li>
                </ul>
                
                <h2>Контакты</h2>
                <div class="contact-info mt-2">
                    <p><strong>Телефон:</strong> <a href="tel:+79169064490">+7 (916) 906-44-90</a></p>
                    <p><strong>Email:</strong> <a href="mailto:mail@ttevents.ru">mail@ttevents.ru</a></p>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
.content-block h2 {
    font-size: var(--font-size-2xl);
    margin: var(--space-xl) 0 var(--space-md);
}

.content-block h2:first-child {
    margin-top: 0;
}

.content-block p {
    margin-bottom: var(--space-md);
    max-width: 600px;
}

.content-block ul {
    list-style: disc;
    padding-left: var(--space-xl);
    margin-bottom: var(--space-md);
}

.content-block li {
    margin-bottom: var(--space-sm);
}

.contact-info p {
    margin-bottom: var(--space-sm);
}

.contact-info a {
    color: var(--color-accent);
}
</style>