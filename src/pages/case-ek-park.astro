---
import Layout from '../components/Layout.astro';

const pageTitle = 'Кейс: ЕК Парк';
const pageDescription = 'Мероприятие в ЕК Парк. Парковое событие.';
const keywords = 'парк, мероприятие, кейс';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Кейс: ЕК Парк</h1>
            <p>Мероприятие в парке</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <ul class="feature-list mt-2">
                <li>Парковая площадка</li>
                <li>Фестиваль</li>
            </ul>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
</style>