---
import Layout from "../components/Layout.astro";
import FAQSection from "../components/sections/FAQSection.astro";

const pageTitle = "Часто задаваемые вопросы — TT Events";
const pageDescription =
    "Ответы на часто задаваемые вопросы: стоимость мероприятий, сроки, тендеры, гибридные форматы, гарантии.";
const keywords = "faq event агентство, вопросы про организацию мероприятий";

const faqItems = [
    {
        question: "Сколько стоят мероприятия?",
        answer: "Стоимость зависит от формата, количества гостей, локации и уровня сервиса. Базовый корпоратив от 150 000 ₽, крупные мероприятия рассчитываются индивидуально. Мы подготовим точное КП после брифинга.",
    },
    {
        question: "За какое время нужно планировать мероприятие?",
        answer: "Рекомендуем: от 4–6 недель для стандартных проектов и от 2–3 месяцев для сложных форматов, фестивалей и выездных событий.",
    },
    {
        question: "Работаете ли вы по тендеру?",
        answer: "Да. Участвуем в открытых и закрытых процедурах, работаем с госконтрактами и корпоративными закупками.",
    },
    {
        question: "Организуете ли вы гибридные / онлайн-мероприятия?",
        answer: "Да. Live-трансляции, мульти-камера, платформы, интерактивы. Мы обеспечиваем техническую реализацию и режиссуру.",
    },
    {
        question: "Можно ли заказать только часть услуг?",
        answer: "Да. Мы можем полностью вести проект под ключ или подключиться на конкретные задачи: сценарий, техобеспечение, продакшн.",
    },
    {
        question: "Работаете ли за пределами Москвы?",
        answer: "Да, по всей России и СНГ. Логистику, подрядчиков и локаций настраиваем под ваш проект.",
    },
    {
        question: "Даёте ли гарантии?",
        answer: "Работаем по договору с фиксированной сметой и планом. Полная ответственность за сроки, качество и соответствие ТЗ.",
    },
    {
        question: "Входит ли видеопродакшн в стандартный пакет?",
        answer: "По умолчанию включаем базовую фото- и видеосъёмку. Полноценный продакшн и имиджевые ролики обсуждаем отдельно.",
    },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    canonicalURL="/faq"
    jsonLd={jsonLd}
>
    <FAQSection items={faqItems} />
</Layout>
