---
import Layout from "../components/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";

const pageTitle =
    "Туристические и экскурсионные мероприятия в Москве — организация экскурсий для корпоративов";
const pageDescription =
    "Организация туристических и экскурсионных мероприятий для корпоративов в Москве. Групповые экскурсии, тимбилдинг-прогулки, исторические маршруты.";
const keywords =
    "туристические мероприятия москва, экскурсионные мероприятия, корпоративные экскурсии, групповые прогулки, тимбилдинг-экскурсия";

const services = [
    {
        title: "Экскурсии по Москве",
        href: "/o-nas",
        image: "/images/tour-moscow.jpg",
        count: 120,
    },
    {
        title: "Тематические туры",
        href: "/o-nas",
        image: "/images/tour-theme.jpg",
        count: 80,
    },
    {
        title: "Выездные экскурсии",
        href: "/o-nas",
        image: "/images/tour-outdoor.jpg",
        count: 95,
    },
    {
        title: "Квест-экскурсии",
        href: "/o-nas",
        image: "/images/tour-quest.jpg",
        count: 60,
    },
    {
        title: "Исторические маршруты",
        href: "/o-nas",
        image: "/images/tour-history.jpg",
        count: 150,
    },
    {
        title: "Гастрономические туры",
        href: "/o-nas",
        image: "/images/tour-food.jpg",
        count: 70,
    },
];

const faqItems = [
    {
        question: "Сколько человек может участвовать?",
        answer: "От 10 до 200+ человек. Мы подберем маршрут под ваш размер группы.",
    },
    {
        question: "Сколько времени занимает экскурсия?",
        answer: "Стандартная экскурсия — 2-4 часа. Полнодневная — 6-8 часов.",
    },
    {
        question: "Где проходят экскурсии?",
        answer: "По Москве и Подмосковью. Возможны выездные маршруты.",
    },
    {
        question: "Можно ли заказать индивидуальную экскурсию?",
        answer: "Да, мы разрабатываем индивидуальные маршруты под ваши задачи.",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    ogTitle={pageTitle}
    ogDescription={pageDescription}
>
    <div class="page-content">
        <!-- Hero Section -->
        <section
            class="relative min-h-[500px] md:min-h-[600px] flex items-center text-white overflow-hidden"
        >
            <img
                src="/images/tour-hero.jpg"
                alt="Туристические мероприятия — экскурсии для корпоративов"
                class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-black/50"></div>

            <div
                class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full"
            >
                <div class="max-w-[800px]">
                    <nav class="text-sm text-text-light mb-4">
                        <a href="/" class="hover:text-primary">Главная</a> / <span
                            class="font-medium text-text"
                            >Туристические мероприятия</span
                        >
                    </nav>
                    <h1
                        class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6"
                    >
                        Туристические и экскурсионные мероприятия в Москве
                    </h1>
                    <p class="text-lg md:text-xl text-white/90 mb-10">
                        Организация корпоративных экскурсий, тимбилдинг-прогулок
                        и тематических маршрутов для команд любого размера.
                    </p>
                    <a
                        href="/kontakty"
                        class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg hover:shadow-xl transition-all duration-300"
                    >
                        Получить расчёт бюджета
                    </a>
                </div>
            </div>
        </section>

        <!-- Content Section -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="prose prose-lg max-w-none">
                    <h2
                        class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                    >
                        Форматы экскурсионных мероприятий
                    </h2>
                    <p class="text-lg text-text-light mb-8">
                        TT Events организует экскурсии для корпоративов в Москве
                        и по всей России. Мы предлагаем разнообразные форматы —
                        от исторических маршрутов до тематических квестов.
                    </p>

                    <div
                        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12"
                    >
                        {
                            services.map((service) => (
                                <ServiceCard {...service} />
                            ))
                        }
                    </div>

                    <h2
                        class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                    >
                        Как мы работаем
                    </h2>
                    <div
                        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12"
                    >
                        <div class="bg-white rounded-xl p-6 shadow-card">
                            <div class="text-primary text-2xl font-bold mb-3">
                                01
                            </div>
                            <h3 class="text-lg font-heading font-semibold mb-2">
                                Брифинг
                            </h3>
                            <p class="text-text-light text-sm">
                                Определяем цели, интересы и формат мероприятия.
                            </p>
                        </div>

                        <div class="bg-white rounded-xl p-6 shadow-card">
                            <div class="text-primary text-2xl font-bold mb-3">
                                02
                            </div>
                            <h3 class="text-lg font-heading font-semibold mb-2">
                                Подбор маршрута
                            </h3>
                            <p class="text-text-light text-sm">
                                Выбираем подходящие площадки и локации.
                            </p>
                        </div>

                        <div class="bg-white rounded-xl p-6 shadow-card">
                            <div class="text-primary text-2xl font-bold mb-3">
                                03
                            </div>
                            <h3 class="text-lg font-heading font-semibold mb-2">
                                Организация
                            </h3>
                            <p class="text-text-light text-sm">
                                Транспорт, гиды, безопасность и логистика.
                            </p>
                        </div>

                        <div class="bg-white rounded-xl p-6 shadow-card">
                            <div class="text-primary text-2xl font-bold mb-3">
                                04
                            </div>
                            <h3 class="text-lg font-heading font-semibold mb-2">
                                Проведение
                            </h3>
                            <p class="text-text-light text-sm">
                                Профессиональное сопровождение маршрута.
                            </p>
                        </div>

                        <div class="bg-white rounded-xl p-6 shadow-card">
                            <div class="text-primary text-2xl font-bold mb-3">
                                05
                            </div>
                            <h3 class="text-lg font-heading font-semibold mb-2">
                                Отчёт
                            </h3>
                            <p class="text-text-light text-sm">
                                Сбор обратной связи и фотоотчёт.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="py-16 md:py-24 bg-gray-50">
            <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4"
                    >
                        Часто задаваемые вопросы
                    </h2>
                </div>

                <div class="space-y-4">
                    {
                        faqItems.map((item) => (
                            <div class="bg-white rounded-xl p-6 shadow-card">
                                <details>
                                    <summary class="font-heading font-semibold cursor-pointer text-dark mb-2">
                                        {item.question}
                                    </summary>
                                    <p class="text-text-light">{item.answer}</p>
                                </details>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section
            class="relative min-h-[400px] flex items-center text-white overflow-hidden py-24"
        >
            <img
                src="/images/tour-hero.jpg"
                alt=""
                class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-primary/80"></div>

            <div
                class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center"
            >
                <h2
                    class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-6"
                >
                    Свяжитесь с нами
                </h2>
                <p
                    class="text-lg md:text-xl text-white/90 mb-10 max-w-2xl mx-auto"
                >
                    Предложим формат и рассчитаем бюджет в течение 1 дня
                </p>
                <div
                    class="flex flex-col sm:flex-row gap-4 justify-center items-center"
                >
                    <a
                        href="tel:+79169064490"
                        class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-white hover:bg-white/90 text-primary shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                    >
                        +7 (916) 906-44-90
                    </a>
                    <a
                        href="/kontakty"
                        class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-transparent border-2 border-white hover:bg-white hover:text-primary text-white shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                    >
                        Оставить заявку
                    </a>
                </div>
            </div>
        </section>
    </div>
</Layout>
