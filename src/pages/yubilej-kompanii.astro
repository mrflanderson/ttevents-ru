---
import Layout from '../components/Layout.astro';

const pageTitle = 'Юбилей компании';
const pageDescription = 'Торжественные мероприятия к юбилею компании. Организация юбилеев любого масштаба в Москве.';
const keywords = 'юбилей компании, торжественное мероприятие, юбилей фирмы';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Юбилей компании</h1>
            <p>Торжественное событие для вашей компании</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <p>Юбилей — особое событие, которое требует профессиональной организации:</p>
            <ul class="feature-list mt-2">
                <li>Торжественная программа</li>
                <li>Фильм о компании</li>
                <li>Тематическое оформление</li>
                <li>Почётные гости</li>
                <li>Памятные подарки</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Организовать юбилей</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.feature-list li { margin-bottom: var(--space-sm); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>