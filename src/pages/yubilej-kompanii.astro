---
import Layout from "../components/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import PageHero from "../components/sections/PageHero.astro";
import FAQSection from "../components/sections/FAQSection.astro";
import CTASection from "../components/sections/CTASection.astro";

const pageTitle =
    "Юбилей компании — организация праздника для корпоратива | TT Events";
const pageDescription =
    "Организация юбилеев компании в Москве: корпоративные дни рождения, праздники, церемонии. Полное сопровождение и креативные программы с 2006 года.";
const keywords =
    "юбилей компании москва, организация корпоративного праздника, день рождения компании, корпоративный юбилей, празднование годовщины";

const services = [
    { title: "День рождения компании", href: "/yubilej-kompanii", count: 45 },
    { title: "Годовщина создания", href: "/yubilej-kompanii", count: 35 },
    { title: "Корпоративный праздник", href: "/korporativy-moskva", count: 60 },
    { title: "Церемония награждения", href: "/yubilej-kompanii", count: 40 },
    { title: "Торжественный ужин", href: "/yubilej-kompanii", count: 50 },
    { title: "Празднование юбилея", href: "/party", count: 55 },
];

const faqItems = [
    {
        question: "Как вы планируете юбилей компании?",
        answer: "Разрабатываем уникальную концепцию с учётом истории компании, возраста и пожеланий сотрудников. Каждое мероприятие — уникально.",
    },
    {
        question: "Сколько стоит организация юбилея?",
        answer: "Стоимость зависит от количества гостей, формата и площадки. Минимальный бюджет — от 1 500 000 ₽.",
    },
    {
        question: "Можно ли организовать выездной юбилей?",
        answer: "Да, мы организуем выездные юбилеи на природе, в загородных клубах и отелях.",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    canonicalURL="/yubilej-kompanii"
>
    <!-- Hero Section -->
    <PageHero
        title="Юбилей компании в Москве"
        subtitle="Организация юбилеев компании под ключ: корпоративные дни рождения, праздники, церемонии. Полное сопровождение и креативные программы."
        cta={{ label: "Обсудить проект", href: "/kontakty" }}
        backgroundImage="/images/anniversary-hero.jpg"
    />

    <!-- Content Section -->
    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="prose prose-lg max-w-none">
                <h2
                    class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                >
                    Форматы юбилейных мероприятий
                </h2>
                <p class="text-lg text-text-light mb-8">
                    TT Events организует юбилеи компаний для корпоративов в
                    Москве. Мы предлагаем разнообразные форматы — от
                    торжественных церемоний до праздников на природе.
                </p>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12"
                >
                    {services.map((service) => <ServiceCard {...service} />)}
                </div>

                <h2
                    class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                >
                    Как мы работаем
                </h2>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12"
                >
                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            01
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Брифинг
                        </h3>
                        <p class="text-text-light text-sm">
                            Определяем цели, интересы и формат мероприятия.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            02
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Концепция
                        </h3>
                        <p class="text-text-light text-sm">
                            Разрабатываем уникальную идею и программу.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            03
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Подготовка
                        </h3>
                        <p class="text-text-light text-sm">
                            Площадка, декор, анимация и безопасность.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            04
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Проведение
                        </h3>
                        <p class="text-text-light text-sm">
                            Полное сопровождение праздника.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            05
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Фото и видео
                        </h3>
                        <p class="text-text-light text-sm">
                            Профессиональная съёмка и монтаж.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <FAQSection items={faqItems} />

    <!-- CTA Section -->
    <CTASection
        title="Свяжитесь с нами"
        description="Предложим формат и рассчитаем бюджет в течение 1 дня"
        button1Label="+7 (916) 906-44-90"
        button1Href="tel:+79169064490"
        button1Type="primary"
        button2Label="Оставить заявку"
        button2Href="/kontakty"
        showPhone={false}
        showEmail={false}
    />

    <!-- Hub link -->
    <section class="py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="text-sm text-text-light">
                Все корпоративные мероприятия →
                <a href="/services/corporate-events" class="underline hover:text-primary">
                    /services/corporate-events
                </a>
            </p>
        </div>
    </section>
</Layout>
