---
import Layout from "../components/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CaseCard from "../components/CaseCard.astro";

const pageTitle =
    "Юбилей компании в Москве — организация юбилейных мероприятий под ключ";
const pageDescription =
    "Организация юбилеев компании в Москве. Торжественные церемонии, юбилеи организации, дати-пати и commemorative events любой сложности.";
const keywords =
    "юбилей компании москва, организация юбилея, дати-пати, commemorative event, юбилейное мероприятие";

const relatedServices = [
    {
        title: "Корпоративные мероприятия",
        href: "/korporativy-moskva",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
        count: 450,
    },
    {
        title: "Тимбилдинги",
        href: "/timbilding-moskva",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
        count: 380,
    },
    {
        title: "Деловые мероприятия",
        href: "/delovye-meropriyatiya",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
        count: 290,
    },
];

const relevantCases = [
    {
        title: "Корпоратив для Росатома",
        href: "/case/rosatom",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
    },
    {
        title: "Новогодний корпоратив 2026",
        href: "/case/artpop",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    ogTitle={pageTitle}
    ogDescription={pageDescription}
>
    <div class="page-content">
        <!-- Hero Section -->
        <section
            class="relative min-h-[500px] md:min-h-[600px] flex items-center text-white overflow-hidden"
        >
            <img
                src="/g/s3/mosaic/images/hero-bg.jpg"
                alt="Юбилей компании — организация мероприятий"
                class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-black/50"></div>

            <div
                class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full"
            >
                <div class="max-w-[800px]">
                    <nav class="text-sm text-text-light mb-4">
                        <a href="/" class="hover:text-primary">Главная</a> / <span
                            class="font-medium text-text">Юбилей компании</span
                        >
                    </nav>
                    <h1
                        class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6"
                    >
                        Организация юбилея компании в Москве
                    </h1>
                    <p class="text-lg md:text-xl text-white/90 mb-10">
                        Торжественные церемонии, дати-пати и commemorative
                        events для компаний любого масштаба.
                    </p>
                    <a
                        href="/kontakty"
                        class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg hover:shadow-xl transition-all duration-300"
                    >
                        Получить расчёт бюджета
                    </a>
                </div>
            </div>
        </section>

        <!-- Content Section -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="prose prose-lg max-w-none">
                    <h2
                        class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                    >
                        Что такое юбилей компании?
                    </h2>
                    <p class="text-lg text-text-light mb-8">
                        Юбилей компании — это значимое событие, которое
                        объединяет команду, партнёров и клиентов. TT Events
                        организует торжественные церемонии, дати-пати и
                        commemorative events любой сложности — от камерных
                        встреч на 50 человек до масштабных фестивалей на 2000+
                        гостей.
                    </p>

                    <h2
                        class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                    >
                        Форматы юбилейных мероприятий
                    </h2>
                    <div
                        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12"
                    >
                        {
                            relatedServices.map((service) => (
                                <ServiceCard {...service} />
                            ))
                        }
                    </div>

                    <h2
                        class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                    >
                        Наши кейсы
                    </h2>
                    <div
                        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12"
                    >
                        {
                            relevantCases.map((caseItem) => (
                                <CaseCard
                                    title={caseItem.title}
                                    href={caseItem.href}
                                    image={caseItem.image}
                                />
                            ))
                        }
                    </div>

                    <div class="text-center mt-12">
                        <a
                            href="/case"
                            class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-transparent border-2 border-primary text-primary hover:bg-primary hover:text-white shadow-lg hover:shadow-xl transition-all duration-300"
                        >
                            Смотреть все кейсы →
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section
            class="relative min-h-[400px] flex items-center text-white overflow-hidden py-24"
        >
            <img
                src="/g/s3/mosaic/images/hero-bg.jpg"
                alt=""
                class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-primary/80"></div>

            <div
                class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center"
            >
                <h2
                    class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-6"
                >
                    Свяжитесь с нами
                </h2>
                <p
                    class="text-lg md:text-xl text-white/90 mb-10 max-w-2xl mx-auto"
                >
                    Предложим формат и рассчитаем бюджет в течение 1 дня
                </p>
                <div
                    class="flex flex-col sm:flex-row gap-4 justify-center items-center"
                >
                    <a
                        href="tel:+79169064490"
                        class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-white hover:bg-white/90 text-primary shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                    >
                        +7 (916) 906-44-90
                    </a>
                    <a
                        href="/kontakty"
                        class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-transparent border-2 border-white hover:bg-white hover:text-primary text-white shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                    >
                        Оставить заявку
                    </a>
                </div>
            </div>
        </section>
    </div>
</Layout>
