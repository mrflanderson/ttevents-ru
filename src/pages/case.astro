        image: "/images/masl.jpg",
    },
    {
        title: "Над Москвой — Заря",
        href: "/case-nad-moskvoy-zarya",
        category: "Open Air",
        image: "/images/vrem_nad_cover.jpg",
    },
    {
        title: "Slava Skripka — Open Air 2025",
