        image: "/images/nc_jmandell_immersivetheatre_photo1.jpg",
    },
    {
        title: "Корпоратив Росатома",
        href: "/case-korolevsky-novy-god-24",
        category: "Корпоратив",
        image: "/images/rosatom.png",
    },
    {
        title: "Launch Event UMG",
        href: "/case-lauch-event-umg",
        category: "Launch",
        image: "/images/screenshot_2026-02-27_030714.png",
    },
    {
        title: "Масленица Измайлово 2025",
        href: "/case-maslenitsa-izmaylovo25case",
