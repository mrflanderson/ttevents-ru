---
import Layout from '../components/Layout.astro';

const pageTitle = 'Кейсы — Реализованные мероприятия';
const pageDescription = 'Более 2000 успешных мероприятий. Кейсы корпоративов, тимбилдингов, деловых событий.';
const keywords = 'кейсы, реализованные мероприятия, примеры работ';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Наши кейсы</h1>
            <p>Более 2000 мероприятий за 15 лет</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <h2 class="section-title">Корпоративы</h2>
            <div class="grid grid-3 mb-3">
                <div class="case-card"><h3>Новогодний корпоратив</h3><p>Ежегодные мероприятия</p></div>
                <div class="case-card"><h3>Банкет в отеле</h3><p>Шоу-программы</p></div>
                <div class="case-card"><h3>Летний корпоратив</h3><p>На открытом воздухе</p></div>
            </div>
            <h2 class="section-title">Тимбилдинги</h2>
            <div class="grid grid-3 mb-3">
                <div class="case-card"><h3>Командные квесты</h3><p>Городские квесты</p></div>
                <div class="case-card"><h3>Спортивные игры</h3><p>Соревнования</p></div>
                <div class="case-card"><h3>Интеллектуальные</h3><p>Викторины</p></div>
            </div>
            <h2 class="section-title">Деловые</h2>
            <div class="grid grid-3">
                <div class="case-card"><h3>Конференции</h3><p>Бизнес-форумы</p></div>
                <div class="case-card"><h3>Презентации</h3><p>Launch events</p></div>
                <div class="case-card"><h3>Стратегические сессии</h3><p>Воркшопы</p></div>
            </div>
        </div>
    </div>
</Layout>

<style>
.case-card { background: var(--color-white); padding: var(--space-lg); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
.case-card h3 { font-size: var(--font-size-base); margin-bottom: var(--space-sm); }
.case-card p { font-size: var(--font-size-sm); color: var(--color-secondary); }
</style>