const pageMeta = {
    title: "Кейсы — реализованные мероприятия TT Events",
    description:
        "Кейсы по организации корпоративов, тимбилдингов, конференций, фестивалей и других мероприятий в Москве.",
    ogTitle: "Кейсы TT Events",
    ogDescription:
        "Реализованные проекты: корпоративы, тимбилдинги, конференции, launch events.",
};
---

<Layout {...pageMeta}>
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Breadcrumbs -->
            <nav class="text-sm text-text-light mb-4">
                <a href="/" class="hover:text-primary">Главная</a> / <span
                    class="font-medium text-text">Кейсы</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Кейсы
            </h1>
            <p class="text-lg text-text-light max-w-3xl">
                Более 40 успешных проектов по организации корпоративных
                мероприятий, тимбилдингов, конференций и фестивалей в Москве.
            </p>
        </div>
    </section>

    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    cases.map((caseItem) => (
                        <article class="bg-white rounded-xl shadow-card hover:-translate-y-1 transition-all duration-300 overflow-hidden">
                            <a
                                href={caseItem.href}
                                class="block text-inherit no-underline"
                            >
                                <div class="relative h-48 overflow-hidden">
                                    <img
                                        src={caseItem.image}
                                        alt={caseItem.title}
                                        width="400"
                                        height="300"
                                        sizes="(max-width: 768px) 100vw, 33vw"
                                        loading="lazy"
                                        class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                                    />
                                    <span class="absolute top-4 left-4 bg-primary text-white text-xs font-semibold px-3 py-1 rounded">
                                        {caseItem.category}
                                    </span>
                                </div>
                                <div class="p-6">
                                    <h3 class="text-lg font-heading font-semibold">
                                        {caseItem.title}
                                    </h3>
                                </div>
                            </a>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
