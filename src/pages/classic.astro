---
import Layout from "../components/Layout.astro";

const pageMeta = {
    title: "TT Events — Классический корпоратив | Банкет с шоу-программой в Москве",
    description:
        "Классический корпоратив в Москве: изысканный банкет, профессиональный ведущий, живая музыка, артисты. С 2006 года. Стоимость от 800 тыс. ₽",
    keywords:
        "классический корпоратив, банкет с шоу-программой, корпоратив в Москве, новогодний корпоратив, юбилей компании",
    ogTitle: "TT Events — Классический корпоратив в Москве",
    ogDescription:
        "Классический корпоратив под ключ: банкет, ведущий, живая музыка, артисты. С 2006 года.",
    ogImage: "/g/s3/mosaic/images/og-classic.jpg",
};

// Features data
const features = [
    {
        title: "Шоу-программа для корпоратива",
        description:
            "Мы разрабатываем индивидуальную программу под ваш коллектив.",
        subtitle: "Ведущий на корпоратив в Москве",
        subtitleDetail:
            "Харизматичный конферансье с опытом работы с крупными компаниями.",
    },
    {
        title: "Живая музыка",
        items: [
            "джаз-бэнд",
            "струнный квартет",
            "саксофонист",
            "кавер-группа",
            "вокалисты",
        ],
    },
    {
        title: "Артисты на корпоратив",
        items: [
            "театральные актёры",
            "балет",
            "цирковые номера",
            "световые и лазерные шоу",
        ],
    },
    {
        title: "Техническое обеспечение корпоратива",
        items: [
            "профессиональный звук",
            "сценическое освещение",
            "LED-экраны",
            "сцена",
            "спецэффекты",
        ],
        note: "Собственное оборудование позволяет нам контролировать качество и оптимизировать бюджет.",
    },
];

// Cases data
const cases = [
    {
        title: "Новогодний корпоратив для IT-компании (150 гостей)",
        description:
            "Ресторан в центре Москвы, welcome-зона с джаз-бэндом, режиссированный сценарий, кавер-группа, брендированное световое шоу.",
        image: "/g/s3/mosaic/images/case-newyear.jpg",
    },
    {
        title: "Юбилей компании (200 гостей)",
        description:
            "Банкет в премиальном зале, струнный квартет, театральная миниатюра об истории бренда, финальный музыкальный сет.",
        image: "/g/s3/mosaic/images/case-anniversary.jpg",
    },
    {
        title: "Гала-ужин для федеральной корпорации",
        description:
            "Живой звук, актёрские сценки, элегантный декор, точный тайминг подачи блюд.",
        image: "/g/s3/mosaic/images/case-gala.jpg",
    },
];

// Steps data
const steps = [
    {
        number: "1",
        title: "Ваш звонок или заявка",
        description:
            "Оставьте заявку, вам перезвонит менеджер, узнает ваши желания, даст рекомендации",
    },
    {
        number: "2",
        title: "Брифинг и формирование концепции",
        description:
            "Обсуждаем цели, масштаб, аудиторию, пожелания и ограничения",
    },
    {
        number: "3",
        title: "Расчёт бюджета и сметы",
        description:
            "Готовим прозрачную смету с несколькими вариантами под ваш бюджет — фиксируем все позиции без скрытых доплат.",
    },
    {
        number: "4",
        title: "Разработка сценария",
        description:
            "Пишем детальный тайминг, программу, конкурсы, ведущего, сюрпризы и эмоциональные акценты мероприятия.",
    },
    {
        number: "5",
        title: "Подготовка подрядчиков",
        description:
            "Подбираем и бронируем проверенных артистов, техников, декораторов, кейтеринг, фотографов и других специалистов.",
    },
    {
        number: "6",
        title: "Реализация мероприятия",
        description:
            "Всё, что спланировали — воплощается: от монтажа сцены утром до финального салюта / афтерпати.",
    },
    {
        number: "7",
        title: "Контроль и сопровождение на площадке",
        description:
            "Наш менеджер / координатор присутствует весь день, решает вопросы в реальном времени, чтобы всё прошло гладко.",
    },
];

// FAQ data
const faqItems = [
    {
        question: "Вы посредники или сами проводите?",
        answer: "Мы сами проводим: своя техническая база, штатные артисты и режиссёры. Экономьте до 40% без наценок агентств.",
    },
    {
        question:
            "Сколько стоит классический корпоратив на 100 человек в Москве?",
        answer: `
            <p>В 2026 году средняя стоимость классического банкета + шоу-программы (ресторан/банкетный зал в центре или Подмосковье, ведущий, живая музыка, артисты, звук/свет) — <strong>от 800 000 до 2 000 000 ₽</strong> за всё мероприятие (или примерно <strong>8 000–20 000 ₽ на человека</strong>).</p>
            <ul class="list-disc pl-5 space-y-1 mt-2">
                <li>Бюджетный вариант (ресторан среднего уровня, кавер-группа, простой ведущий): <strong>от 700–900 тыс. ₽</strong> всего.</li>
                <li>Средний/премиум (статусный зал, джаз/струнный квартет + театральные номера, собственная техника): <strong>1,2–1,8 млн ₽</strong>.</li>
                <li>VIP (отель, лазерное шоу, брендированный продакшн): <strong>от 2 млн ₽ и выше</strong>.</li>
            </ul>
            <p class="mt-2">В TT Event мы готовим индивидуальную смету без скрытых доплат — после брифа покажем 2–3 варианта под ваш бюджет. Цена зависит от даты (Новый год дороже на 30–50%), меню, артистов и техобеспечения.</p>
        `,
    },
    {
        question: "Как проходит подготовка классического корпоратива?",
        answer: `
            <p>Подготовка занимает обычно <strong>1,5–4 месяца</strong> (для новогодних — бронировать лучше за 6–9 месяцев).</p>
            <ol class="list-decimal pl-5 space-y-2 mt-2">
                <li><strong>Заявка и бриф</strong> (1–2 дня): звонок/форма → менеджер уточняет цели, количество гостей, бюджет, пожелания.</li>
                <li><strong>Концепция и варианты</strong> (2–5 дней): предлагаем 2–3 площадки, примеры шоу-программы, черновик сценария.</li>
                <li><strong>Смета и договор</strong> (1–3 дня): прозрачный расчёт по позициям. Фиксируем цену.</li>
                <li><strong>Детальная проработка</strong> (2–6 недель): тайминг, подбор ведущего/музыкантов/артистов, декор, брендирование.</li>
                <li><strong>Подготовка на площадке</strong> (за 1–2 недели): монтаж сцены, свет/звук, репетиция с ведущим.</li>
                <li><strong>День мероприятия</strong>: координатор на месте весь день.</li>
                <li><strong>После</strong>: отчёт, фото/видео, обратная связь от гостей.</li>
            </ol>
            <p class="mt-2">Мы сопровождаем на всех этапах — вы получаете только ключевые решения, остальное берём на себя.</p>
        `,
    },
    {
        question:
            "Можно ли уложиться в бюджет 500 000 ₽ на корпоратив на 100 человек?",
        answer: `
            <p><strong>Сложно, но возможно</strong> — в классическом формате (с живой музыкой, профессиональным ведущим, хорошим банкетом и техникой) это будет очень эконом-вариант или компромисс по уровню.</p>
            <ul class="list-disc pl-5 space-y-1 mt-2">
                <li>Реалистично на 500 тыс. ₽: простой ресторан без аренды зала отдельно, фуршет/банкет от 4–5 тыс. ₽/чел., диджей вместо живой группы.</li>
                <li>Для полного классического формата (джаз/струнный квартет, театр, световое шоу) бюджет обычно стартует от 800–900 тыс. ₽.</li>
            </ul>
            <p class="mt-2">Если бюджет жёстко ограничен 500 тыс. ₽ — лучше рассмотреть:</p>
            <ul class="list-disc pl-5 space-y-1 mt-2">
                <li>Меньше гостей (70–80 человек).</li>
                <li>Выезд за МКАД (Подмосковье дешевле).</li>
                <li>Фуршет вместо полного банкета.</li>
                <li>Свою технику или минимум артистов.</li>
            </ul>
        `,
    },
];

// Stats data
const stats = [
    {
        number: "20 лет",
        label: "успешной практики",
        detail: "С 2006 года — ни одного сорванного корпоратива, даже в кризисы",
    },
    {
        number: "5000+",
        label: "проведённых мероприятий",
        detail: "От камерных гала-ужинов до новогодних праздников на 500+ гостей — все под ключ и с восторженными отзывами.",
    },
    {
        number: "90%",
        label: "клиентов возвращаются снова",
        detail: "HR и топ-менеджеры крупных компаний выбирают нас год за годом — доверие, проверенное временем",
    },
    {
        number: "100%",
        label: "контроль качества на площадке",
        detail: "Собственная техническая база, продюсерский ресурс и «Театр Традиций» — мы не посредники, всё делаем сами.",
    },
];
---

<Layout {...pageMeta}>
    <!-- Breadcrumbs + Title -->
    <section class="py-8 md:py-12 bg-gradient-to-r from-[#f8f9fa] to-[#e9ecef]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-5">
                <a href="/" class="hover:text-primary">Главная</a>
                <span class="mx-2">/</span>
                <a href="/korporativy-moskva" class="hover:text-primary"
                    >Корпоративные мероприятия</a
                >
                <span class="mx-2">/</span>
                <span class="font-medium text-text">Банкет/шоу-программа</span>
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading"
            >
                Банкет с шоу-программой
            </h1>
        </div>
    </section>

    <!-- Hero Section -->
    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div class="order-2 lg:order-1">
                    <p class="text-lg text-text-light leading-relaxed mb-6">
                        Концептуальный корпоратив в Москве — это не банкет «как
                        у всех», а событие с идеей, сценографией и драматургией.
                        TT Events создаёт арт-вечеринки, иммерсивные шоу и
                        тематические корпоративы под ключ — от разработки
                        концепции до мультимедийного продакшна.
                    </p>
                    <p class="text-lg text-text-light leading-relaxed">
                        С 2006 года мы реализуем нестандартные корпоративные
                        мероприятия: иммерсивные форматы, вечеринки в стиле 90-х
                        и MTV 2000-х, арт-корпоративы и события в современном
                        русском культурном коде.
                    </p>
                </div>
                <div class="order-1 lg:order-2">
                    <img
                        src="/g/s3/mosaic/images/corp-tort.jpg"
                        alt="Организация классического корпоратива в Москве под ключ"
                        width="1280"
                        height="853"
                        loading="lazy"
                        class="rounded-2xl shadow-lg w-full object-cover"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Full Control Section -->
    <section class="py-16 md:py-24 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-4xl mx-auto">
                <h2
                    class="text-2xl md:text-3xl font-heading font-bold text-dark mb-8"
                >
                    Мы проводим корпоративы полностью под своим контролем: от
                    подбора площадки и разработки сценария до режиссуры,
                    постановки и сопровождения на мероприятии.
                </h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mt-12">
                <img
                    src="/g/s3/mosaic/images/pexels-pavel-danilyuk-6405771.jpg"
                    alt="Организация корпоративного мероприятия"
                    width="600"
                    height="400"
                    loading="lazy"
                    class="rounded-xl shadow-md w-full h-64 object-cover"
                />
                <img
                    src="/g/s3/mosaic/images/manager-event.jpg"
                    alt="Координация корпоратива"
                    width="600"
                    height="400"
                    loading="lazy"
                    class="rounded-xl shadow-md w-full h-64 object-cover"
                />
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section
        class="py-12 md:py-16 bg-gradient-to-r from-primary to-primary-dark"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <a
                href="#contact-form"
                class="inline-block bg-white text-primary font-semibold px-8 py-4 rounded-lg hover:bg-gray-100 transition-colors text-lg"
            >
                Оставьте контакты, и продюсер свяжется с вами в течение дня.
            </a>
        </div>
    </section>

    <!-- What is classic corporate -->
    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                    <h2
