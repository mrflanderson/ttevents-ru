---
import Layout from '../components/Layout.astro';

const pageTitle = 'Банкет и шоу-программа';
const pageDescription = 'Банкет с развлекательной программой в Москве. Классический формат корпоратива с живой музыкой, шоу и банкетом.';
const keywords = 'банкет, шоу-программа, корпоратив, живая музыка, развлекательная программа';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Банкет / Шоу-программа</h1>
            <p>Классический формат с развлекательной программой</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <p>Банкет с шоу-программой — классический формат корпоративного мероприятия. Включает:</p>
            <ul class="feature-list mt-2">
                <li>Банкет с полноценным меню</li>
                <li>Живая музыка или DJ</li>
                <li>Развлекательная программа</li>
                <li>Ведущий/тамада</li>
                <li>Торт (по желанию)</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Заказать банкет</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.feature-list li { margin-bottom: var(--space-sm); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>