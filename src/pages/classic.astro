    <!-- Difference section -->
    <section class="py-16 md:py-24 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-4xl mx-auto text-center">
                <h2
                    class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                >
                    Чем <a
                        href="/art-concept"
                        class="text-primary hover:underline"
                        >концептуальный корпоратив</a
                    > отличается от <a
                        href="/classic"
                        class="text-primary hover:underline"
                        >классического банкета</a
                    >
                </h2>
                <p class="text-lg text-text-light leading-relaxed">
                    В отличие от банкетного формата с шоу-программой,
                    концептуальный корпоратив строится вокруг идеи и сценарной
                    драматургии. Здесь важна атмосфера, сценография и единый
                    визуальный стиль — от приглашений до финального перформанса.
                </p>
            </div>
        </div>
    </section>

    <!-- Optimal format -->
    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
