---
import Layout from "../components/Layout.astro";
import FAQSection from "../components/sections/FAQSection.astro";

const pageMeta = {
    title: "Банкет и шоу-программа в Москве — классический формат | TT Events",
    description:
        "Классический формат корпоративных мероприятий: элегантные банкеты, шоу-программы и торжественные приемы. Организация банкетов в Москве и Подмосковье с 2006 года.",
    ogTitle:
        "Банкет и шоу-программа в Москве — классический формат | TT Events",
    ogDescription:
        "Элегантные банкеты, шоу-программы и торжественные приемы. Организация мероприятий в лучших ресторанах Москвы.",
};

const services = [
    {
        title: "Классический банкет",
        href: "/classic",
    },
    {
        title: "Шоу-программа",
        href: "/classic",
    },
    {
        title: "Торжественный прием",
        href: "/classic",
    },
    {
        title: "Гала-ужин",
        href: "/classic",
    },
];

const faqItems = [
    {
        question: "Что включает классический банкет?",
        answer: "Организация питания, декорирование зала, подбор меню, обслуживание официантами, шоу-программа и развлекательные элементы.",
    },
    {
        question: "Какая вместимость зала?",
        answer: "От 50 до 1000+ человек. Работаем с ресторанами и банкетными залами в Москве и Подмосковье.",
    },
    {
        question: "Сколько стоит организация банкета?",
        answer: "Стоимость зависит от формата и количества гостей. Минимальный бюджет — от 900 000 ₽ для камерных мероприятий.",
    },
];
---

<!--
  TT Events — Tailwind CSS Migration
  Generated on: 2026-05-17
-->
<Layout {...pageMeta}>
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4" aria-label="Навигация">
                <a href="/" class="hover:text-primary">Главная</a> / <span
                    class="font-medium text-text"
                    aria-current="page">Банкет</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Банкет и шоу-программа в Москве
            </h1>
            <p class="text-lg text-text-light max-w-3xl mb-12">
                Классический формат корпоративных мероприятий: элегантные
                банкеты, шоу-программы и торжественные приемы. Организация
                банкетов в Москве и Подмосковье с 2006 года.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    services.map((service) => (
                        <a
                            href={service.href}
                            class="block p-6 bg-white rounded-xl shadow-card hover:shadow-card-hover transition-all duration-300"
                            aria-label={service.title}
                        >
                            <h3 class="text-xl font-heading font-semibold text-dark hover:text-primary transition-colors">
                                {service.title}
                            </h3>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <FAQSection items={faqItems} />
</Layout>
