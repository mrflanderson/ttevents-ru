---
import Layout from "../components/Layout.astro";
import Hero from "../components/Hero.astro";
import CaseCard from "../components/CaseCard.astro";
import VideoEmbed from "../components/VideoEmbed.astro";
import FAQSection from "../components/sections/FAQSection.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import CTASection from "../components/sections/CTASection.astro";

// SEO
const pageTitle =
  "TT Events — корпоративные мероприятия, MICE, фестивали и продакшн";
const pageDescription =
  "TT Events — организация корпоративных мероприятий, MICE, фестивалей и медиа-продакшна в Москве и по России. Event + media + production под ключ.";
const keywords =
  "TT Events, корпоратив, мероприятия, MICE, тимбилдинг, фестиваль, event-агентство, продакшн, live";

// Core cases (from your existing /case pages)
const topCases = [
  {
    title: "Art-pop для «Метриум» — Новый год 2026",
    href: "/case/artpop",
    image: "/images/12_12_artpop_1m_blondmp4_20260217_040321853_2.jpg",
  },
  {
    title: "Ретро-фестиваль «Время надежд» — Звенигород 2025",
    href: "/case/vremnadezhdfest2025",
    image: "/images/vrem_nad_cover.jpg",
  },
  {
    title: "Open-air в Гребнево — SLAVA SKRIPKA",
    href: "/case/open-air-slava-skripka-bober-2025",
    image: "/images/bobr.jpg",
  },
];

// Metrics (concrete, no fluff)
const metrics = [
  { value: "15+", label: "лет на рынке" },
  { value: "2 000+", label: "проектов" },
  { value: "50 000+", label: "гостей" },
  { value: "100+", label: "корпоративных клиентов" },
];

// 4 ecosystem pillars (what we do)
const pillars = [
  {
    title: "Корпоративные мероприятия",
    desc: "Концепции, сценарии и продакшн под задачи бизнеса.",
    href: "/services/corporate-events",
  },
  {
    title: "MICE и деловые события",
    desc: "Конференции, форумы, презентации и B2B-мероприятия.",
    href: "/services/mice-business",
  },
  {
    title: "Тимбилдинг",
    desc: "Иммерсивные и активные форматы для команд.",
    href: "/services/team-building",
  },
  {
    title: "Фестивали и городские события",
    desc: "Open-air, городские фестивали и публичные пространства.",
    href: "/services/festivals",
  },
];

// Partners: using existing images from /public/images/
const partners = [
  { name: "Сбер", src: "/images/logo_sber.jpg" },
  { name: "Газпром", src: "/images/logo_gazprom.png" },
  { name: "РЖД", src: "/images/rzhd.jpg" },
  { name: "ВДНХ", src: "/images/vdnh.png" },
  { name: "Росатом", src: "/images/rosatom.png" },
  { name: "Лукойл", src: "/images/logo_lukoil.webp" },
  { name: "Почта России", src: "/images/logo_russian_postsvg.png" },
  { name: "АОП Т", src: "/images/logo_aop_t.webp" },
  { name: "Коломенское", src: "/images/logo_kolomenskoe.jpg" },
  { name: "Измайлово", src: "/images/logo_imzylovo.jpg" },
  { name: "Плюс", src: "/images/logo_plus.png" },
  { name: "Гостиный двор", src: "/images/gostinyj-dvor-logo.png" },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={keywords}
  ogTitle={pageTitle}
  ogDescription={pageDescription}
  canonicalURL="/"
>
  <div class="min-h-screen bg-white w-full overflow-x-hidden">

    <Hero
      title="События, которые работают на&nbsp;бизнес"
      subtitle="TT Events — корпоративы, MICE, фестивали и продакшн. От концепции до трансляции и контента."
      ctaText="Обсудить проект"
      ctaHref="https://t.me/ttevents"
      ctaSecondaryText="Смотреть кейсы"
      ctaSecondaryHref="/case"
      videoSrc="/video/hero_new2.mp4"
      poster="/video/hero_new2.png"
    />

    <!-- METRICS + CLIENTS (social proof) -->
    <section class="py-12 md:py-16 bg-gray-50 border-y border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Metrics row */}
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 lg:gap-8 mb-12">
          <div>
            <p class="text-sm text-gray-500">TT Events</p>
            <h2 class="mt-1 text-xl md:text-2xl lg:text-3xl font-heading font-bold text-gray-900 leading-tight">
              Партнёр для сложных проектов
            </h2>
          </div>
          {/* Grid-based metrics — 2 cols mobile, 4 cols desktop */}
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
            {metrics.map((m) => (
              <div class="text-center lg:text-left">
                <span class="block text-xl sm:text-2xl md:text-3xl font-bold text-gray-900 leading-none">
                  {m.value}
                </span>
                <span class="mt-1 block text-xs sm:text-sm text-gray-500">
                  {m.label}
                </span>
              </div>
            ))}
          </div>
        </div>

        {/* Clients strip */}
        <div class="border-t border-gray-200 pt-8">
          <p class="text-xs sm:text-sm text-gray-400 mb-4 text-center lg:text-left">
            Нам доверяют лидеры рынка и государственные структуры
          </p>
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-4 sm:gap-6 lg:gap-8">
            {partners.map((p) => (
              <div class="flex-shrink-0 w-[100px] sm:w-[120px]">
                <img
                  src={p.src}
                  alt={`Партнёр ${p.name}`}
                  class="h-7 sm:h-8 lg:h-10 w-auto max-w-[120px] opacity-60 hover:opacity-100 transition-opacity duration-200 grayscale-[30%] hover:grayscale-0"
                  loading="lazy"
                  width="120"
                  height="32"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 4 DIRECTION HUBS (WHAT WE DO) -->
    <section id="directions" class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-10">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-3">
            Направления
          </h2>
          <p class="text-lg text-gray-500 max-w-2xl">
            TT Events создаёт экосистему: от корпоративных событий до фестивалей и&nbsp;деловых форматов.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 overflow-hidden">
          {pillars.map((p) => (
            <a
              href={p.href}
              class="group block rounded-xl border border-gray-100 p-6 bg-white hover:shadow-soft transition-all duration-300"
            >
              <h3 class="text-lg font-semibold text-gray-900 mb-2">
                {p.title}
              </h3>
              <p class="text-sm text-gray-500 mb-4">{p.desc}</p>
              <span class="inline-flex items-center text-sm text-primary font-medium group-hover:underline">
                Подробнее →
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- FEATURED CASES -->
    <section id="cases" class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-end justify-between mb-10">
          <div>
            <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-3">
              Ключевые проекты
            </h2>
            <p class="text-lg text-gray-500 max-w-xl">
              Масштабные события, которые работают на имидж и бизнес. Показываем отобранное.
            </p>
          </div>
          <a
            href="/case"
            class="hidden sm:inline-flex items-center text-sm text-primary font-medium hover:underline"
          >
            Все кейсы →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 overflow-hidden">
          {topCases.map((c) => (
            <CaseCard
              title={c.title}
              href={c.href}
              image={c.image}
            />
          ))}
        </div>
      </div>
    </section>

    <!-- EVENT + MEDIA (cinematic) -->
    <section id="media" class="relative py-24 text-white overflow-hidden">
      {/* Cinematic background */}
      <div
        class="absolute inset-0 bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950"
      ></div>
      <div class="absolute inset-0 opacity-[0.06] bg-[radial-gradient(#ffffff_1px,transparent_1px)] bg-[size:26px_26px]"></div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center overflow-hidden">
        <div>
          <p class="text-xs tracking-widest text-gray-400 mb-3">
            EVENT + MEDIA
          </p>
          <h2 class="text-3xl md:text-4xl font-heading font-bold mb-4">
            Событие не заканчивается площадкой
          </h2>
          <p class="text-lg text-gray-200 mb-6 max-w-xl">
            TT Events — event + media в одном продакшне. Мы создаём контент и атмосферу, которые живут после мероприятия.
          </p>
          <ul class="mb-8 space-y-2 text-gray-200">
            <li>• Авторская режиссура</li>
            <li>• Видеостил и live-трансляции</li>
            <li>• Backstage и контент-стратегия</li>
            <li>• SDE / second screen / интерактив</li>
          </ul>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href="/media"
              class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg hover:shadow-xl transition-all duration-300"
            >
              Смотреть media
            </a>
            <a
              href="/kontakty"
              class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg font-semibold border-2 border-white/20 hover:bg-white/10 text-white transition-all duration-300"
            >
              Обсудить задачу
            </a>
          </div>
        </div>

        {/* Cinematic media strip */}
        <div class="flex flex-col gap-4">
          <div class="rounded-xl overflow-hidden bg-black/40 border border-white/10">
            <VideoEmbed rutubeId="e8a81853494652009fc0f58c40bea73b" />
          </div>
          <p class="text-xs text-gray-400">
            Посмотрите, как мы создаём мероприятия — от идеи до реализации.
          </p>
        </div>
      </div>
    </section>

    <!-- WHY US (concrete, no fluff) -->
    <section class="py-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-10">
          <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900 mb-3">
            Почему выбирают TT Events
          </h2>
          <p class="text-lg text-gray-500 max-w-2xl">
            Без воды. По делу. Вот что нас отличает.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 overflow-hidden">
          <div class="flex flex-col">
            <div class="text-primary text-3xl font-bold mb-2">01</div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              Собственный продакшн и режиссура
            </h3>
            <p class="text-sm text-gray-500">
              Сценарии, видео, постановка, техническая реализация и контент-команда — в&nbsp;одном pipeline.
            </p>
          </div>

          <div class="flex flex-col">
            <div class="text-primary text-3xl font-bold mb-2">02</div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              Проекты федерального уровня
            </h3>
            <p class="text-sm text-gray-500">
              Фестивали, государственные события, корпоративы и open-air по всей России.
            </p>
          </div>

          <div class="flex flex-col">
            <div class="text-primary text-3xl font-bold mb-2">03</div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              End-to-end от концепции до отчёта
            </h3>
            <p class="text-sm text-gray-500">
              Единое окно связи, прозрачный бюджет, чёткие сроки и KPI.
            </p>
          </div>

          <div class="flex flex-col">
            <div class="text-primary text-3xl font-bold mb-2">04</div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">
              Контент, который живёт после мероприятия
            </h3>
            <p class="text-sm text-gray-500">
              Фото-, видео-, media-стратегия и интеграции в коммуникации клиента.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <ProcessSteps
      id="process"
      title="Как мы работаем"
      subtitle="От задачи до реализации. Без лишних шагов."
      steps={[{
        label: "Бриф",
        description: "1–2 рабочих встречи, чек-листы и KPI.",
      }, {
        label: "Концепция и сценарий",
        description: "Визуальная стратегия, moodboard, структура формата.",
      }, {
        label: "Продакшн и техника",
        description: "Свет, звук, сценография, медиа, режиссура.",
      }, {
        label: "Реализация",
        description: "Полная координация и управление на площадке.",
      }, {
        label: "Контент и отчёт",
        description: "Медиа, highlights, отчётность, архив проекта.",
      }]}
    />


    <!-- FAQ -->
    <FAQSection
      title="Часто задаваемые вопросы"
      items={[{
        question: "Сколько стоит корпоратив в Москве в 2026?",
        answer: "Средний чек под ключ — от 15–22 тыс. ₽ на человека. 50 гостей ≈ 850–1,4 млн ₽, 100 гостей ≈ 1,4–2,8 млн ₽, 200+ ≈ 2,3–7+ млн ₽. Точную цифру даём после брифа за 1 день.",
      }, {
        question: "За сколько реально организовать новогодний корпоратив?",
        answer: "Идеально — за 4–6 месяцев. Реально — от 45 дней (есть проверенные локации и свой штат).",
      }, {
        question: "Работаете только в Москве или по всей России?",
        answer: "По всей России и СНГ. Основная команда в Москве, логистику и подрядчиков выстраиваем за 2–3 недели.",
      }]} />


    <!-- FINAL CTA -->
    <section id="cta" class="relative py-24 text-white overflow-hidden bg-gradient-to-b from-slate-900 via-slate-800 to-slate-900">
      <div class="absolute inset-0 opacity-[0.04] bg-[radial-gradient(#ffffff_1px,transparent_1px)] bg-[size:24px_24px]"></div>
      <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block px-4 py-1.5 mb-6 rounded-full bg-primary/20 border border-primary/30 text-sm font-medium text-white">
          Более 2000 проектов
        </span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-4">
          Готовы обсудить ваш проект
        </h2>
        <p class="text-lg text-gray-300 mb-10 max-w-2xl mx-auto">
          Расскажите задачу — предложим 3 формата и рассчитаем бюджет в течение 1 дня.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
          <a
            href="tel:+79169064490"
            class="w-full sm:w-auto group inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg shadow-primary/25 hover:shadow-xl transition-all duration-300 min-h-[48px]"
          >
            Обсудить проект
          </a>
          <a
            href="/kontakty"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl font-semibold bg-white/10 border-2 border-white/20 hover:bg-white hover:text-primary text-white backdrop-blur-sm shadow-lg transition-all duration-300"
          >
            Оставить заявку
          </a>
        </div>

        <p class="mt-6 text-gray-400 text-sm">
          Или напишите нам на
          <a
            href="mailto:mail@ttevents.ru"
            class="text-primary hover:text-white transition-colors duration-200 underline font-medium"
          >
            mail@ttevents.ru
          </a>
        </p>
      </div>
    </section>

  </div>
</Layout>
