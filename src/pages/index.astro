---
import Layout from "../components/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CaseCard from "../components/CaseCard.astro";

const pageTitle =
    "TT Events — event-агентство полного цикла в Москве с 2006 года";
const pageDescription =
    "Организация корпоративных мероприятий, тимбилдингов, деловых форумов, фестивалей и launch events в Москве. Более 2000 проектов. Свой театр, видеопродакшн, сценарии под бизнес-задачи.";
const keywords =
    "организация корпоративных мероприятий, event агентство москва, tt events, тимбилдинг для компаний, проведение деловых событий, корпоратив в москве";

const services = [
    {
        title: "Корпоративные мероприятия",
        href: "/korporativy-moskva",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
        count: 450,
    },
    {
        title: "Тимбилдинги",
        href: "/timbilding-moskva",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
        count: 380,
    },
    {
        title: "Новогодние корпоративы",
        href: "/novogodniy-korporativ",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
        count: 520,
    },
    {
        title: "Деловые мероприятия",
        href: "/delovye-meropriyatiya",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
        count: 290,
    },
    {
        title: "Launch Events",
        href: "/prezentacii-novyh-produktov-launch-events",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
        count: 180,
    },
    {
        title: "Фестивали",
        href: "/festivaly-i-gorodskie-meropriyatiya",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
        count: 150,
    },
];

const topCases = [
    {
        title: "Art-pop для «Метриум» — Новый год 2026",
        href: "/case/artpop",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
    },
    {
        title: "Ретро-фестиваль «Время надежд» — Звенигород 2025",
        href: "/case/vremnadezhdfest2025",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
    },
    {
        title: "Open-air в Гребнево — SLAVA SKRIPKA",
        href: "/case/open-air-slava-skripka-bober-2025",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    ogTitle={pageTitle}
    ogDescription={pageDescription}
>
    <div class="page-content">
        <!-- Hero Section -->
        <section
            class="relative min-h-[600px] md:min-h-[700px] flex items-center text-white overflow-hidden"
        >
            <img
                src="/g/s3/mosaic/images/hero-bg.jpg"
                alt="TT Events — организация мероприятий"
                class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-black/50"></div>

            <div
                class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full"
            >
                <div class="max-w-[800px]">
                    <h1
                        class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6"
                    >
                        Организация корпоративных мероприятий в Москве
                    </h1>
                    <p class="text-lg md:text-xl text-white/90 mb-10">
                        Event-агентство полного цикла с 2006 года. Более 2000
                        проектов: корпоративы, тимбилдинги, launch events,
                        фестивали.
                    </p>
                    <a
                        href="/kontakty"
                        class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg hover:shadow-xl transition-all duration-300"
                    >
                        Получить расчёт бюджета
                    </a>
                </div>
            </div>
        </section>

        <!-- Services Section -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4"
                    >
                        Форматы мероприятий
                    </h2>
                    <p class="text-lg text-text-light max-w-2xl mx-auto">
                        TT Events организует события любого масштаба — от
                        камерных VIP-встреч на 50 человек до городских
                        фестивалей на 2000+ гостей.
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8"
                >
                    {services.map((service) => <ServiceCard {...service} />)}
                </div>

                <div class="text-center mt-12">
                    <a
                        href="/korporativy-moskva"
                        class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-transparent border-2 border-primary text-primary hover:bg-primary hover:text-white shadow-lg hover:shadow-xl transition-all duration-300"
                    >
                        Смотреть все услуги →
                    </a>
                </div>
            </div>
        </section>

        <!-- Why Us Section -->
        <section class="py-16 md:py-24 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4"
                    >
                        Почему мы
                    </h2>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
                >
                    <div
                        class="bg-white rounded-xl p-8 shadow-card hover:shadow-card-hover transition-all duration-300"
                    >
                        <div class="text-primary text-4xl font-bold mb-4">
                            01
                        </div>
                        <h3 class="text-xl font-heading font-semibold mb-2">
                            15 лет успеха
                        </h3>
                        <p class="text-text-light">
                            С 2006 года мы провели более 2000 мероприятий. Это
                            безупречная репутация и опыт, который невозможно
                            купить.
                        </p>
                    </div>

                    <div
                        class="bg-white rounded-xl p-8 shadow-card hover:shadow-card-hover transition-all duration-300"
                    >
                        <div class="text-primary text-4xl font-bold mb-4">
                            02
                        </div>
                        <h3 class="text-xl font-heading font-semibold mb-2">
                            Свой ресурс
                        </h3>
                        <p class="text-text-light">
                            Наш «Театр Традиций» — это эксклюзивный контент. Мы
                            работали на Олимпиадах в Сочи и Ванкувере.
                        </p>
                    </div>

                    <div
                        class="bg-white rounded-xl p-8 shadow-card hover:shadow-card-hover transition-all duration-300"
                    >
                        <div class="text-primary text-4xl font-bold mb-4">
                            03
                        </div>
                        <h3 class="text-xl font-heading font-semibold mb-2">
                            Без границ
                        </h3>
                        <p class="text-text-light">
                            Мы создаем атмосферу, которая ломает шаблоны.
                            События, которые усиливают команду изнутри.
                        </p>
                    </div>

                    <div
                        class="bg-white rounded-xl p-8 shadow-card hover:shadow-card-hover transition-all duration-300"
                    >
                        <div class="text-primary text-4xl font-bold mb-4">
                            04
                        </div>
                        <h3 class="text-xl font-heading font-semibold mb-2">
                            Масштабные идеи
                        </h3>
                        <p class="text-text-light">
                            Мы превращаем обычные события в грандиозные шоу.
                            Инновации и внимание к деталям в каждом мгновении.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Cases Section -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4"
                    >
                        Наши кейсы
                    </h2>
                    <p class="text-lg text-text-light max-w-2xl mx-auto">
                        Реализованные проекты для крупных холдингов и компаний.
                    </p>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
                >
                    {
                        topCases.map((caseItem) => (
                            <CaseCard
                                title={caseItem.title}
                                href={caseItem.href}
                                image={caseItem.image}
                            />
                        ))
                    }
                </div>

                <div class="text-center mt-12">
                    <a
                        href="/case"
                        class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-transparent border-2 border-primary text-primary hover:bg-primary hover:text-white shadow-lg hover:shadow-xl transition-all duration-300"
                    >
                        Смотреть все кейсы →
                    </a>
                </div>
            </div>
        </section>

        <!-- Process Section -->
        <section class="py-16 md:py-24 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4"
                    >
                        Как мы работаем
                    </h2>
                </div>

                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8"
                >
                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            01
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Концепция
                        </h3>
                        <p class="text-text-light text-sm">
                            Анализ задач бренда, аудитории и формата. Создание
                            сценария и визуальной стратегии.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            02
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Площадка
                        </h3>
                        <p class="text-text-light text-sm">
                            Лофты, арт-галереи, концертные пространства,
                            нестандартные площадки в Москве.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            03
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Техника
                        </h3>
                        <p class="text-text-light text-sm">
                            Профессиональный свет, звук, LED-экраны,
                            спецэффекты.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            04
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Декор
                        </h3>
                        <p class="text-text-light text-sm">
                            Кастомные фотозоны, арт-инсталляции, брендированные
                            зоны.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            05
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Продакшн
                        </h3>
                        <p class="text-text-light text-sm">
                            Персональный менеджер проекта + контроль всех
                            процессов.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Pricing Section -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4"
                    >
                        Бюджет события
                    </h2>
                    <p class="text-lg text-text-light max-w-2xl mx-auto">
                        Ориентировочная стоимость «под ключ» в сезоне 2026:
                    </p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div
                        class="bg-white rounded-xl p-8 shadow-card hover:shadow-card-hover transition-all duration-300 text-center"
                    >
                        <div class="text-primary text-4xl font-bold mb-2">
                            50
                        </div>
                        <div class="text-text-light text-sm mb-4">гостей</div>
                        <div class="text-dark text-2xl font-bold mb-6">
                            от 900 000 ₽
                        </div>
                    </div>

                    <div
                        class="bg-white rounded-xl p-8 shadow-card hover:shadow-card-hover transition-all duration-300 text-center"
                    >
                        <div class="text-primary text-4xl font-bold mb-2">
                            100
                        </div>
                        <div class="text-text-light text-sm mb-4">гостей</div>
                        <div class="text-dark text-2xl font-bold mb-6">
                            от 1,5 млн ₽
                        </div>
                    </div>

                    <div
                        class="bg-white rounded-xl p-8 shadow-card hover:shadow-card-hover transition-all duration-300 text-center"
                    >
                        <div class="text-primary text-4xl font-bold mb-2">
                            200+
                        </div>
                        <div class="text-text-light text-sm mb-4">гостей</div>
                        <div class="text-dark text-2xl font-bold mb-6">
                            от 2,5 млн ₽
                        </div>
                    </div>
                </div>

                <div class="text-center mt-12">
                    <a
                        href="/kontakty"
                        class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg hover:shadow-xl transition-all duration-300"
                    >
                        Рассчитать стоимость проекта
                    </a>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="py-16 md:py-24 bg-gray-50">
            <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4"
                    >
                        Часто задаваемые вопросы
                    </h2>
                </div>

                <div class="space-y-4">
                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <h3 class="text-lg font-heading font-semibold mb-3">
                            Сколько стоит корпоратив в Москве в 2026?
                        </h3>
                        <p class="text-text-light">
                            Средний чек под ключ — от 15–22 тыс. ₽ на человека.
                            50 гостей ≈ 850–1,4 млн ₽, 100 гостей ≈ 1,4–2,8 млн
                            ₽, 200+ ≈ 2,3–7+ млн ₽. Точную цифру даём после
                            брифа за 1 день.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <h3 class="text-lg font-heading font-semibold mb-3">
                            За сколько реально организовать новогодний
                            корпоратив?
                        </h3>
                        <p class="text-text-light">
                            Идеально — за 4–6 месяцев (лучшие площадки и артисты
                            разбирают заранее). Реально — от 45 дней (есть
                            проверенные локации и свой штат).
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <h3 class="text-lg font-heading font-semibold mb-3">
                            Работаете только в Москве или по всей России?
                        </h3>
                        <p class="text-text-light">
                            По всей России и СНГ. Основная команда в Москве, но
                            логистику и локальных подрядчиков выстраиваем за 2–3
                            недели.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Partners Section -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2
                        class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4"
                    >
                        Наши партнеры
                    </h2>
                    <p class="text-lg text-text-light max-w-2xl mx-auto">
                        Мы работаем с именитыми компаниями и представителями
                        рынка
                    </p>
                </div>

                <div
                    class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6 items-center"
                >
                    <img
                        src="/g/s3/mosaic/images/partners/logo_aop_t.webp"
                        alt="АОП"
                        class="h-16 w-auto mx-auto opacity-70 hover:opacity-100 transition-opacity"
                    />
                    <img
                        src="/g/s3/mosaic/images/partners/dkpng.png"
                        alt="ДКПНГ"
                        class="h-16 w-auto mx-auto opacity-70 hover:opacity-100 transition-opacity"
                    />
                    <img
                        src="/g/s3/mosaic/images/partners/logo_imzylovo.jpg"
                        alt="Измайлово"
                        class="h-16 w-auto mx-auto opacity-70 hover:opacity-100 transition-opacity"
                    />
                    <img
                        src="/g/s3/mosaic/images/partners/logo_mos_zezony.png"
                        alt="Московские зёрнышки"
                        class="h-16 w-auto mx-auto opacity-70 hover:opacity-100 transition-opacity"
                    />
                    <img
                        src="/g/s3/mosaic/images/partners/rosatom.png"
                        alt="Росатом"
                        class="h-16 w-auto mx-auto opacity-70 hover:opacity-100 transition-opacity"
                    />
                    <img
                        src="/g/s3/mosaic/images/partners/vdnh.png"
                        alt="ВДНХ"
                        class="h-16 w-auto mx-auto opacity-70 hover:opacity-100 transition-opacity"
                    />
                    <img
                        src="/g/s3/mosaic/images/partners/logo_kolomenskoe.jpg"
                        alt="Коломенское"
                        class="h-16 w-auto mx-auto opacity-70 hover:opacity-100 transition-opacity"
                    />
                    <img
                        src="/g/s3/mosaic/images/partners/rzhd.jpg"
                        alt="РЖД"
                        class="h-16 w-auto mx-auto opacity-70 hover:opacity-100 transition-opacity"
                    />
                    <img
                        src="/g/s3/mosaic/images/partners/logo_sber.jpg"
                        alt="Сбер"
                        class="h-16 w-auto mx-auto opacity-70 hover:opacity-100 transition-opacity"
                    />
                    <img
                        src="/g/s3/mosaic/images/partners/logo_lukoil.webp"
                        alt="Лукойл"
                        class="h-16 w-auto mx-auto opacity-70 hover:opacity-100 transition-opacity"
                    />
                    <img
                        src="/g/s3/mosaic/images/partners/vdnh_expo.png"
                        alt="ВДНХ Экспо"
                        class="h-16 w-auto mx-auto opacity-70 hover:opacity-100 transition-opacity"
                    />
                    <img
                        src="/g/s3/mosaic/images/partners/logo_russian_postsvg.png"
                        alt="Российская почта"
                        class="h-16 w-auto mx-auto opacity-70 hover:opacity-100 transition-opacity"
                    />
                    <img
                        src="/g/s3/mosaic/images/partners/logo_gazprom.png"
                        alt="Газпром"
                        class="h-16 w-auto mx-auto opacity-70 hover:opacity-100 transition-opacity"
                    />
                    <img
                        src="/g/s3/mosaic/images/partners/gostinyj-dvor-logo.png"
                        alt="Гостиный двор"
                        class="h-16 w-auto mx-auto opacity-70 hover:opacity-100 transition-opacity"
                    />
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section
            class="relative min-h-[400px] flex items-center text-white overflow-hidden py-24"
        >
            <img
                src="/g/s3/mosaic/images/hero-bg.jpg"
                alt=""
                class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-primary/80"></div>

            <div
                class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center"
            >
                <h2
                    class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-6"
                >
                    Свяжитесь с нами
                </h2>
                <p
                    class="text-lg md:text-xl text-white/90 mb-10 max-w-2xl mx-auto"
                >
                    Предложим формат и рассчитаем бюджет в течение 1 дня
                </p>
                <div
                    class="flex flex-col sm:flex-row gap-4 justify-center items-center"
                >
                    <a
                        href="tel:+79169064490"
                        class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-white hover:bg-white/90 text-primary shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                    >
                        +7 (916) 906-44-90
                    </a>
                    <a
                        href="/kontakty"
                        class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-transparent border-2 border-white hover:bg-white hover:text-primary text-white shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                    >
                        Оставить заявку
                    </a>
                </div>
            </div>
        </section>
    </div>
</Layout>
