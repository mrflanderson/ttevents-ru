---
import Layout from "../components/Layout.astro";

const pageTitle = "Кейс: 9 Мая — Патриотическое мероприятие";
const pageDescription = "Кейс: 9 Мая — патриотическое мероприятие";
const keywords = "кейс 9 мая";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="py-16 md:py-24">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4">
                <a href="/" class="hover:text-primary">Главная</a> / <a
                    href="/case"
                    class="hover:text-primary">Кейсы</a
                > / <span class="font-medium text-text">9 Мая</span>
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Кейс: 9 Мая
            </h1>
            <div class="prose prose-lg max-w-none">
                <p class="text-lg text-text-light mb-6">Кейс: 9 Мая</p>
            </div>
        </div>
    </div>
</Layout>
