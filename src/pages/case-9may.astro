---
import Layout from '../components/Layout.astro';

const pageTitle = 'Кейс: 9 Мая — городское мероприятие';
const pageDescription = 'Организация мероприятия на 9 Мая в Москве. Две площадки, техническое обеспечение.';
const keywords = '9 Мая, городское мероприятие, День Победы';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Кейс: 9 Мая</h1>
            <p>Городское мероприятие ко Дню Победы</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <ul class="feature-list mt-2">
                <li>Две площадки</li>
                <li>Техническое обеспечение</li>
                <li>Координация служб</li>
                <li>4000+ гостей</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="/case" class="btn btn-primary">Все кейсы</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>