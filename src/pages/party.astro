---
import Layout from '../components/Layout.astro';

const pageMeta = {
  title: 'TT Events — Party',
  description: 'Работа остается в офисе. Здесь начинается жизнь! Организация развлекательных B2B корпоративов в Москве.',
  ogTitle: 'TT Events — Party',
  ogDescription: 'Работа остается в офисе. Здесь начинается жизнь! Организация развлекательных B2B корпоративов в Москве.',
  ogImage: '/g/s3/mosaic/images/og-services.jpg',
};
---

<Layout {...pageMeta}>
  <!-- Hero -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-gray-900 to-gray-800 text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-gray-400 mb-4">
        <a href="/" class="hover:text-white">Главная</a> / <a href="/korporativy-moskva" class="hover:text-white">Корпоративные мероприятия</a> / <span class="font-medium">Party</span>
      </nav>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white font-heading mb-6">Party</h1>
      <p class="text-lg text-gray-300 max-w-3xl">Работа остается в офисе. Здесь начинается жизнь!</p>
    </div>
  </section>

  <!-- Menu Cards -->
  <section class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <a href="/classic" class="group block bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
          <div class="relative h-64 overflow-hidden">
            <img src="/g/s3/mosaic/images/big_corp_2.jpg" alt="Корпоратив" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            <span class="absolute top-4 left-4 bg-primary text-white font-bold px-3 py-1 rounded-full text-sm">01</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-dark font-heading mb-2 group-hover:text-primary transition-colors">Корпоратив</h3>
            <p class="text-text-light mb-4">Элегантные вечера и шоу-программы для вашего бизнеса.</p>
            <span class="text-primary font-semibold group-hover:underline">Смотреть —</span>
          </div>
        </a>

        <!-- Card 2 -->
        <a href="/immersivnyj-korporativ" class="group block bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
          <div class="relative h-64 overflow-hidden">
            <img src="/g/s3/mosaic/images/pexels-amar-10360899_2_2_2.jpg" alt="Арт" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            <span class="absolute top-4 left-4 bg-primary text-white font-bold px-3 py-1 rounded-full text-sm">02</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-dark font-heading mb-2 group-hover:text-primary transition-colors">Арт</h3>
            <p class="text-text-light mb-4">Иммерсивные шоу, перформансы и digital-активности.</p>
            <span class="text-primary font-semibold group-hover:underline">Смотреть —</span>
          </div>
        </a>

        <!-- Card 3 -->
        <a href="/timbilding-moskva" class="group block bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
          <div class="relative h-64 overflow-hidden">
            <img src="/g/s3/mosaic/images/55406382_3.jpg" alt="Тимбилдинг" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            <span class="absolute top-4 left-4 bg-primary text-white font-bold px-3 py-1 rounded-full text-sm">03</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-dark font-heading mb-2 group-hover:text-primary transition-colors">Тимбилдинг</h3>
            <p class="text-text-light mb-4">Сплочение коллектива через живой драйв и приключения.</p>
            <span class="text-primary font-semibold group-hover:underline">Смотреть —</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 md:py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-dark font-heading mb-4">Заказать</h2>
      <a href="/kontakty" class="inline-block bg-primary text-white font-semibold px-8 py-3 rounded-lg hover:bg-primary-dark transition-colors">
        Получить расчёт
      </a>
    </div>
  </section>
</Layout>
