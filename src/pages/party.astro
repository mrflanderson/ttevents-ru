---
import Layout from '../components/Layout.astro';

const pageTitle = 'Праздники и торжества';
const pageDescription = 'Организация праздников и торжественных мероприятий. Юбилеи, выпускные, семейные праздники.';
const keywords = 'праздник, торжество, выпускной, юбилей';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Праздники и торжества</h1>
            <p>Яркие события и незабываемые моменты</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <ul class="feature-list mt-2">
                <li>Юбилеи компаний</li>
                <li>Выпускные вечера</li>
                <li>Семейные праздники</li>
                <li>Церемонии награждения</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Заказать</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>