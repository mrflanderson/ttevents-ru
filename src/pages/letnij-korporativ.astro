---
import {definePageMeta} from 'astro:content';
import { seo } from '@/components/SEO.astro';

const pageData = {
  title: `Летний корпоратив на природе 2026 — идеи, сценарии, организация в Москве | TT Events`,
  description: `Идеи летнего корпоратива на природе: тимбилдинг, фестивальный open-air, пикник с BBQ. Организация под ключ от агентства TT Events с 2006 года. Цены и реальные кейсы.`,
  keywords: `Летний корпоратив`,
};

const seoMeta = {
  ogTitle: ``,
  ogDescription: ``,
  ogImage: ``,
};

export const pageMeta = definePageMeta(() => ({
  seo: {
    title: pageData.title,
    description: pageData.description,
    keywords: pageData.keywords,
    ogTitle: seoMeta.ogTitle,
    ogDescription: seoMeta.ogDescription,
    ogImage: seoMeta.ogImage,
  },
}));

export { pageData, seoMeta };
