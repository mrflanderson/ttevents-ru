---
import Layout from '../components/Layout.astro';

const pageTitle = 'Летний корпоратив';
const pageDescription = 'Летний корпоратив на природе, пикник, барбекю. Организация летних корпоративных мероприятий.';
const keywords = 'летний корпоратив, пикник, барбекю, корпоратив на природе';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Летний корпоратив</h1>
            <p>Отдых на природе с командой</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <ul class="feature-list mt-2">
                <li>Пикники и барбекю</li>
                <li>Базы отдыха</li>
                <li>Спорт на природе</li>
                <li>Вечеринки на открытом воздухе</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Заказать</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>