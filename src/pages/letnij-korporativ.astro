---
import Layout from "../components/Layout.astro";

const pageMeta = {
    title: "Летний корпоратив в Москве — TT Events",
    description:
        "Организация летних корпоративов на природе и крышах. Пикники, фестивали, спортивные мероприятия и вечеринки для команды от 10 до 1000+ человек.",
    ogTitle: "Летний корпоратив в Москве — TT Events",
    ogDescription: "Яркие летние корпоративы для сплочения команды.",
};

const services = [
    { title: "Летний пикник", href: "/letnij-korporativ" },
    { title: "Фестиваль на крыше", href: "/letnij-korporativ" },
    { title: "Спортивный день", href: "/letnij-korporativ" },
    { title: "Летняя вечеринка", href: "/party" },
];

const faqItems = [
    {
        question: "Что включает организация летнего корпоратива?",
        answer: "Разработка концепции, подбор площадки (парк, крыша, база отдыха), кейтеринг, развлекательная программа, техническое обеспечение.",
    },
    {
        question: "Какой минимальный состав команды?",
        answer: "От 10 человек до 1000+. Подбираем формат под ваш состав.",
    },
    {
        question: "Сколько длится летний корпоратив?",
        answer: "От 4 часов до 2 дней. Стандарт — 6-8 часов.",
    },
];
---

<!--
  TT Events — Tailwind CSS Migration
  Generated on: 2026-05-17
-->
<Layout {...pageMeta}>
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4" aria-label="Навигация">
                <a href="/" class="hover:text-primary">Главная</a> / <span
                    class="font-medium text-text"
                    aria-current="page">Летний корпоратив</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Летний корпоратив в Москве
            </h1>
            <p class="text-lg text-text-light max-w-3xl mb-12">
                Организация летних корпоративов на природе и крышах. Пикники,
                фестивали, спортивные мероприятия и вечеринки для команды от 10
                до 1000+ человек.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    services.map((service) => (
                        <a
                            href={service.href}
                            class="block p-6 bg-white rounded-xl shadow-card hover:shadow-card-hover transition-all duration-300"
                            aria-label={service.title}
                        >
                            <h3 class="text-xl font-heading font-semibold text-dark hover:text-primary transition-colors">
                                {service.title}
                            </h3>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="py-16 md:py-24">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2
                class="text-2xl md:text-3xl font-bold text-dark font-heading mb-8 text-center"
            >
                Часто задаваемые вопросы
            </h2>
            <div class="divide-y divide-gray-200">
                {
                    faqItems.map((item) => (
                        <div class="py-4">
                            <details>
                                <summary class="font-semibold cursor-pointer text-dark list-none">
                                    {item.question}
                                </summary>
                                <p class="mt-2 text-text-light leading-relaxed">
                                    {item.answer}
                                </p>
                            </details>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
