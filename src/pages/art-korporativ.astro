---
import Layout from '../components/Layout.astro';

const pageTitle = 'Тематический корпоратив';
const pageDescription = 'Тематические корпоративные вечеринки в Москве. Арт-вечеринки, иммерсивные шоу, концептуальные мероприятия.';
const keywords = 'тематический корпоратив, арт-вечеринка, иммерсивное шоу, концептуальное мероприятие';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Тематический корпоратив</h1>
            <p>Оригинальные концепции и форматы</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <p>Тематический корпоратив — возможность создать уникальную атмосферу:</p>
            <ul class="feature-list mt-2">
                <li>Арт-вечеринки</li>
                <li>Иммерсивные шоу</li>
                <li>Тематические форматы (80-е, Hollywood, Chicago)</li>
                <li>Концептуальные мероприятия</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Обсудить концепцию</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.feature-list li { margin-bottom: var(--space-sm); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>