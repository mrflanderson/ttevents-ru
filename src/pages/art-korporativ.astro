---
import Layout from "../components/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import PageHero from "../components/sections/PageHero.astro";
import FAQSection from "../components/sections/FAQSection.astro";
import CTASection from "../components/sections/CTASection.astro";

const pageTitle =
    "Арт-корпоратив в Москве — креативная вечеринка и концептуальное мероприятие | TT Events";
const pageDescription =
    "Организация арт-корпоративов в Москве: креативные вечеринки, иммерсивные шоу, тематические мероприятия и мультимедийный продакшн с 2006 года.";
const keywords =
    "арт-корпоратив москва, креативная вечеринка, иммерсивный корпоратив, тематический корпоратив, арт-вечеринка, концептуальный корпоратив";

const services = [
    { title: "Арт-вечеринка", href: "/art-korporativ", count: 70 },
    { title: "Иммерсивное шоу", href: "/immersivnyj-korporativ", count: 55 },
    { title: "Тематическая вечеринка", href: "/party", count: 65 },
    { title: "Мультимедийное шоу", href: "/mediproekty", count: 40 },
    { title: "Концептуальное мероприятие", href: "/art-korporativ", count: 50 },
    { title: "Арт-фестиваль", href: "/festivali", count: 45 },
];

const faqItems = [
    {
        question: "Что такое арт-корпоратив?",
        answer: "Арт-корпоратив — это креативное мероприятие с персонажами, декорациями, спецэффектами и сюжетом. Это не просто вечеринка, а целое представление.",
    },
    {
        question: "Где проходят арт-корпоративы?",
        answer: "В лофтах, галереях, на крышах, в арт-пространствах и загородных клубах с тематическим оформлением.",
    },
    {
        question: "Сколько стоит арт-корпоратив?",
        answer: "Стоимость зависит от концепции и количества гостей. Бюджет от 2 000 000 ₽ включает декор, программу и анимацию.",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    canonicalURL="/art-korporativ"
>
    <!-- Hero Section -->
    <PageHero
        title="Арт-корпоратив в Москве"
        subtitle="Организация арт-корпоративов под ключ: креативные вечеринки, иммерсивные шоу, тематические мероприятия. Полное сопровождение и мультимедийный продакшн."
        cta={{ label: "Обсудить проект", href: "/kontakty" }}
        backgroundImage="/images/art-hero.jpg"
    />

    <!-- Content Section -->
    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="prose prose-lg max-w-none">
                <h2
                    class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                >
                    Форматы арт-корпоративов
                </h2>
                <p class="text-lg text-text-light mb-8">
                    TT Events организует арт-корпоративы для компаний в Москве.
                    Мы предлагаем разнообразные форматы — от креативных
                    вечеринок до иммерсивных представлений.
                </p>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12"
                >
                    {services.map((service) => <ServiceCard {...service} />)}
                </div>

                <h2
                    class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                >
                    Как мы работаем
                </h2>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12"
                >
                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            01
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Брифинг
                        </h3>
                        <p class="text-text-light text-sm">
                            Определяем цели, интересы и формат мероприятия.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            02
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Концепция
                        </h3>
                        <p class="text-text-light text-sm">
                            Разрабатываем уникальную идею и сюжет.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            03
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Производство
                        </h3>
                        <p class="text-text-light text-sm">
                            Декор, костюмы, мультимедиа и анимация.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            04
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Проведение
                        </h3>
                        <p class="text-text-light text-sm">
                            Полное сопровождение мероприятия.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            05
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Видео и фото
                        </h3>
                        <p class="text-text-light text-sm">
                            Профессиональная съёмка и монтаж.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <FAQSection items={faqItems} />

    <!-- CTA Section -->
    <CTASection
        title="Свяжитесь с нами"
        description="Предложим формат и рассчитаем бюджет в течение 1 дня"
        button1Label="+7 (916) 906-44-90"
        button1Href="tel:+79169064490"
        button1Type="primary"
        button2Label="Оставить заявку"
        button2Href="/kontakty"
        showPhone={false}
        showEmail={false}
    />

    <section class="py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="text-sm text-text-light">
                Все корпоративные мероприятия → <a href="/services/corporate-events" class="underline hover:text-primary">/services/corporate-events</a>
            </p>
        </div>
    </section>
</Layout>
