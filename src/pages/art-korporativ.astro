---
import Layout from "../components/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import FAQ from "../components/FAQ.astro";

const pageTitle =
    "Арт-корпоратив в Москве — креативная вечеринка и концептуальное мероприятие | TT Events";
const pageDescription =
    "Организация арт-корпоративов в Москве: креативные вечеринки, иммерсивные шоу, тематические мероприятия и мультимедийный продакшн с 2006 года.";
const keywords =
    "арт-корпоратив москва, креативная вечеринка, иммерсивный корпоратив, тематический корпоратив, арт-вечеринка, концептуальный корпоратив";

const services = [
    { title: "Арт-вечеринка", href: "/art-korporativ", count: 70 },
    { title: "Иммерсивное шоу", href: "/immersivnyj-korporativ", count: 55 },
    { title: "Тематическая вечеринка", href: "/party", count: 65 },
    { title: "Мультимедийное шоу", href: "/mediproekty", count: 40 },
    { title: "Концептуальное мероприятие", href: "/art-korporativ", count: 50 },
    { title: "Арт-фестиваль", href: "/festivali", count: 45 },
];

const faqItems = [
    {
        question: "Что такое арт-корпоратив?",
        answer: "Арт-корпоратив — это креативное мероприятие с персонажами, декорациями, спецэффектами и сюжетом. Это не просто вечеринка, а целое представление.",
    },
    {
        question: "Где проходят арт-корпоративы?",
        answer: "В лофтах, галереях, на крышах, в арт-пространствах и загородных клубах с тематическим оформлением.",
    },
    {
        question: "Сколько стоит арт-корпоратив?",
        answer: "Стоимость зависит от концепции и количества гостей. Бюджет от 2 000 000 ₽ включает декор, программу и анимацию.",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    canonicalURL="/art-korporativ"
>
    <!-- Hero Section -->
    <section
        class="relative min-h-[500px] md:min-h-[600px] flex items-center text-white overflow-hidden"
    >
        <img
            src="/images/art-hero.jpg"
            alt="Арт-корпоратив — креативная вечеринка"
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>

        <div
            class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full"
        >
            <div class="max-w-[800px]">
                <nav class="text-sm text-text-light mb-4">
                    <a href="/" class="hover:text-primary">Главная</a> / <a
                        href="/korporativy-moskva"
                        class="hover:text-primary">Услуги</a
                    > / <span class="font-medium text-text">Арт-корпоратив</span
                    >
                </nav>
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6"
                >
                    Арт-корпоратив в Москве
                </h1>
                <p class="text-lg md:text-xl text-white/90 mb-10">
                    Организация арт-корпоративов под ключ: креативные вечеринки,
                    иммерсивные шоу, тематические мероприятия. Полное
                    сопровождение и мультимедийный продакшн.
                </p>
                <a
                    href="/kontakty"
                    class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg hover:shadow-xl transition-all duration-300"
                >
                    Обсудить проект
                </a>
            </div>
        </div>
    </section>

    <!-- Content Section -->
    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="prose prose-lg max-w-none">
                <h2
                    class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                >
                    Форматы арт-корпоративов
                </h2>
                <p class="text-lg text-text-light mb-8">
                    TT Events организует арт-корпоративы для компаний в Москве.
                    Мы предлагаем разнообразные форматы — от креативных
                    вечеринок до иммерсивных представлений.
                </p>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12"
                >
                    {services.map((service) => <ServiceCard {...service} />)}
                </div>

                <h2
                    class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                >
                    Как мы работаем
                </h2>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12"
                >
                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            01
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Брифинг
                        </h3>
                        <p class="text-text-light text-sm">
                            Определяем цели, интересы и формат мероприятия.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            02
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Концепция
                        </h3>
                        <p class="text-text-light text-sm">
                            Разрабатываем уникальную идею и сюжет.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            03
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Производство
                        </h3>
                        <p class="text-text-light text-sm">
                            Декор, костюмы, мультимедиа и анимация.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            04
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Проведение
                        </h3>
                        <p class="text-text-light text-sm">
                            Полное сопровождение мероприятия.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            05
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Видео и фото
                        </h3>
                        <p class="text-text-light text-sm">
                            Профессиональная съёмка и монтаж.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 md:py-24 bg-gray-50">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2
                    class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4"
                >
                    Часто задаваемые вопросы
                </h2>
            </div>

            <div class="space-y-4">
                {
                    faqItems.map((item) => (
                        <div class="bg-white rounded-xl p-6 shadow-card">
                            <details>
                                <summary class="font-heading font-semibold cursor-pointer text-dark mb-2">
                                    {item.question}
                                </summary>
                                <p class="text-text-light">{item.answer}</p>
                            </details>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section
        class="relative min-h-[400px] flex items-center text-white overflow-hidden py-24"
    >
        <img
            src="/images/art-hero.jpg"
            alt=""
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-primary/80"></div>

        <div
            class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center"
        >
            <h2
                class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-6"
            >
                Свяжитесь с нами
            </h2>
            <p class="text-lg md:text-xl text-white/90 mb-10 max-w-2xl mx-auto">
                Предложим формат и рассчитаем бюджет в течение 1 дня
            </p>
            <div
                class="flex flex-col sm:flex-row gap-4 justify-center items-center"
            >
                <a
                    href="tel:+79169064490"
                    class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-white hover:bg-white/90 text-primary shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                >
                    +7 (916) 906-44-90
                </a>
                <a
                    href="/kontakty"
                    class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-transparent border-2 border-white hover:bg-white hover:text-primary text-white shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                >
                    Оставить заявку
                </a>
            </div>
        </div>
    </section>
</Layout>
