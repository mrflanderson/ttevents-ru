---
import { getCollection } from "astro:content";
import Layout from "../../components/Layout.astro";

export async function getStaticPaths() {
  const cases = await getCollection("cases");

  return cases
    .filter((c) => c.data.published !== false)
    .map((c) => {
      const slug = c.id.replace(/^.*\//, ""); // e.g. "artpop"
      return {
        route: `/case/${slug}`,
        params: { slug },
        props: { slug, caseId: c.id },
      };
    });
}

const allCases = await getCollection("cases");
const { slug, caseId } = Astro.props;
const post = allCases.find((c) => c.id === caseId);

if (!post) throw new Error("Case not found");

const meta = post.data;
const title = meta.title || "Кейс | TT Events";
const description = meta.description || "";
const canonicalURL = `/case/${slug}`;

const formatDate = (value?: Date | string) => {
  if (!value) return "";
  const d = value instanceof Date ? value : new Date(value);
  if (Number.isNaN(d.getTime())) return "";
  return d.toLocaleDateString("ru-RU", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
};
---

<Layout
  title={title}
  description={description}
  canonicalURL={canonicalURL}
>
  <article class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Breadcrumbs */}
      <nav class="text-sm text-text-light mb-4">
        <a href="/" class="hover:text-primary">Главная</a> /{" "}
        <a href="/case" class="hover:text-primary">Кейсы</a> /{" "}
        <span class="font-medium text-text">{title}</span>
      </nav>

      {/* Title + metadata */}
      <header class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold text-dark font-heading mb-4">
          {meta.title}
        </h1>

        {meta.description && (
          <p class="text-lg text-text-light mb-4">{meta.description}</p>
        )}

        <div class="flex flex-wrap items-center gap-4 text-sm text-text-light">
          {meta.date && (
            <span>{formatDate(meta.date)}</span>
          )}
        </div>

        {/* Tags */}
        {meta.tags?.length && (
          <div class="flex flex-wrap gap-2 mt-3">
            {meta.tags.map((tag: string) => (
              <span
                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs bg-gray-100 text-text-light"
              >
                {tag}
              </span>
            ))}
          </div>
        )}
      </header>

      {/* Cover Image */}
      {meta.coverImage && (
        <div class="mb-10 overflow-hidden rounded-xl bg-gray-100">
          <img
            src={meta.coverImage}
            alt={meta.title}
            class="w-full h-auto"
            loading="lazy"
          />
        </div>
      )}

      {/* Optional: Client / Budget blocks */}
      {(meta.client || meta.budget) && (
        <div class="mb-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {meta.client && (
            <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
              <div class="text-xs text-text-light mb-1">Клиент</div>
              <div class="font-medium text-text">{meta.client}</div>
            </div>
          )}
          {meta.budget && (
            <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
              <div class="text-xs text-text-light mb-1">Бюджет</div>
              <div class="font-medium text-text">{meta.budget}</div>
            </div>
          )}
        </div>
      )}

      {/* Case Body */}
      <div
        class="prose prose-lg max-w-none text-text"
        dangerouslySetInnerHTML={{ __html: post.body }}
      />
    </div>
  </article>
</Layout>
