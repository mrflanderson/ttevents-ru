---
import Layout from "../../components/Layout.astro";
import CaseCard from "../../components/CaseCard.astro";
import Hero from "../../components/Hero.astro";
import FAQ from "../../components/FAQ.astro";
import { getCollection } from "astro:content";

const pageTitle = "Кейсы и портфолио — реализованные проекты | TT Events";
const pageDescription =
    "Портфолио проектов TT Events: корпоративы, тимбилдинги, конференции, launch events, фестивали. Реальные кейсы с 2006 года.";
const keywords =
    "кейсы event агентства, портфолио мероприятий, реализованные проекты, case studies москва";

const allCases = await getCollection("cases");

const cases = allCases
    .filter((post) => post.data?.published !== false)
    .map((post) => {
        const slug = post.id;
        const tags = post.data?.tags ?? [];
        return {
            title: post.data?.title ?? "Кейс",
            href: `/case/${slug}`,
            category: tags?.[0] ?? "Кейс",
            image: post.data?.coverImage ?? "/images/case-default.jpg",
        };
    });

const categories = [
    { title: "Корпоративные мероприятия", href: "/services/corporate-events" },
    { title: "MICE и деловые", href: "/services/mice-business" },
    { title: "Тимбилдинг", href: "/services/team-building" },
    { title: "Фестивали", href: "/services/festivals" },
    { title: "Media", href: "/media" },
];

const faqItems = [
    {
        question: "Сколько проектов реализовано?",
        answer: "Более 2000 проектов с 2006 года. Мы гордимся каждым кейсом — от камерных встреч до фестивалей на 10 000+ гостей.",
    },
    {
        question: "Можно ли увидеть кейсы в видеоформате?",
        answer: "Да, мы публикуем видеоотчёты на YouTube и в нашем видео-портфолио. Каждое видео сопровождается описанием задачи и результатов.",
    },
    {
        question: "Можно ли адаптировать кейс под нашу компанию?",
        answer: "Конечно! Мы адаптируем лучшие решения под ваши задачи и бюджет. Каждый проект разрабатывается индивидуально.",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    canonicalURL="/case"
>
    <div class="page-service w-full overflow-x-hidden">
        <Hero
            title="Портфолио и кейсы"
            subtitle="Реальные проекты с 2006 года: корпоративы, тимбилдинги, конференции, launch events, фестивали."
            ctaText="Обсудить проект"
            ctaHref="/kontakty"
            backgroundImage="/images/cases-hero-bg.jpg"
        />

        <!-- Categories -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-dark font-heading mb-6"
                    >
                        Каждый кейс — это история успеха
                    </h2>
                    <p class="text-lg text-text-light mb-8">
                        Выбирайте по направлению — кейсы отфильтрованы по типам событий.
                    </p>
                    <div class="flex flex-wrap justify-center gap-3 mb-10 text-wrap break-words">
                        {categories.map((c) => (
                            <a
                                href={c.href}
                                class="inline-flex items-center px-4 py-2.5 rounded-lg bg-gray-100 text-text-light hover:bg-primary hover:text-white transition-colors text-sm min-h-[36px]"
                            >
                                {c.title}
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- Intro -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center max-w-3xl mx-auto">
                    <h2
                        class="text-3xl md:text-4xl font-bold text-dark font-heading mb-6"
                    >
                        Портфолио реализованных проектов
                    </h2>
                    <p class="text-lg text-text-light mb-4">
                        Мы не используем абстрактные примеры — только
                        реализованные проекты с реальными результатами.
                    </p>
                    <p class="text-lg text-text-light mb-8">
                        Каждый кейс включает описание задачи, концепции,
                        реализации и результатов. Мы публикуем фото и видео
                        материалы, чтобы вы могли оценить качество работы.
                    </p>
                    <div class="flex flex-col sm:flex-row gap-4 justify-center w-full">
                        <a href="/kontakty" class="btn-primary w-full sm:w-auto inline-flex justify-center min-h-[44px]"
                            >Обсудить проект</a
                        >
                        <a href="/video-portfolio" class="btn-outline w-full sm:w-auto inline-flex justify-center min-h-[44px]"
                            >Смотреть видео</a
                        >
                    </div>
                </div>
            </div>
        </section>

        <!-- Cases Grid -->
        <section class="py-16 md:py-24 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="section-title mb-16">Избранные проекты</h2>
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 overflow-hidden"
                >
                    {cases.map((caseItem) => <CaseCard {...caseItem} />)}
                </div>
            </div>
        </section>

        <!-- Advantages -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2
                    class="text-3xl md:text-4xl font-bold text-center mb-12 text-dark font-heading"
                >
                    Результаты наших проектов
                </h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 overflow-hidden">
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            2000+
                        </div>
                        <h3 class="text-xl font-semibold mb-2">Проектов</h3>
                        <p class="text-text-light">Реализовано с 2006 года</p>
                    </div>
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            150+
                        </div>
                        <h3 class="text-xl font-semibold mb-2">
                            Постоянных клиентов
                        </h3>
                        <p class="text-text-light">Доверяют нам регулярно</p>
                    </div>
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            10000+
                        </div>
                        <h3 class="text-xl font-semibold mb-2">
                            Участников мероприятий
                        </h3>
                        <p class="text-text-light">Самый крупный проект</p>
                    </div>
                </div>
            </div>
        </section>

        <FAQ items={faqItems} />
    </div>
</Layout>
