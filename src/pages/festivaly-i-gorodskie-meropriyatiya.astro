---
import Layout from "../components/Layout.astro";
import FAQSection from "../components/sections/FAQSection.astro";

const pageMeta = {
    title: "Фестивали и городские мероприятия в Москве — TT Events",
    description:
        "Организация фестивалей и городских мероприятий в Москве под ключ. Open-air события, семейные и культурные фестивали. Масштабные проекты под ключ: День города, Масленица, выпускные Open-Air.",
    ogTitle: "Фестивали и городские мероприятия в Москве — TT Events",
    ogDescription:
        "Профессиональные актеры Театра Традиций, собственный видеопродакшн.",
    canonicalURL: "/festivaly-i-gorodskie-meropriyatiya",
};

const services = [
    { title: "День города", href: "/festivaly-i-gorodskie-meropriyatiya" },
    { title: "Масленица", href: "/festivaly-i-gorodskie-meropriyatiya" },
    {
        title: "Выпускные Open-Air",
        href: "/festivaly-i-gorodskie-meropriyatiya",
    },
    {
        title: "Семейные фестивали",
        href: "/festivaly-i-gorodskie-meropriyatiya",
    },
];

const faqItems = [
    {
        question: "Что входит в организацию городского фестиваля?",
        answer: "Разработка концепции, подбор площадки, техническое обеспечение, артисты, логистика и полный цикл реализации.",
    },
    {
        question: "Какой минимальный состав команды?",
        answer: "От 10 человек до 1000+. Подбираем формат под ваш состав.",
    },
    {
        question: "Сколько длится фестиваль?",
        answer: "От 2 часов до 3 дней. Стандарт — 4-6 часов.",
    },
];
---

<!--
  TT Events — Tailwind CSS Migration
  Generated on: 2026-05-17
-->
<Layout {...pageMeta}>
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4" aria-label="Навигация">
                <a href="/" class="hover:text-primary">Главная</a> / <span
                    class="font-medium text-text"
                    aria-current="page">Фестивали</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Фестивали и городские мероприятия
            </h1>
            <p class="text-lg text-text-light max-w-3xl mb-12">
                Организация фестивалей и городских мероприятий в Москве под
                ключ. Open-air события, семейные и культурные фестивали.
                Масштабные проекты под ключ.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    services.map((service) => (
                        <a
                            href={service.href}
                            class="block p-6 bg-white rounded-xl shadow-card hover:shadow-card-hover transition-all duration-300"
                            aria-label={service.title}
                        >
                            <h3 class="text-xl font-heading font-semibold text-dark hover:text-primary transition-colors">
                                {service.title}
                            </h3>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <FAQSection items={faqItems} />

    <section class="py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="text-sm text-text-light">
                Фестивали и городские события → <a href="/services/festivals" class="underline hover:text-primary">/services/festivals</a>
            </p>
        </div>
    </section>
</Layout>
