---
import Layout from '../components/Layout.astro';

const pageTitle = 'Фестивали и городские мероприятия';
const pageDescription = 'Организация фестивалей и городских мероприятий. Open air, концерты, фестивали.';
const keywords = 'фестиваль, городское мероприятие, open air';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Фестивали и городские мероприятия</h1>
            <p>Масштабные события</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <ul class="feature-list mt-2">
                <li>Фестивали</li>
                <li>Концерты</li>
                <li>Open air</li>
                <li>Городские праздники</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Заказать</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>