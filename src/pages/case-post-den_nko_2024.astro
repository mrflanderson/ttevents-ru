---
import Layout from '../components/Layout.astro';

const pageTitle = 'Кейс: Пост День ко 2024';
const pageDescription = 'Мероприятие Пост День ко. Праздник для детей.';
const keywords = 'детский праздник, кейс';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Кейс: Пост День ко</h1>
            <p>Праздник для детей</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <ul class="feature-list mt-2">
                <li>Детская программа</li>
                <li>Аниматоры</li>
            </ul>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
</style>