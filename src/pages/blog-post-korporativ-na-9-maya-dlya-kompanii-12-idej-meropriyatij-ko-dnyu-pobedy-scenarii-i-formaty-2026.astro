---
import Layout from "../components/Layout.astro";

const pageTitle = "Корпоратив на 9 Мая — 12 идей мероприятий для компании";
const pageDescription =
    "12 идей корпоративных мероприятий на 9 Мая: от полевой кухни до театрализации. Как провести День Победы с уважением и интересом.";
const keywords =
    "корпоратив на 9 мая, мероприятия на день победы, тимбилдинг 9 мая, корпоратив день победы";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="py-16 md:py-24">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4">
                <a href="/" class="hover:text-primary">Главная</a> / <a
                    href="/blog"
                    class="hover:text-primary">Блог</a
                > / <span class="font-medium text-text"
                    >Корпоратив на 9 Мая</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Корпоратив на 9 Мая — 12 идей мероприятий для компании
            </h1>
            <div class="prose prose-lg max-w-none">
                <p class="text-lg text-text-light mb-6">
                    День Победы — день памяти и уважения. Мы предлагаем
                    программы, которые объединяют поколения через живые истории,
                    ретро-бала и тимбилдинг на военных темах.
                </p>
                <h2 class="text-2xl font-heading font-bold text-dark mb-4 mt-8">
                    1. Полевая кухня — интерактивная программа
                </h2>
                <p class="text-text-light mb-6">
                    Команды готовят блюда по рецептам 40-х годов под
                    руководством шеф-повара. Интерактив с историческими
                    акцентами и конкурсом на лучшее блюдо.
                </p>
            </div>
        </div>
    </div>
</Layout>
