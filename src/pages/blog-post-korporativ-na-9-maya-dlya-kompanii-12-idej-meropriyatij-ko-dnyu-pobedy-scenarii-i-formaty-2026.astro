	</li>
	<li data-end="5778" data-section-id="fwdhgm" data-start="5754">
	<p data-end="5778" data-start="5756">сценарий и режиссура</p>
	</li>
	<li data-end="5798" data-section-id="14lqks7" data-start="5779">
