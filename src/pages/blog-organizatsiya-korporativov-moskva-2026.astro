---
import Layout from "../components/Layout.astro";

const pageTitle =
    "Организация корпоративов в Москве 2026 — новые форматы и тренды";
const pageDescription =
    "Организация корпоративов в Москве 2026: новые форматы, тренды и реальные бюджеты. Как выбрать формат мероприятия для вашей компании.";
const keywords =
    "организация корпоративов москва, корпоративы 2026, новые форматы корпоративов";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="py-16 md:py-24">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4">
                <a href="/" class="hover:text-primary">Главная</a> / <a
                    href="/blog"
                    class="hover:text-primary">Блог</a
                > / <span class="font-medium text-text"
                    >Организация корпоративов 2026</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Организация корпоративов в Москве 2026
            </h1>
            <div class="prose prose-lg max-w-none">
                <p class="text-lg text-text-light mb-6">
                    Тренды 2026 года — это экологичность, интерактивность и
                    персонализация. Команда TT Events предлагает новые форматы,
                    которые объединяют сотрудников через реальный опыт.
                </p>
                <h2 class="text-2xl font-heading font-bold text-dark mb-4 mt-8">
                    Тренд 1: Эко-форматы
                </h2>
                <p class="text-text-light mb-6">
                    Корпоративы с экологическим компонентом: посадка деревьев,
                    создание арт-объектов из переработанных материалов.
                </p>
            </div>
        </div>
    </div>
</Layout>
