---
import Layout from '../components/Layout.astro';

const pageTitle = 'Креативный тимбилдинг';
const pageDescription = 'Креативный тимбилдинг: творческие задания, командное искусство.';
const keywords = 'креативный тимбилдинг, творчество';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Креативный тимбилдинг</h1>
            <p>Творческие задания</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <p>Креативный тимбилдинг:</p>
            <ul class="feature-list mt-2">
                <li>Арт-терапия</li>
                <li>Командное рисование</li>
                <li>Создание арт-объектов</li>
                <li>Мастер-классы</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Заказать</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>