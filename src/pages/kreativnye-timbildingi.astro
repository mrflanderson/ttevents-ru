---
import Layout from "../components/Layout.astro";
import FAQSection from "../components/sections/FAQSection.astro";

const pageMeta = {
    title: "Креативные тимбилдинги в Москве — TT Events",
    description:
        "Креативные тимбилдинги для команд от 10 до 1000+ человек. Художественные мастер-классы, арт-тимбилдинги, кулинарные битвы и творческие проекты.",
    ogTitle: "Креативные тимбилдинги в Москве — TT Events",
    ogDescription:
        "Профессиональная организация креативных тимбилдингов для бизнеса.",
};

const services = [
    { title: "Арт-тимбилдинги", href: "/kreativnye-timbildingi" },
    { title: "Кулинарные битвы", href: "/kreativnye-timbildingi" },
    { title: "Мастер-классы", href: "/master-klassy" },
    { title: "Творческие проекты", href: "/kreativnye-timbildingi" },
];

const faqItems = [
    {
        question: "Что включает креативный тимбилдинг?",
        answer: "Разработка концепции, подбор площадки, организация материалов, ведение программы и полный цикл реализации.",
    },
    {
        question: "Какой минимальный состав команды?",
        answer: "От 10 человек до 1000+. Подбираем формат под ваш состав.",
    },
    {
        question: "Сколько длится креативный тимбилдинг?",
        answer: "От 2 часов до 3 дней. Стандарт — 4-6 часов.",
    },
];
---

<!--
  TT Events — Tailwind CSS Migration
  Generated on: 2026-05-17
-->
<Layout {...pageMeta}>
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4" aria-label="Навигация">
                <a href="/" class="hover:text-primary">Главная</a> / <span
                    class="font-medium text-text"
                    aria-current="page">Креативные тимбилдинги</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Креативные тимбилдинги в Москве
            </h1>
            <p class="text-lg text-text-light max-w-3xl mb-12">
                Креативные тимбилдинги для команд от 10 до 1000+ человек.
                Художественные мастер-классы, арт-тимбилдинги, кулинарные битвы
                и творческие проекты.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    services.map((service) => (
                        <a
                            href={service.href}
                            class="block p-6 bg-white rounded-xl shadow-card hover:shadow-card-hover transition-all duration-300"
                            aria-label={service.title}
                        >
                            <h3 class="text-xl font-heading font-semibold text-dark hover:text-primary transition-colors">
                                {service.title}
                            </h3>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <FAQSection items={faqItems} />

    <section class="py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="text-sm text-text-light">
                Все креативные тимбилдинги →
                <a href="/services/team-building/kreativnye" class="underline hover:text-primary">
                    /services/team-building/kreativnye
                </a>
            </p>
        </div>
    </section>
</Layout>
