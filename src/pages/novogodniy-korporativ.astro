---
import Layout from '../components/Layout.astro';

const pageTitle = 'Новогодний корпоратив';
const pageDescription = 'Организация новогоднего корпоратива в Москве и Подмосковье. Новогодние мероприятия 2026 — от камерных банкетов до масштабных шоу.';
---

<Layout title={pageTitle} description={pageDescription}>
    <div class="page-header">
        <div class="container">
            <h1>Новогодний корпоратив 2026</h1>
            <p>Создаём новогоднюю сказку для вашей компании</p>
        </div>
    </div>

    <div class="page-content">
        <div class="container">
            <div class="content-block">
                <h2>Почему выбирают нас</h2>
                <ul>
                    <li>Опыт более 15 лет в организации новогодних мероприятий</li>
                    <li>Собственный театр и команда артистов</li>
                    <li>Полный цикл — от концепции до технического оснащения</li>
                    <li>Более 500 новогодних мероприятий проведено</li>
                </ul>
                
                <h2>Форматы новогоднего корпоратива</h2>
                <ul>
                    <li>Банкет с развлекательной программой</li>
                    <li>Новогоднее шоу с артистами</li>
                    <li>Тематическая вечеринка (80-е, 90-е, Hollywood и др.)</li>
                    <li>Иммерсивное новогоднее шоу</li>
                    <li>Новогодний корпоратив на природе</li>
                </ul>
                
                <div class="cta-box mt-2">
                    <p>Закажите новогодний корпоратив:</p>
                    <a href="tel:+79169064490" class="btn btn-primary">+7 (916) 906-44-90</a>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
.content-block h2 { font-size: var(--font-size-2xl); margin: var(--space-xl) 0 var(--space-md); }
.content-block ul { list-style: disc; padding-left: var(--space-xl); margin-bottom: var(--space-md); }
.content-block li { margin-bottom: var(--space-sm); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); margin-top: var(--space-xl); }
.cta-box p { margin-bottom: var(--space-md); }
</style>