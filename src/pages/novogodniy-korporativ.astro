---
import Layout from "../components/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import PageHero from "../components/sections/PageHero.astro";
import FAQSection from "../components/sections/FAQSection.astro";

const pageTitle =
    "Новогодний корпоратив в Москве — организация и проведение | TT Events";
const pageDescription =
    "Организация новогодних корпоративов в Москве под ключ. Авторские сценарии, шоу-программы, декорации, ведущие и артисты. Работаем с 2006 года.";
const keywords =
    "новогодний корпоратив москва, организация нового года, новогодний корпоратив под ключ, проведение новогоднего корпоратива";

const formats = [
    {
        title: "Новогодний корпоратив в ресторане",
        href: "/novogodniy-korporativ",
        count: 85,
    },
    {
        title: "Новогодний корпоратив в отеле",
        href: "/zimnij-korporativ",
        count: 60,
    },
    {
        title: "Новогодний корпоратив на природе",
        href: "/zimnij-korporativ",
        count: 40,
    },
    { title: "Тематический Новый год", href: "/art-korporativ", count: 50 },
];

const faqItems = [
    {
        question: "Когда нужно бронировать новогодний корпоратив?",
        answer: "Оптимально — за 4-6 месяцев. Лучшие площадки и артисты разбираются заранее, особенно для корпоративов с 100+ гостей.",
    },
    {
        question: "Сколько стоит новогодний корпоратив?",
        answer: "Стоимость от 150 000 ₽ за базовый пакет. Средняя стоимость — 500 000 - 2 000 000 ₽ в зависимости от формата и количества гостей.",
    },
    {
        question: "Можно ли организовать корпоратив на несколько дней?",
        answer: "Да, мы предлагаем multi-day программы: новогодняя ночь + день корпоратива + день после нового года.",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    canonicalURL="/novogodniy-korporativ"
>
    <div class="page-service">
        <!-- Hero Section -->
        <PageHero
            title="Новогодний корпоратив в Москве"
            subtitle="Авторские сценарии и шоу-программы для новогодних корпоративов. Организация под ключ с 2006 года."
            cta={{ label: "Забронировать дату", href: "/kontakty" }}
            backgroundImage="/images/ny-bg.jpg"
        />

        <!-- About Section -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div
                    class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
                >
                    <div>
                        <h2
                            class="text-3xl md:text-4xl font-bold text-dark font-heading mb-6"
                        >
                            Новый год — это время для настоящего праздника
                        </h2>
                        <p class="text-lg text-text-light mb-4">
                            Мы создаём новогодние корпоративы, которые
                            запоминаются надолго. Авторские сценарии, живые
                            выступления, декорации и шоу-программы.
                        </p>
                        <p class="text-lg text-text-light mb-6">
                            Каждый проект разрабатывается индивидуально: от
                            концепции до финального слайдшоу. Мы берём на себя
                            полный цикл — от выбора площадки до координации.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <a href="/kontakty" class="btn-primary"
                                >Получить предложение</a
                            >
                            <a href="/case" class="btn-outline"
                                >Смотреть кейсы</a
                            >
                        </div>
                    </div>
                    <div class="rounded-xl overflow-hidden shadow-card">
                        <img
                            src="/images/ny-main.jpg"
                            alt="Новогодний корпоратив"
                            width="600"
                            height="400"
                            class="w-full h-auto"
                            loading="lazy"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- Formats Grid -->
        <section class="py-16 md:py-24 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2 class="section-title mb-16">
                    Форматы новогоднего корпоратива
                </h2>
                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8"
                >
                    {formats.map((format) => <ServiceCard {...format} />)}
                </div>
            </div>
        </section>

        <!-- Advantages -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h2
                    class="text-3xl md:text-4xl font-bold text-center mb-12 text-dark font-heading"
                >
                    Почему выбирают нас для новогоднего корпоратива
                </h2>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8"
                >
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            200+
                        </div>
                        <h3 class="text-xl font-semibold mb-2">Новых годов</h3>
                        <p class="text-text-light">Проведено корпоративов</p>
                    </div>
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            50+
                        </div>
                        <h3 class="text-xl font-semibold mb-2">
                            Авторовских сценариев
                        </h3>
                        <p class="text-text-light">Уникальные программы</p>
                    </div>
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            100+
                        </div>
                        <h3 class="text-xl font-semibold mb-2">
                            Партнёрских площадок
                        </h3>
                        <p class="text-text-light">Рестораны, отели, лофты</p>
                    </div>
                    <div class="text-center p-6">
                        <div class="text-4xl font-bold text-primary mb-4">
                            100%
                        </div>
                        <h3 class="text-xl font-semibold mb-2">
                            Шоу-программ под ключ
                        </h3>
                        <p class="text-text-light">Артисты, ведущие, декор</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Hub link -->
        <section class="py-6">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <p class="text-sm text-text-light">
                    Все корпоративные мероприятия → <a href="/services/corporate-events" class="underline hover:text-primary">/services/corporate-events</a>
                </p>
            </div>
        </section>

        <!-- FAQ Section -->
        <FAQSection items={faqItems} />
    </div>
</Layout>
