---
import {definePageMeta} from 'astro:content';
import { seo } from '@/components/SEO.astro';

const pageData = {
  title: `TT Events ⭐ event-агентство с 2006 года. Организация корпоративных мероприятий в Москве под ключ`,
  description: `TT Events — event-агентство полного цикла в Москве. Более 2000 проектов с 2006 года: корпоративы, тимбилдинги, launch events, фестивали и арт-концепции. Свой театр, видеопродакшн, сценарии под бизнес-задачи. Звоните: +7 (916) 906-44-90`,
  keywords: `организация корпоративных мероприятий, event агентство москва, tt events, тимбилдинг для компаний, проведение деловых событий, корпоратив в москве, ивент продакшн`,
};

const seoMeta = {
  ogTitle: ``,
  ogDescription: ``,
  ogImage: ``,
};

export const pageMeta = definePageMeta(() => ({
  seo: {
    title: pageData.title,
    description: pageData.description,
    keywords: pageData.keywords,
    ogTitle: seoMeta.ogTitle,
    ogDescription: seoMeta.ogDescription,
    ogImage: seoMeta.ogImage,
  },
}));

export { pageData, seoMeta };
