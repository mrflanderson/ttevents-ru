---
import Layout from '../components/Layout.astro';

const pageTitle = 'TT Events — организация корпоративных мероприятий в Москве';
const pageDescription = 'TT Events — event-агентство полного цикла в Москве. Более 2000 проектов с 2006 года: корпоративы, тимбилдинги, launch events, фестивали и арт-концепции. Свой театр, видеопродакшн, сценарии под бизнес-задачи.';
---

<Layout title={pageTitle} description={pageDescription}>
    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <h1>Организация корпоративных мероприятий в Москве</h1>
            <p>Создаём события, которые объединяют. Опытнее 15 лет, более 2000 реализованных проектов</p>
            
            <div class="hero-cta">
                <a href="/korporativy-moskva" class="btn btn-primary">Выбрать формат</a>
                <a href="/case" class="btn btn-secondary">Смотреть кейсы</a>
            </div>
        </div>
    </section>

    <!-- Services Section -->
    <section class="section">
        <div class="container">
            <h2 class="section-title">Наши услуги</h2>
            <p class="section-subtitle">Полный цикл организации — от идеи до реализации</p>
            
            <div class="grid grid-3">
                <a href="/korporativy-moskva" class="card">
                    <h3 class="card-title">Корпоративы</h3>
                    <p class="card-description">Банкеты, шоу-программы, тематические вечеринки и новогодние мероприятия</p>
                </a>
                
                <a href="/timbilding-moskva" class="card">
                    <h3 class="card-title">Тимбилдинг</h3>
                    <p class="card-description">Командные игры, квесты, спортивные программы и активный отдых</p>
                </a>
                
                <a href="/delovye-meropriyatiya" class="card">
                    <h3 class="card-title">Деловые мероприятия</h3>
                    <p class="card-description">Конференции, форумы, презентации и стратегические сессии</p>
                </a>
                
                <a href="/novogodniy-korporativ" class="card">
                    <h3 class="card-title">Новогодний корпоратив</h3>
                    <p class="card-description">Новогодние мероприятия под ключ — от концепции до новогоднего шоу</p>
                </a>
                
                <a href="/festivali" class="card">
                    <h3 class="card-title">Фестивали</h3>
                    <p class="card-description">Городские мероприятия, open-air события и культурные фестивали</p>
                </a>
                
                <a href="/videoproduction" class="card">
                    <h3 class="card-title">Видеопродакшн</h3>
                    <p class="card-description">Съёмка мероприятий, промо-ролики и документальные фильмы</p>
                </a>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="section stats-section">
        <div class="container">
            <div class="grid grid-4">
                <div class="stat-item">
                    <div class="stat-number">15+</div>
                    <div class="stat-label">лет опыта</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">2000+</div>
                    <div class="stat-label">проектов</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">500+</div>
                    <div class="stat-label">клиентов</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">98%</div>
                    <div class="stat-label">довольных</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Why Us Section -->
    <section class="section">
        <div class="container">
            <h2 class="section-title">Почему выбирают нас</h2>
            
            <div class="grid grid-3">
                <div class="card">
                    <h3 class="card-title">Собственный ресурс</h3>
                    <p class="card-description">Театр, команда артистов, техническое оснащение — всё своё, без посредников</p>
                </div>
                
                <div class="card">
                    <h3 class="card-title">Полный цикл</h3>
                    <p class="card-description">Берём на себя всё — от идеи и сценария до продакшна и видеосъёмки</p>
                </div>
                
                <div class="card">
                    <h3 class="card-title">Опыт</h3>
                    <p class="card-description">Работаем с 2006 года — знаем, как сделать мероприятие успешным</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="section cta-section">
        <div class="container text-center">
            <h2>Хотите организовать мероприятие?</h2>
            <p>Позвоните нам или оставьте заявку — обсудим вашу задачу</p>
            
            <div class="cta-buttons">
                <a href="tel:+79169064490" class="btn btn-primary">Позвонить: +7 (916) 906-44-90</a>
                <a href="mailto:mail@ttevents.ru" class="btn btn-secondary">Написать</a>
            </div>
        </div>
    </section>
</Layout>

<style>
.stats-section {
    background: var(--color-primary);
    color: var(--color-white);
}

.stat-item {
    text-align: center;
}

.stat-number {
    font-size: var(--font-size-4xl);
    font-weight: 700;
    margin-bottom: var(--space-sm);
}

.stat-label {
    font-size: var(--font-size-sm);
    color: #999;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.cta-section {
    background: var(--color-white);
}

.cta-section h2 {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-md);
}

.cta-section p {
    font-size: var(--font-size-lg);
    color: var(--color-secondary);
    margin-bottom: var(--space-xl);
}

.cta-buttons {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
}

@media (max-width: 768px) {
    .cta-buttons {
        flex-direction: column;
        align-items: center;
    }
}
</style>