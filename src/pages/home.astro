<script>
document.addEventListener("DOMContentLoaded", function() {
    function addHeroTitle() {
        if (window.innerWidth > 1024) {
            const videoBlock = document.getElementById('_lp_block_386070316');
            const videoWrap = videoBlock ? videoBlock.querySelector('.lpc-wrap') : null;
            
            if (videoWrap && !document.getElementById('hero-top-title-wrapper')) {
                const wrapper = document.createElement('div');
                wrapper.id = 'hero-top-title-wrapper';
                wrapper.className = 'lpc-elements-headline__title lp-header-title-2';
                
                const p = document.createElement('p');
                p.id = 'hero-top-title-text';
                
                const text = "Организация корпоративных мероприятий в Москве и по России";
                
                // 1. Сначала разбиваем на слова, чтобы они не рвались на Windows
                p.innerHTML = text.split(' ').map(word => {
                    // 2. Каждое слово разбиваем на буквы и добавляем класс .anim-letter
                    const letters = word.split('').map(letter => {
                        return `<span class="anim-letter">${letter}</span>`;
                    }).join('');
                    return `<span class="word-no-wrap">${letters}</span>`;
                }).join(' ');
                
                // 3. Рассчитываем задержку для каждой буквы по порядку
                setTimeout(() => {
                    const allLetters = p.querySelectorAll('.anim-letter');
                    allLetters.forEach((span, i) => {
                        span.style.animationDelay = `${i * 0.05}s`;
                    });
                }, 10);

                wrapper.appendChild(p);
                videoWrap.prepend(wrapper);
            }
        }
    }
    addHeroTitle();
    window.addEventListener('resize', addHeroTitle);
});
</script>

