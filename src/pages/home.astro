// === БЫСТРЫЙ HERO (запуск максимально рано) ===
(function() {
    'use strict';

    function createFastHero() {
        // Если hero уже создан — выходим
        if (document.getElementById('fast-hero-wrapper')) return;

        const hero = document.createElement('div');
        hero.id = 'fast-hero-wrapper';
        hero.className = 'total-hero-layout';

        hero.innerHTML = `
            <video id="hero-bg-video" muted playsinline loop preload="metadata" poster="https://ttevents.ru/d/hero.jpg">
                <source src="/f/hero_april_leaks.mp4" type="video/mp4">
            </video>
            <div class="v-gradient-top"></div>
            
            <div class="hero-text-center">
                <h1 class="hero-main-title">
                    Агентство корпоративных событий<br>
                    <span>Режиссёрские корпоративы — события, где бренд становится героем.</span>
                </h1>
                
                <div class="hero-btn-wrap">
                    <a href="tel:+7(916)906-44-90" class="custom-hero-btn">
                        Запланировать мероприятие<br>+7 916 906-44-90
                    </a>
                </div>
            </div>

            <div class="v-table-layout">
                <div id="portal-top" class="v-row"></div>
            </div>
        `;

        // Вставляем в самое начало body (самый ранний момент)
        document.body.prepend(hero);

        // Переносим логотип и меню (самое важное для тебя)
        const logoBlock = document.getElementById('i6ir0gpws_0');
        const menuBlock = document.getElementById('i8nnrl3h0_0');
        const portal = document.getElementById('portal-top');

        if (logoBlock && portal) portal.appendChild(logoBlock);
        if (menuBlock && portal && window.innerWidth > 1024) portal.appendChild(menuBlock);

        // Лёгкий запуск видео (без autoplay на мобильных)
        const video = document.getElementById('hero-bg-video');
        if (video && window.innerWidth > 1024) {
            video.play().catch(() => {});
        }

        // Один раз на resize — чтобы не спамить
        let resized = false;
        window.addEventListener('resize', () => {
            if (!resized) {
                resized = true;
                if (menuBlock && portal) {
                    if (window.innerWidth > 1024) {
                        portal.appendChild(menuBlock);
                    }
                }
            }
        }, { once: true });
    }

    // Запуск максимально рано
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', createFastHero);
    } else {
        createFastHero();
    }
})();
</script>
