<script>
(function() {
    // 1. Настройки идентификации Hero-видео
    const isHero = (v) => v.closest('.tt-hero-section') || v.id === 'hero-direct-video';

    // Функция для выключения звука и паузы у всех, кроме активного
    const stopOthers = (currentVideo) => {
        document.querySelectorAll('video').forEach(v => {
            if (v !== currentVideo && !isHero(v)) {
                v.pause();
                v.muted = true;
            }
        });
    };

    // 2. Умный скролл: запуск при появлении, стоп и мут при уходе
    const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            const video = entry.target;
            if (entry.isIntersecting) {
                // При скролле всегда сбрасываем звук (кроме случаев, когда пользователь уже нажал)
                // Но для безопасности принудительно мутим, если видео только появилось
                if (!video.dataset.userInteracted) {
                    video.muted = true;
                }
                video.play().catch(() => {});
            } else {
                // Ушло с экрана — пауза и сброс звука
                video.pause();
                video.muted = true;
                video.dataset.userInteracted = ""; // Сбрасываем флаг взаимодействия
            }
        });
    }, { threshold: 0.1 });

    // Инициализация: чистим видео от интерфейса и ставим на репит
    const initVideos = () => {
        document.querySelectorAll('video').forEach(v => {
            if (!v.dataset.observed) {
                v.muted = true;
                v.loop = true;                 // Зацикливание
                v.autoplay = true;             // Автозапуск
                v.removeAttribute('controls');   // Убираем кнопки плеера
                v.setAttribute('playsinline', ''); 
                v.setAttribute('webkit-playsinline', '');

                // Убираем контекстное меню (правая кнопка / долгий тап на мобилке)
                v.addEventListener('contextmenu', e => e.preventDefault());

                videoObserver.observe(v);
                v.dataset.observed = "true";
            }
        });
    };

    // 3. Обработка клика: Звук ВКЛ/ВЫКЛ + Одно окно
    document.addEventListener('click', function(e) {
        const video = e.target.closest('video');
        if (!video || isHero(video)) return;

        // Предотвращаем стандартные действия браузера
        e.preventDefault();

        if (video.muted) {
            // ВКЛЮЧАЕМ ЗВУК
            stopOthers(video); 
            video.muted = false;
            video.volume = 1.0;
            video.dataset.userInteracted = "true"; // Помечаем, что юзер включил звук
            video.play();
        } else {
            // ВЫКЛЮЧАЕМ ЗВУК
            video.muted = true;
            video.dataset.userInteracted = "";
        }
    }, true);

    // Запуск при загрузке
    initVideos();

    // Следим за динамическим контентом (если CMS подгружает блоки)
    const fastRefresh = setInterval(initVideos, 1000);
    setTimeout(() => clearInterval(fastRefresh), 8000);
})();
</script>

