<script>
(function() {
    const TARGET_ID = '_lp_block_261947316';

    function rebuildMobilePartners() {
        // Проверяем, что мы на мобилке
        if (window.innerWidth > 768) return;

        const oldBlock = document.getElementById(TARGET_ID);
        if (!oldBlock) return;

        // Собираем все логотипы
        const imgElements = oldBlock.querySelectorAll('img');
        const images = [];
        
        imgElements.forEach(img => {
            const src = img.getAttribute('data-src') || img.getAttribute('src');
            if (src && !src.includes('spacer.gif') && !images.includes(src)) {
                images.push(src);
            }
        });

        if (images.length === 0) return;

        // Создаем мобильную версию
        const mobContainer = document.createElement('div');
        mobContainer.className = 'v-mobile-grid-container';
        
        mobContainer.innerHTML = `
            <div class="v-partners-header-mob">
                <h2 class="v-partners-title-mob">Партнеры<span>.</span></h2>
            </div>
            <div class="v-partners-grid-mob">
                ${images.map(src => `
                    <div class="v-partner-item-mob">
                        <img src="${src}" alt="partner">
                    </div>
                `).join('')}
            </div>
        `;

        // Вставляем новую сетку в начало блока
        oldBlock.prepend(mobContainer);
    }

    // Запуск после загрузки
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', rebuildMobilePartners);
    } else {
        setTimeout(rebuildMobilePartners, 800);
    }
})();
</script>



