---
import Layout from '../components/Layout.astro';

const pageTitle = 'Тимбилдинг на природе';
const pageDescription = 'Выездной тимбилдинг за городом. Активный отдых, программы на природе, базы отдыха.';
const keywords = 'тимбилдинг на природе, выездной тимбилдинг, активный отдых, база отдыха';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Тимбилдинг на природе</h1>
            <p>Выездные программы за городом</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <p>Тимбилдинг на природе — идеальное сочетание отдыха и командной работы:</p>
            <ul class="feature-list mt-2">
                <li>Базы отдыха</li>
                <li>Программы на свежем воздухе</li>
                <li>Походы и пикники</li>
                <li>Комплексный отдых</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Заказать программу</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.feature-list li { margin-bottom: var(--space-sm); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>