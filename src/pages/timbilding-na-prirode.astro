---
import Layout from "../components/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import FAQ from "../components/FAQ.astro";

const pageTitle =
    "Тимбилдинг на природе в Москве — выездной корпоратив, активные квесты и командные игры | TT Events";
const pageDescription =
    "Организация тимбилдинга на природе и выездных корпоративов в Москве и Подмосковье. Активные форматы, веревочные курсы, квесты, спортивные игры. Цены от 900 000 ₽ за 50 человек. Расчёт за 1 день";
const keywords =
    "тимбилдинг на природе москва, выездной корпоратив, активный тимбилдинг, веревочный курс, квест на природе, спортивные игры";

const services = [
    { title: "Веревочный курс", href: "/timbilding-na-prirode", count: 65 },
    { title: "Активный квест", href: "/kvesty-i-igry", count: 50 },
    { title: "Спортивные игры", href: "/sportivnye-meropriyatiya", count: 55 },
    {
        title: "Корпоративный пикник",
        href: "/korporativ-na-prirode",
        count: 70,
    },
    {
        title: "Командные соревнования",
        href: "/timbilding-na-prirode",
        count: 40,
    },
    { title: "Кемпинг-мероприятие", href: "/korporativ-na-prirode", count: 35 },
];

const faqItems = [
    {
        question: "Где проходят мероприятия на природе?",
        answer: "Подмосковье: базы отдыха, загородные клубы, веревочные курсы, парки. Все площадки проверены и оборудованы.",
    },
    {
        question: "Сколько стоит тимбилдинг на природе?",
        answer: "От 900 000 ₽ за 50 человек. Стоимость зависит от формата, площадки и продолжительности.",
    },
    {
        question: "Можно ли организовать мероприятие зимой?",
        answer: "Да, мы организуем зимние тимбилдинги с активными программами для любой погоды.",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    canonicalURL="/timbilding-na-prirode"
>
    <!-- Hero Section -->
    <section
        class="relative min-h-[500px] md:min-h-[600px] flex items-center text-white overflow-hidden"
    >
        <img
            src="/images/timbild-ing-nature-hero.jpg"
            alt="Тимбилдинг на природе — выездной корпоратив"
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>

        <div
            class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full"
        >
            <div class="max-w-[800px]">
                <nav class="text-sm text-text-light mb-4">
                    <a href="/" class="hover:text-primary">Главная</a> / <a
                        href="/korporativy-moskva"
                        class="hover:text-primary">Услуги</a
                    > / <span class="font-medium text-text"
                        >Тимбилдинг на природе</span
                    >
                </nav>
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6"
                >
                    Тимбилдинг на природе в Москве
                </h1>
                <p class="text-lg md:text-xl text-white/90 mb-10">
                    Организация выездных тимбилдингов и корпоративов на природе.
                    Активные квесты, веревочные курсы, командные игры и
                    спортивные активности.
                </p>
                <a
                    href="/kontakty"
                    class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg hover:shadow-xl transition-all duration-300"
                >
                    Получить предложение
                </a>
            </div>
        </div>
    </section>

    <!-- Content Section -->
    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="prose prose-lg max-w-none">
                <h2
                    class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                >
                    Форматы тимбилдинга на природе
                </h2>
                <p class="text-lg text-text-light mb-8">
                    TT Events организует тимбилдинги на природе для корпоративов
                    в Москве и по всей России. Мы предлагаем разнообразные
                    форматы — от активных квестов до спокойных семейных
                    пикников.
                </p>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12"
                >
                    {services.map((service) => <ServiceCard {...service} />)}
                </div>

                <h2
                    class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                >
                    Как мы работаем
                </h2>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12"
                >
                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            01
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Брифинг
                        </h3>
                        <p class="text-text-light text-sm">
                            Определяем цели, интересы и формат мероприятия.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            02
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Подбор площадки
                        </h3>
                        <p class="text-text-light text-sm">
                            Выбираем подходящие локации в Подмосковье.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            03
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Организация
                        </h3>
                        <p class="text-text-light text-sm">
                            Транспорт, питание, инвентарь и безопасность.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            04
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Проведение
                        </h3>
                        <p class="text-text-light text-sm">
                            Профессиональное сопровождение программы.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            05
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Отчёт
                        </h3>
                        <p class="text-text-light text-sm">
                            Сбор обратной связи и фотоотчёт.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 md:py-24 bg-gray-50">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2
                    class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4"
                >
                    Часто задаваемые вопросы
                </h2>
            </div>

            <div class="space-y-4">
                {
                    faqItems.map((item) => (
                        <div class="bg-white rounded-xl p-6 shadow-card">
                            <details>
                                <summary class="font-heading font-semibold cursor-pointer text-dark mb-2">
                                    {item.question}
                                </summary>
                                <p class="text-text-light">{item.answer}</p>
                            </details>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section
        class="relative min-h-[400px] flex items-center text-white overflow-hidden py-24"
    >
        <img
            src="/images/timbild-ing-nature-hero.jpg"
            alt=""
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-primary/80"></div>

        <div
            class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center"
        >
            <h2
                class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-6"
            >
                Свяжитесь с нами
            </h2>
            <p class="text-lg md:text-xl text-white/90 mb-10 max-w-2xl mx-auto">
                Предложим формат и рассчитаем бюджет в течение 1 дня
            </p>
            <div
                class="flex flex-col sm:flex-row gap-4 justify-center items-center"
            >
                <a
                    href="tel:+79169064490"
                    class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-white hover:bg-white/90 text-primary shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                >
                    +7 (916) 906-44-90
                </a>
                <a
                    href="/kontakty"
                    class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-transparent border-2 border-white hover:bg-white hover:text-primary text-white shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                >
                    Оставить заявку
                </a>
            </div>
        </div>
    </section>
</Layout>
