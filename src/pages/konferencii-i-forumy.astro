---
import Layout from "../components/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import FAQ from "../components/FAQ.astro";

const pageTitle =
    "Конференции и форумы в Москве — организация деловых мероприятий | TT Events";
const pageDescription =
    "Организация конференций и форумов в Москве: стратегические сессии, семинары, тренинги, MICE. Профессиональный подход с 2006 года.";
const keywords =
    "конференции москва, форум организация, деловые мероприятия москва, стратегические сессии, семинары тренинги";

const formats = [
    { title: "Конференции и форумы", href: "/konferencii-i-forumy", count: 45 },
    {
        title: "Стратегические сессии",
        href: "/strategicheskie-sessii-i-vorkshopy",
        count: 30,
    },
    { title: "Семинары и тренинги", href: "/seminary-i-treningi", count: 55 },
    { title: "MICE и деловой туризм", href: "/mice-delovoj-turizm", count: 25 },
    {
        title: "Презентации и Launch Events",
        href: "/prezentacii-novyh-produktov-launch-events",
        count: 40,
    },
    { title: "Мастер-классы", href: "/master-klassy", count: 35 },
];

const faqItems = [
    {
        question: "Какой размер конференции вы можете организовать?",
        answer: "От камерных встреч на 20 человек до форумов на 5000+ участников. Мы адаптируем формат под ваши задачи.",
    },
    {
        question: "Что входит в организацию конференции?",
        answer: "Полный цикл: подбор площадки, техническое оснащение, регистрация участников, организация питания, программа, координация в день мероприятия.",
    },
    {
        question: "Работаете ли вы с государственными структурами?",
        answer: "Да, мы регулярно работаем с государственными организациями, включая тендеры и госзакупки по 44-ФЗ и 223-ФЗ.",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    canonicalURL="/konferencii-i-forumy"
>
    <!-- Hero Section -->
    <section
        class="relative min-h-[500px] md:min-h-[600px] flex items-center text-white overflow-hidden"
    >
        <img
            src="/images/conf-bg.jpg"
            alt="Конференции и форумы в Москве"
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>

        <div
            class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full"
        >
            <div class="max-w-[800px]">
                <nav class="text-sm text-text-light mb-4">
                    <a href="/" class="hover:text-primary">Главная</a> / <a
                        href="/konferencii-i-forumy"
                        class="hover:text-primary">Услуги</a
                    > / <span class="font-medium text-text"
                        >Конференции и форумы</span
                    >
                </nav>
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6"
                >
                    Конференции и форумы в Москве
                </h1>
                <p class="text-lg md:text-xl text-white/90 mb-10">
                    Организация деловых мероприятий любого масштаба.
                    Стратегические сессии, семинары, MICE и Launch Events.
                </p>
                <a
                    href="/kontakty"
                    class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg hover:shadow-xl transition-all duration-300"
                >
                    Обсудить проект
                </a>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
                <div>
                    <h2
                        class="text-3xl md:text-4xl font-bold text-dark font-heading mb-6"
                    >
                        Деловые мероприятия — это стратегия вашего бизнеса
                    </h2>
                    <p class="text-lg text-text-light mb-4">
                        Конференции и форумы — это не просто сбор людей в одном
                        месте. Это инструмент для достижения бизнес-целей:
                        нетворкинг, обучение, презентация новых идей.
                    </p>
                    <p class="text-lg text-text-light mb-6">
                        Мы проектируем деловые мероприятия под конкретные задачи
                        клиента: от стратегических сессий до масштабных
                        отраслевых форумов.
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <a href="/kontakty" class="btn-primary"
                            >Получить предложение</a
                        >
                        <a href="/case" class="btn-outline">Смотреть кейсы</a>
                    </div>
                </div>
                <div class="rounded-xl overflow-hidden shadow-card">
                    <img
                        src="/images/conf-main.jpg"
                        alt="Конференция в Москве"
                        width="600"
                        height="400"
                        class="w-full h-auto"
                        loading="lazy"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- Formats Grid -->
    <section class="py-16 md:py-24 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="section-title mb-16">Форматы деловых мероприятий</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {formats.map((format) => <ServiceCard {...format} />)}
            </div>
        </div>
    </section>

    <!-- Advantages -->
    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2
                class="text-3xl md:text-4xl font-bold text-center mb-12 text-dark font-heading"
            >
                Почему выбирают TT Events для деловых мероприятий
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="text-center p-6">
                    <div class="text-4xl font-bold text-primary mb-4">20+</div>
                    <h3 class="text-xl font-semibold mb-2">Лет опыта</h3>
                    <p class="text-text-light">
                        Организация деловых мероприятий
                    </p>
                </div>
                <div class="text-center p-6">
                    <div class="text-4xl font-bold text-primary mb-4">500+</div>
                    <h3 class="text-xl font-semibold mb-2">
                        Проведённых конференций
                    </h3>
                    <p class="text-text-light">Масштаб от 20 до 5000+ гостей</p>
                </div>
                <div class="text-center p-6">
                    <div class="text-4xl font-bold text-primary mb-4">100+</div>
                    <h3 class="text-xl font-semibold mb-2">
                        Площадок-партнёров
                    </h3>
                    <p class="text-text-light">Конференц-залы, отели, лофты</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Hub link -->
    <section class="py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="text-sm text-text-light">
                Все деловые мероприятия / MICE → <a href="/services/mice-business" class="underline hover:text-primary">/services/mice-business</a>
            </p>
        </div>
    </section>

    <!-- FAQ Section -->
    <FAQ items={faqItems} />
</Layout>
