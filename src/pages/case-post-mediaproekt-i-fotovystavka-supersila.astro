---
import Layout from "../components/Layout.astro";

const pageMeta = {
    title: "Медиапроект «Суперсила» — фотовыставка для НКО | TT Events",
    description:
        "Медиапроект и городская фотовыставка «Суперсила» для НКО. История 10 героев некоммерческого сектора, которые меняют жизнь города.",
    ogTitle: "Медиапроект «Суперсила» — фотовыставка для НКО | TT Events",
    ogDescription:
        "Масштабный медиапроект и городская фотовыставка, посвящённая людям из некоммерческого сектора.",
};

const caseImage = "/images/supersila_logo.jpg";
const caseVideo = "/video/m24_v2.mp4";

const keyStats = [
    { value: "10", label: "героев НКО" },
    { value: "1.3 млн", label: "охват" },
    { value: "14", label: "дней выставки" },
    { value: "3", label: "площадки" },
];

const services = [
    {
        title: "Концепция медиапроекта",
        description: "Разработка идеи и визуальной концепции",
    },
    {
        title: "Видеосъёмка",
        description: "Интервью с героями и создание видеоисторий",
    },
    {
        title: "Фотовыставка",
        description:
            "Организация городской фотовыставки на Рождественском бульваре",
    },
    {
        title: "Документальный спектакль",
        description: "«Люди добрые» с Олегом Куксовским",
    },
    {
        title: "Деловая программа",
        description: "Панельные дискуссии и бизнес-завтраки",
    },
    {
        title: "Медиапродвижение",
        description: "Освещение на mos.ru, asi.org.ru, nkocenter.ru",
    },
];

const faqItems = [
    {
        question: "Что включено в организацию медиапроекта?",
        answer: "Разработка концепции, видеосъёмка, фотография, организация выставки, деловой программы и медиапродвижение.",
    },
    {
        question: "Сколько длится подготовка к проекту?",
        answer: "От 3 до 6 месяцев в зависимости от масштаба. Для медиапроекта важно время на съёмку и монтаж.",
    },
    {
        question: "Можно ли адаптировать проект под нашу организацию?",
        answer: "Да, мы создаём проекты под ключ для любых НКО, фондов и социальных инициатив.",
    },
];

const partners = [
    { name: "Благотворительный фонд Владимира Потанина" },
    { name: "АНО «Культурный центр исторической реконструкции»" },
    {
        name: "Благотворительный фонд «Вместе можем все»",
    },
    { name: "Режиссёр Олег Куксовский" },
];
---

<!--
  TT Events — Tailwind CSS Migration
  Generated on: 2026-05-17
--><!--
  TT Events — Tailwind CSS Migration
  Generated on: 2026-05-17
-->
<Layout {...pageMeta}>
    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4" aria-label="Навигация">
                <a href="/" class="hover:text-primary">Главная</a> /
                <a href="/case" class="hover:text-primary">Кейсы</a> /
                <span class="font-medium text-text" aria-current="page">
                    Медиапроект
                </span>
            </nav>

            <div class="grid lg:grid-cols-2 gap-12 items-start">
                <div>
                    <h1
                        class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-6"
                    >
                        Медиапроект «Суперсила»
                    </h1>
                    <p class="text-lg text-text-light mb-8">
                        Масштабный медиапроект и городская фотовыставка в
                        Москве, посвящённая 10 героям НКО — волонтёрам, руков
                        одителям фондов и социальных инициатив, которые ежедн
                        евно меняют жизнь города.
                    </p>

                    <div class="flex flex-wrap gap-4 mb-8">
                        <a
                            href="/kontakty"
                            class="px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors font-semibold"
                        >
                            Обсудить проект
                        </a>
                        <a
                            href="/video"
                            class="px-6 py-3 border-2 border-dark text-dark rounded-lg hover:bg-dark hover:text-white transition-all font-semibold"
                        >
                            Смотреть видео
                        </a>
                    </div>
                </div>

                <div>
                    <div
                        class="relative rounded-xl overflow-hidden shadow-card"
                    >
                        <img
                            src={caseImage}
                            alt="Медиапроект Суперсила фотовыставка НКО Москва"
                            width="800"
                            height="500"
                            class="w-full h-auto"
                        />
                        <div
                            class="absolute inset-0 bg-black/30 flex items-center justify-center"
                        >
                            <video
                                src={caseVideo}
                                controls
                                class="w-3/4 max-w-md"
                            >
                                Ваш браузер не поддерживает видео.
                            </video>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2
                class="text-2xl md:text-3xl font-bold text-dark font-heading mb-12 text-center"
            >
                Ключевые показатели проекта
            </h2>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
                {
                    keyStats.map((stat) => (
                        <div class="text-center">
                            <div class="text-4xl md:text-5xl font-bold text-primary font-heading mb-2">
                                {stat.value}
                            </div>
                            <div class="text-text-light">{stat.label}</div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2
                class="text-2xl md:text-3xl font-bold text-dark font-heading mb-12 text-center"
            >
                Что было сделано
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    services.map((service) => (
                        <div class="bg-white rounded-xl shadow-card p-8 hover:shadow-card-hover transition-all duration-300">
                            <h3 class="text-xl font-heading font-semibold text-dark mb-4">
                                {service.title}
                            </h3>
                            <p class="text-text-light leading-relaxed">
                                {service.description}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2
                class="text-2xl md:text-3xl font-bold text-dark font-heading mb-12 text-center"
            >
                Ключевые участники
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {
                    partners.map((partner) => (
                        <div class="bg-white rounded-xl shadow-card p-8">
                            <h3 class="text-xl font-heading font-semibold text-dark">
                                {partner.name}
                            </h3>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <section class="py-16 md:py-24 bg-gray-50">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2
                class="text-2xl md:text-3xl font-bold text-dark font-heading mb-8 text-center"
            >
                Часто задаваемые вопросы
            </h2>
            <div class="divide-y divide-gray-200">
                {
                    faqItems.map((item) => (
                        <div class="py-4">
                            <details>
                                <summary class="font-semibold cursor-pointer text-dark list-none">
                                    {item.question}
                                </summary>
                                <p class="mt-2 text-text-light leading-relaxed">
                                    {item.answer}
                                </p>
                            </details>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
