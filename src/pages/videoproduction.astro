---
import Layout from '../components/Layout.astro';

const pageTitle = 'Видеопродакшн — Съёмка мероприятий';
const pageDescription = 'Видеопродакшн в Москве: съёмка мероприятий, промо-ролики, документальные фильмы, корпоративные фильмы. Профессиональная команда.';
const keywords = 'видеопродакшн, съёмка мероприятий, промо ролик, документальный фильм, корпоративное видео';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Видеопродакшн</h1>
            <p>Профессиональная видеосъёмка ваших мероприятий</p>
        </div>
    </div>

    <div class="page-content">
        <div class="container">
            <h2 class="section-title">Услуги</h2>
            <div class="grid grid-3">
                <div class="service-card">
                    <h3>Съёмка мероприятий</h3>
                    <p>Полная документация события</p>
                </div>
                <div class="service-card">
                    <h3>Промо-ролики</h3>
                    <p>Маркетинговые видео для компаний</p>
                </div>
                <div class="service-card">
                    <h3>Документальные фильмы</h3>
                    <p>Фильмы о компании и проектах</p>
                </div>
            </div>
            
            <div class="cta-box mt-3 text-center">
                <p>Нужна видеосъёмка?</p>
                <a href="tel:+79169064490" class="btn btn-primary">Позвонить: +7 (916) 906-44-90</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.service-card { background: var(--color-white); padding: var(--space-lg); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
.service-card h3 { font-size: var(--font-size-base); margin-bottom: var(--space-sm); }
.service-card p { font-size: var(--font-size-sm); color: var(--color-secondary); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
.cta-box p { margin-bottom: var(--space-md); }
</style>