---
import Layout from "../components/Layout.astro";
import CaseCard from "../components/CaseCard.astro";

const pageTitle =
    "Видеопродакшн — организация видеосъёмки мероприятий в Москве";
const pageDescription =
    "Профессиональная видеосъёмка корпоративных мероприятий, создание промо-роликов, aftermovie и трансляций. Видеопродакшн под ключ в Москве.";
const keywords =
    "видеопродакшн москва, видеосъёмка мероприятий, aftermovie, промо-ролики, live streaming, event production";

const videoCases = [
    {
        title: "Open-air в Гребнево — SLAVA SKRIPKA",
        href: "/case/open-air-slava-skripka-bober-2025",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
    },
    {
        title: "Ретро-фестиваль «Время надежд» — Звенигород 2025",
        href: "/case/vremnadezhdfest2025",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
    },
    {
        title: "Art-pop для «Метриум» — Новый год 2026",
        href: "/case/artpop",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
    },
];

const services = [
    {
        title: "Корпоративные мероприятия",
        href: "/korporativy-moskva",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
        count: 450,
    },
    {
        title: "Тимбилдинги",
        href: "/timbilding-moskva",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
        count: 380,
    },
    {
        title: "Фестивали",
        href: "/festivaly-i-gorodskie-meropriyatiya",
        image: "/g/s3/mosaic/images/hero-bg.jpg",
        count: 150,
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    ogTitle={pageTitle}
    ogDescription={pageDescription}
>
    <div class="page-content">
        <!-- Hero Section -->
        <section
            class="relative min-h-[500px] md:min-h-[600px] flex items-center text-white overflow-hidden"
        >
            <img
                src="/g/s3/mosaic/images/hero-bg.jpg"
                alt="Видеопродакшн — видеосъёмка мероприятий"
                class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-black/50"></div>

            <div
                class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full"
            >
                <div class="max-w-[800px]">
                    <nav class="text-sm text-text-light mb-4">
                        <a href="/" class="hover:text-primary">Главная</a> / <span
                            class="font-medium text-text">Видеопродакшн</span
                        >
                    </nav>
                    <h1
                        class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6"
                    >
                        Видеопродакшн мероприятий в Москве
                    </h1>
                    <p class="text-lg md:text-xl text-white/90 mb-10">
                        Профессиональная видеосъёмка, создание промо-роликов,
                        aftermovie и live-трансляций для корпоративных событий.
                    </p>
                    <a
                        href="/kontakty"
                        class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg hover:shadow-xl transition-all duration-300"
                    >
                        Получить расчёт бюджета
                    </a>
                </div>
            </div>
        </section>

        <!-- Content Section -->
        <section class="py-16 md:py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="prose prose-lg max-w-none">
                    <h2
                        class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                    >
                        Наши услуги видеопродакшн
                    </h2>
                    <p class="text-lg text-text-light mb-8">
                        TT Events предлагает полный цикл видеопроизводства для
                        мероприятий: от предварительной подготовки до
                        постпродакшна. Мы работаем с профессиональным
                        оборудованием и командой опытных операторов и
                        монтажеров.
                    </p>

                    <!-- Services Grid -->
                    <h2
                        class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                    >
                        Форматы мероприятий
                    </h2>
                    <div
                        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12"
                    >
                        {
                            services.map((service) => (
                                <ServiceCard {...service} />
                            ))
                        }
                    </div>

                    <!-- Video Cases -->
                    <h2
                        class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                    >
                        Видео наших мероприятий
                    </h2>
                    <div
                        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12"
                    >
                        {
                            videoCases.map((caseItem) => (
                                <CaseCard
                                    title={caseItem.title}
                                    href={caseItem.href}
                                    image={caseItem.image}
                                />
                            ))
                        }
                    </div>

                    <div class="text-center mt-12">
                        <a
                            href="/case"
                            class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-transparent border-2 border-primary text-primary hover:bg-primary hover:text-white shadow-lg hover:shadow-xl transition-all duration-300"
                        >
                            Смотреть все кейсы →
                        </a>
                    </div>

                    <!-- Process Section -->
                    <h2
                        class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6 mt-12"
                    >
                        Как мы работаем
                    </h2>
                    <div
                        class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8"
                    >
                        <div class="bg-white rounded-xl p-6 shadow-card">
                            <div class="text-primary text-2xl font-bold mb-3">
                                01
                            </div>
                            <h3 class="text-lg font-heading font-semibold mb-2">
                                Брифинг
                            </h3>
                            <p class="text-text-light text-sm">
                                Определяем цели, форматы и техническое
                                оборудование.
                            </p>
                        </div>

                        <div class="bg-white rounded-xl p-6 shadow-card">
                            <div class="text-primary text-2xl font-bold mb-3">
                                02
                            </div>
                            <h3 class="text-lg font-heading font-semibold mb-2">
                                Планирование
                            </h3>
                            <p class="text-text-light text-sm">
                                Составляем план съёмки и распределяем команды.
                            </p>
                        </div>

                        <div class="bg-white rounded-xl p-6 shadow-card">
                            <div class="text-primary text-2xl font-bold mb-3">
                                03
                            </div>
                            <h3 class="text-lg font-heading font-semibold mb-2">
                                Съёмка
                            </h3>
                            <p class="text-text-light text-sm">
                                Профессиональная работа на мероприятии.
                            </p>
                        </div>

                        <div class="bg-white rounded-xl p-6 shadow-card">
                            <div class="text-primary text-2xl font-bold mb-3">
                                04
                            </div>
                            <h3 class="text-lg font-heading font-semibold mb-2">
                                Монтаж
                            </h3>
                            <p class="text-text-light text-sm">
                                Постпродакшн, цветокоррекция и озвучка.
                            </p>
                        </div>

                        <div class="bg-white rounded-xl p-6 shadow-card">
                            <div class="text-primary text-2xl font-bold mb-3">
                                05
                            </div>
                            <h3 class="text-lg font-heading font-semibold mb-2">
                                Доставка
                            </h3>
                            <p class="text-text-light text-sm">
                                Передача материалов в нужном формате.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section
            class="relative min-h-[400px] flex items-center text-white overflow-hidden py-24"
        >
            <img
                src="/g/s3/mosaic/images/hero-bg.jpg"
                alt=""
                class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-primary/80"></div>

            <div
                class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center"
            >
                <h2
                    class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-6"
                >
                    Свяжитесь с нами
                </h2>
                <p
                    class="text-lg md:text-xl text-white/90 mb-10 max-w-2xl mx-auto"
                >
                    Предложим формат и рассчитаем бюджет в течение 1 дня
                </p>
                <div
                    class="flex flex-col sm:flex-row gap-4 justify-center items-center"
                >
                    <a
                        href="tel:+79169064490"
                        class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-white hover:bg-white/90 text-primary shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                    >
                        +7 (916) 906-44-90
                    </a>
                    <a
                        href="/kontakty"
                        class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-transparent border-2 border-white hover:bg-white hover:text-primary text-white shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                    >
                        Оставить заявку
                    </a>
                </div>
            </div>
        </section>
    </div>
</Layout>
