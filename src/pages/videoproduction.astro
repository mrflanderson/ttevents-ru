---
import Layout from "../components/Layout.astro";
import VideoEmbed from "../components/VideoEmbed.astro";

const pageTitle = "Видеопродакшн — Съёмка мероприятий";
const pageDescription = "Видеопродакшн — Съёмка мероприятий";
const keywords = "видеопродакшн съемка мероприятий";

const videos = [
    { title: "Фестиваль в усадьбе Гребнево", rutubeId: "f0b706510e465edc5155e9ca1be02800" },
    { title: "Launch Event UMG E225C", rutubeId: "e6311c985851b05bfb83c740b4006eda" },
    { title: "Ретро-фестиваль «Время надежд»", rutubeId: "d559ee884143efe2dec04ddb2cedbb04" },
    { title: "Арт-корпоратив «Метриум»", rutubeId: "e8a8e9049512fa779194e2610bbd7027" },
];
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords} canonicalURL="/videoproduction">
    <div class="py-16 md:py-24">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4">
                <a href="/" class="hover:text-primary">Главная</a> / <a
                    href="/mediproekty"
                    class="hover:text-primary">Медиапроекты</a
                > / <span class="font-medium text-text">Видеопродакшн</span>
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Видеопродакшн
            </h1>
            <div class="prose prose-lg max-w-none mb-12">
                <p class="text-lg text-text-light">
                    Видеопродакшн — Съёмка мероприятий
                </p>
                <p class="text-text-light mt-4">
                    Мы создаём профессиональное видео для корпоративных событий, фестивалей, launch events и других мероприятий.
                    Каждый проект — это уникальная история, рассказанная через камеру.
                </p>
            </div>

            <!-- Video Gallery -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {videos.map((video) => (
                    <div class="bg-white rounded-xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300">
                        <VideoEmbed rutubeId={video.rutubeId} />
                        <div class="p-6">
                            <h3 class="text-xl font-heading font-semibold text-dark mb-2">
                                {video.title}
                            </h3>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
    <section class="py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="text-sm text-text-light">
                Event + Media → <a href="/media" class="underline hover:text-primary">/media</a>
            </p>
        </div>
    </section>
</Layout>
