---
import Layout from '../components/Layout.astro';

const pageTitle = 'Фестивали и городские мероприятия';
const pageDescription = 'Организация городских мероприятий, фестивалей и open-air событий в Москве. Массовые мероприятия, концерты, городские праздники.';
const keywords = 'фестиваль, городские мероприятия, open-air, концерт, массовые мероприятия';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Фестивали и городские мероприятия</h1>
            <p>Создаём яркие события для большой аудитории</p>
        </div>
    </div>

    <div class="page-content">
        <div class="container">
            <h2 class="section-title">Наши возможности</h2>
            <div class="grid grid-3">
                <div class="service-card">
                    <h3>Городские фестивали</h3>
                    <p>Массовые мероприятия для жителей города</p>
                </div>
                <div class="service-card">
                    <h3>Open-air события</h3>
                    <p>Концерты и мероприятия на открытом воздухе</p>
                </div>
                <div class="service-card">
                    <h3>Культурные мероприятия</h3>
                    <p>Выставки, ярмарки, арт-проекты</p>
                </div>
            </div>
            
            <div class="cta-box mt-3 text-center">
                <p>Хотите организовать фестиваль?</p>
                <a href="tel:+79169064490" class="btn btn-primary">Позвонить: +7 (916) 906-44-90</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.service-card { background: var(--color-white); padding: var(--space-lg); border-radius: var(--radius-md); box-shadow: var(--shadow-sm); }
.service-card h3 { font-size: var(--font-size-base); margin-bottom: var(--space-sm); }
.service-card p { font-size: var(--font-size-sm); color: var(--color-secondary); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
.cta-box p { margin-bottom: var(--space-md); }
</style>