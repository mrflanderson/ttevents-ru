---
import Layout from '../components/Layout.astro';

const pageTitle = 'Стратегические сессии и воркшопы';
const pageDescription = 'Организация стратегических сессий и воркшопов для бизнеса. Интерактивные форматы для команд.';
const keywords = 'стратегическая сессия, воркшоп, бизнес-игра';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Стратегические сессии</h1>
            <p>Интерактивные форматы для команд</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <ul class="feature-list mt-2">
                <li>Стратегические сессии</li>
                <li>Бизнес-симуляции</li>
                <li>Командообразующие игры</li>
                <li>Модерация фасилитатора</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Заказать</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>