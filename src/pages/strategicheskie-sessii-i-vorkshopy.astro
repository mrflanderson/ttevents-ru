---
import Layout from "../components/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import FAQ from "../components/FAQ.astro";

const pageTitle =
    "Организация стратегических сессий и воркшопов в Москве — фасилитация для бизнеса | TT Events";
const pageDescription =
    "Профессиональная организация стратегических сессий, воркшопов и фасилитаций. Подбор площадок, модераторов и техническое оснащение. Работаем на результат с 2006 года.";
const keywords =
    "организация стратегической сессии, проведение воркшопов, фасилитация для бизнеса, выездная стратегическая сессия, креативные сессии, TT Events";

const services = [
    {
        title: "Стратегические сессии",
        href: "/strategicheskie-sessii-i-vorkshopy",
        count: 30,
    },
    {
        title: "Воркшопы",
        href: "/strategicheskie-sessii-i-vorkshopy",
        count: 45,
    },
    {
        title: "Фасилитация",
        href: "/strategicheskie-sessii-i-vorkshopy",
        count: 25,
    },
    { title: "Креативные сессии", href: "/korporativy-moskva", count: 35 },
    {
        title: "Брейншторминг",
        href: "/strategicheskie-sessii-i-vorkshopy",
        count: 40,
    },
    { title: "Планёрки", href: "/delovye-meropriyatiya", count: 50 },
];

const faqItems = [
    {
        question: "Что такое стратегическая сессия?",
        answer: "Стратегическая сессия — это структурированное мероприятие для решения бизнес-задач: разработка стратегии, обсуждение проблем, формирование команды.",
    },
    {
        question: "Сколько времени занимает сессия?",
        answer: "Стандартная стратегическая сессия — 1-2 дня. Интенсивный воркшоп — 3-4 часа.",
    },
    {
        question: "Сколько человек может участвовать?",
        answer: "От 8 до 50+ человек. Подбираем формат и площадку под ваш размер команды.",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    canonicalURL="/strategicheskie-sessii-i-vorkshopy"
>
    <!-- Hero Section -->
    <section
        class="relative min-h-[500px] md:min-h-[600px] flex items-center text-white overflow-hidden"
    >
        <img
            src="/images/strategy-hero.jpg"
            alt="Стратегические сессии и воркшопы"
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>

        <div
            class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full"
        >
            <div class="max-w-[800px]">
                <nav class="text-sm text-text-light mb-4">
                    <a href="/" class="hover:text-primary">Главная</a> / <a
                        href="/korporativy-moskva"
                        class="hover:text-primary">Услуги</a
                    > / <span class="font-medium text-text"
                        >Стратегические сессии</span
                    >
                </nav>
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6"
                >
                    Стратегические сессии и воркшопы
                </h1>
                <p class="text-lg md:text-xl text-white/90 mb-10">
                    Профессиональная организация стратегических сессий,
                    воркшопов и фасилитаций для бизнеса. Разработка стратегий и
                    креативных решений.
                </p>
                <a
                    href="/kontakty"
                    class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg hover:shadow-xl transition-all duration-300"
                >
                    Обсудить проект
                </a>
            </div>
        </div>
    </section>

    <!-- Content Section -->
    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="prose prose-lg max-w-none">
                <h2
                    class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                >
                    Форматы деловых мероприятий
                </h2>
                <p class="text-lg text-text-light mb-8">
                    TT Events организует стратегические сессии и воркшопы для
                    корпоративов в Москве. Мы предлагаем разнообразные форматы —
                    от классических стратегических сессий до креативных
                    воркшопов.
                </p>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12"
                >
                    {services.map((service) => <ServiceCard {...service} />)}
                </div>

                <h2
                    class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                >
                    Как мы работаем
                </h2>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12"
                >
                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            01
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Брифинг
                        </h3>
                        <p class="text-text-light text-sm">
                            Определяем цели, задачи и формат мероприятия.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            02
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Программа
                        </h3>
                        <p class="text-text-light text-sm">
                            Разрабатываем программу и подбираем фасилитатора.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            03
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Подготовка
                        </h3>
                        <p class="text-text-light text-sm">
                            Площадка, оборудование, материалы и логистика.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            04
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Проведение
                        </h3>
                        <p class="text-text-light text-sm">
                            Фасилитация, модерация и техническое сопровождение.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            05
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Результат
                        </h3>
                        <p class="text-text-light text-sm">
                            Документирование решений и follow-up.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 md:py-24 bg-gray-50">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2
                    class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4"
                >
                    Часто задаваемые вопросы
                </h2>
            </div>

            <div class="space-y-4">
                {
                    faqItems.map((item) => (
                        <div class="bg-white rounded-xl p-6 shadow-card">
                            <details>
                                <summary class="font-heading font-semibold cursor-pointer text-dark mb-2">
                                    {item.question}
                                </summary>
                                <p class="text-text-light">{item.answer}</p>
                            </details>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section
        class="relative min-h-[400px] flex items-center text-white overflow-hidden py-24"
    >
        <img
            src="/images/strategy-hero.jpg"
            alt=""
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-primary/80"></div>

        <div
            class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center"
        >
            <h2
                class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-6"
            >
                Свяжитесь с нами
            </h2>
            <p class="text-lg md:text-xl text-white/90 mb-10 max-w-2xl mx-auto">
                Предложим формат и рассчитаем бюджет в течение 1 дня
            </p>
            <div
                class="flex flex-col sm:flex-row gap-4 justify-center items-center"
            >
                <a
                    href="tel:+79169064490"
                    class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-white hover:bg-white/90 text-primary shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                >
                    +7 (916) 906-44-90
                </a>
                <a
                    href="/kontakty"
                    class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-transparent border-2 border-white hover:bg-white hover:text-primary text-white shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                >
                    Оставить заявку
                </a>
            </div>
        </div>
    </section>
</Layout>
