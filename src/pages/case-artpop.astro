---
import Layout from '../components/Layout.astro';

const pageTitle = 'Кейс: Арт-pop корпоратив';
const pageDescription = 'Арт-pop корпоратив. Творческий формат мероприятия.';
const keywords = 'арт-поп, креативный корпоратив';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Кейс: Арт-pop</h1>
            <p>Творческий формат мероприятия</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <ul class="feature-list mt-2">
                <li>Творческие мастер-классы</li>
                <li>Арт-направление</li>
                <li>Креативная программа</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="/case" class="btn btn-primary">Все кейсы</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>