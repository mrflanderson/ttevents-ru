---
import Layout from "../components/Layout.astro";
import FAQSection from "../components/sections/FAQSection.astro";

const pageMeta = {
    title: "Онлайн мероприятия в Москве — TT Events",
    description:
        "Организация онлайн мероприятий и гибридных ивентов. Виртуальные конференции, вебинары, онлайн тимбилдинги и презентации.",
    ogTitle: "Онлайн мероприятия в Москве — TT Events",
    ogDescription:
        "Профессиональная организация онлайн мероприятий и гибридных ивентов.",
};

const services = [
    { title: "Онлайн конференции", href: "/onlajn-meropriyatiya" },
    { title: "Виртуальные вебинары", href: "/onlajn-meropriyatiya" },
    { title: "Онлайн тимбилдинги", href: "/onlajn-meropriyatiya" },
    { title: "Гибридные ивенты", href: "/onlajn-meropriyatiya" },
];

const faqItems = [
    {
        question: "Что включает организация онлайн мероприятия?",
        answer: "Разработка сценария, техническое обеспечение, видеосъемка, модерация, координация под ключ.",
    },
    {
        question: "Какой минимальный состав команды?",
        answer: "От 10 человек до 1000+. Подбираем формат под ваш состав.",
    },
    {
        question: "Сколько длится онлайн мероприятие?",
        answer: "От 1 часа до 2 дней. Стандарт — 2-4 часа.",
    },
];
---

<!--
  TT Events — Tailwind CSS Migration
  Generated on: 2026-05-17
-->
<Layout {...pageMeta}>
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4" aria-label="Навигация">
                <a href="/" class="hover:text-primary">Главная</a> / <span
                    class="font-medium text-text"
                    aria-current="page">Онлайн мероприятия</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Онлайн мероприятия в Москве
            </h1>
            <p class="text-lg text-text-light max-w-3xl mb-12">
                Организация онлайн мероприятий и гибридных ивентов. Виртуальные
                конференции, вебинары, онлайн тимбилдинги и презентации.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    services.map((service) => (
                        <a
                            href={service.href}
                            class="block p-6 bg-white rounded-xl shadow-card hover:shadow-card-hover transition-all duration-300"
                            aria-label={service.title}
                        >
                            <h3 class="text-xl font-heading font-semibold text-dark hover:text-primary transition-colors">
                                {service.title}
                            </h3>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <FAQSection items={faqItems} />
</Layout>
