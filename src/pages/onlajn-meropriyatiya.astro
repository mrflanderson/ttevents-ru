---
import Layout from '../components/Layout.astro';

const pageTitle = 'Онлайн-мероприятия';
const pageDescription = 'Организация онлайн-мероприятий. Вебинары, стримы, гибридные форматы.';
const keywords = 'онлайн мероприятие, вебинар, онлайн конференция, стрим';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Онлайн-мероприятия</h1>
            <p> мероприятия в цифровом формате</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <ul class="feature-list mt-2">
                <li>Вебинары</li>
                <li>Онлайн-конференции</li>
                <li>Стримы</li>
                <li>Гибридные форматы</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Заказать</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>