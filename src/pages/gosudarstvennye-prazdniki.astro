---
import Layout from '../components/Layout.astro';

const pageTitle = 'Государственные праздники';
const pageDescription = 'Организация мероприятий к государственным праздникам. День Победы, Новый год, 8 Марта.';
const keywords = 'государственный праздник, 9 Мая, День Победы';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Государственные праздники</h1>
            <p>Мероприятия к праздничным датам</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <ul class="feature-list mt-2">
                <li>9 Мая — День Победы</li>
                <li>Новый год</li>
                <li>8 Марта</li>
                <li>23 Февраля</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Заказать</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>