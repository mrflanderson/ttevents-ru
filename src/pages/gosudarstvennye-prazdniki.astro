---
import Layout from "../components/Layout.astro";
import FAQSection from "../components/sections/FAQSection.astro";

const pageMeta = {
    title: "Государственные праздники — организация мероприятий в Москве — TT Events",
    description:
        "Организация мероприятий на государственные праздники: концерты, парады, патриотические события и культурные программы. Незабываемое празднование Дня Победы, Дня России и других государственных праздников.",
    ogTitle:
        "Государственные праздники — организация мероприятий в Москве — TT Events",
    ogDescription:
        "Профессиональная организация мероприятий на государственные праздники с 2006 года.",
};

const services = [
    { title: "День Победы", href: "/gosudarstvennye-prazdniki" },
    { title: "День России", href: "/gosudarstvennye-prazdniki" },
    { title: "Новый год", href: "/gosudarstvennye-prazdniki" },
    { title: "Парады и концерты", href: "/gosudarstvennye-prazdniki" },
];

const faqItems = [
    {
        question:
            "Что включает организация мероприятия на государственный праздник?",
        answer: "Разработка концепции, подбор площадки, техническое обеспечение, ведение программы, логистика и полный цикл реализации.",
    },
    {
        question: "Какой минимальный состав команды?",
        answer: "От 10 человек до 1000+. Подбираем формат под ваш состав.",
    },
    {
        question: "Сколько длится мероприятие?",
        answer: "От 2 часов до 3 дней. Стандарт — 4-6 часов.",
    },
];
---

<!--
  TT Events — Tailwind CSS Migration
  Generated on: 2026-05-17
-->
<Layout {...pageMeta}>
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4" aria-label="Навигация">
                <a href="/" class="hover:text-primary">Главная</a> / <span
                    class="font-medium text-text"
                    aria-current="page">Государственные праздники</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Государственные праздники
            </h1>
            <p class="text-lg text-text-light max-w-3xl mb-12">
                Профессиональная организация мероприятий на государственные
                праздники: концерты, парады, патриотические события и культурные
                программы. Мы обеспечим незабываемое празднование Дня Победы,
                Дня России и других государственных праздников.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    services.map((service) => (
                        <a
                            href={service.href}
                            class="block p-6 bg-white rounded-xl shadow-card hover:shadow-card-hover transition-all duration-300"
                            aria-label={service.title}
                        >
                            <h3 class="text-xl font-heading font-semibold text-dark hover:text-primary transition-colors">
                                {service.title}
                            </h3>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <FAQSection items={faqItems} />

    <section class="py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="text-sm text-text-light">
                Государственные праздники и мероприятия →
                <a href="/services/festivals/public-holidays" class="underline hover:text-primary">
                    /services/festivals/public-holidays
                </a>
            </p>
        </div>
    </section>
</Layout>
