---
import {definePageMeta} from 'astro:content';
import { seo } from '@/components/SEO.astro';

const pageData = {
  title: `Организация мероприятий на государственные праздники | TT Event`,
  description: `Профессиональная организация мероприятий на государственные праздники: концерты, парады, патриотические события и культурные программы. Мы обеспечим незабываемое празднование Дня Победы, Дня России и других государственных праздников.`,
  keywords: `государственные праздники, организация мероприятий, День Победы, День России, патриотические концерты, культурные события, мероприятия на праздники, парады, торжественные мероприятия`,
};

const seoMeta = {
  ogTitle: ``,
  ogDescription: ``,
  ogImage: ``,
};

export const pageMeta = definePageMeta(() => ({
  seo: {
    title: pageData.title,
    description: pageData.description,
    keywords: pageData.keywords,
    ogTitle: seoMeta.ogTitle,
    ogDescription: seoMeta.ogDescription,
    ogImage: seoMeta.ogImage,
  },
}));

export { pageData, seoMeta };
