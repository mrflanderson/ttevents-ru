---
import Layout from "../components/Layout.astro";

const pageTitle = "Почему русские народные мотивы популярны в корпоративах";
const pageDescription =
    "Русские народные мотивы в корпоративных мероприятиях: почему этот стиль популярен и как его использовать без стереотипов.";
const keywords =
    "русские народные мотивы, корпоратив в стиле русских традиций, народный стиль корпоратив";
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="py-16 md:py-24">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4">
                <a href="/" class="hover:text-primary">Главная</a> / <a
                    href="/blog"
                    class="hover:text-primary">Блог</a
                > / <span class="font-medium text-text"
                    >Русские народные мотивы</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                Почему русские народные мотивы популярны в корпоративах
            </h1>
            <div class="prose prose-lg max-w-none">
                <p class="text-lg text-text-light mb-6">
                    Русский стиль в корпоративах — это не только матрешки и
                    хороводы. Современные агентства адаптируют народные мотивы
                    через искусство, музыку и театрализацию.
                </p>
                <h2 class="text-2xl font-heading font-bold text-dark mb-4 mt-8">
                    Современный подход
                </h2>
                <p class="text-text-light mb-6">
                    Народные мотивы интегрируются через сценографию, костюмы и
                    музыку. Гости погружаются в атмосферу через современные
                    технологии и живое исполнение.
                </p>
            </div>
        </div>
    </div>
</Layout>
