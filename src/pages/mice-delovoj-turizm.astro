---
import Layout from '../components/Layout.astro';

const pageTitle = 'Деловой туризм';
const pageDescription = 'Деловой туризм и выездные мероприятия. Комбинированные программы с отдыхом и бизнесом.';
const keywords = 'деловой туризм, выездное мероприятие, инcentive';
---

<Layout title={pageTitle} description={pageDescription} keywords={keywords}>
    <div class="page-header">
        <div class="container">
            <h1>Деловой туризм</h1>
            <p>Выездные мероприятия и инcentive-туры</p>
        </div>
    </div>
    <div class="page-content">
        <div class="container">
            <ul class="feature-list mt-2">
                <li>Инcentive-туры</li>
                <li>Выездные сессии</li>
                <li>Комбинированные программы</li>
                <li>Базы отдыха</li>
            </ul>
            <div class="cta-box mt-2 text-center">
                <a href="tel:+79169064490" class="btn btn-primary">Заказать</a>
            </div>
        </div>
    </div>
</Layout>

<style>
.feature-list { list-style: disc; padding-left: var(--space-xl); }
.cta-box { background: var(--color-light); padding: var(--space-xl); border-radius: var(--radius-md); }
</style>