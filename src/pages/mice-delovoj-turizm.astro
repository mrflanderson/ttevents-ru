---
import Layout from "../components/Layout.astro";
import FAQSection from "../components/sections/FAQSection.astro";

const pageMeta = {
    title: "MICE и деловой туризм в Москве — TT Events",
    description:
        "Организация MICE мероприятий и делового туризма. Конференции, форумы, семинары, incentive-туры и корпоративный отдых для команд любого масштаба.",
    ogTitle: "MICE и деловой туризм в Москве — TT Events",
    ogDescription:
        "Профессиональная организация MICE мероприятий и делового туризма.",
};

const services = [
    { title: "Конференции", href: "/konferencii-i-forumy" },
    { title: "Семинары и тренинги", href: "/seminary-i-treningi" },
    { title: "Incentive-туры", href: "/mice-delovoj-turizm" },
    {
        title: "Стратегические сессии",
        href: "/strategicheskie-sessii-i-vorkshopy",
    },
];

const faqItems = [
    {
        question: "Что включает организация MICE мероприятия?",
        answer: "Разработка программы, подбор площадки, техническое обеспечение, организация трансферов, питание и полный цикл реализации.",
    },
    {
        question: "Какой минимальный состав команды?",
        answer: "От 10 человек до 1000+. Подбираем формат под ваш состав.",
    },
    {
        question: "Сколько длится MICE мероприятие?",
        answer: "От 1 дня до 1 недели. Стандарт — 1-3 дня.",
    },
];
---

<!--
  TT Events — Tailwind CSS Migration
  Generated on: 2026-05-17
-->
<Layout {...pageMeta}>
    <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <nav class="text-sm text-text-light mb-4" aria-label="Навигация">
                <a href="/" class="hover:text-primary">Главная</a> / <span
                    class="font-medium text-text"
                    aria-current="page">MICE</span
                >
            </nav>
            <h1
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-dark font-heading mb-8"
            >
                MICE и деловой туризм в Москве
            </h1>
            <p class="text-lg text-text-light max-w-3xl mb-12">
                Организация MICE мероприятий и делового туризма. Конференции,
                форумы, семинары, incentive-туры и корпоративный отдых для
                команд любого масштаба.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    services.map((service) => (
                        <a
                            href={service.href}
                            class="block p-6 bg-white rounded-xl shadow-card hover:shadow-card-hover transition-all duration-300"
                            aria-label={service.title}
                        >
                            <h3 class="text-xl font-heading font-semibold text-dark hover:text-primary transition-colors">
                                {service.title}
                            </h3>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <FAQSection items={faqItems} />
</Layout>
