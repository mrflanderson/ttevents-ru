---
import Layout from "../components/Layout.astro";
import ServiceCard from "../components/ServiceCard.astro";
import FAQ from "../components/FAQ.astro";

const pageTitle =
    "Тендеры и госзакупки (44-ФЗ / 223-ФЗ) — организация мероприятий для государственных структур | TT Events";
const pageDescription =
    "Тендеры и госзакупки (44-ФЗ / 223-ФЗ): организация мероприятий для государственных структур, школ, вузов и корпораций. Полный цикл по тендерной документации.";
const keywords =
    "тендеры москва, госзакупки мероприятий, 44-ФЗ 223-ФЗ, тендер на организацию праздника, государственные закупки событий";

const services = [
    { title: "Тендеры 44-ФЗ", href: "/tendery", count: 120 },
    { title: "Госзакупки 223-ФЗ", href: "/tendery", count: 85 },
    {
        title: "Образовательные мероприятия",
        href: "/seminary-i-treningi",
        count: 90,
    },
    {
        title: "Корпоративные праздники",
        href: "/korporativy-moskva",
        count: 150,
    },
    { title: "Деловые мероприятия", href: "/delovye-meropriyatiya", count: 70 },
    {
        title: "Спортивные мероприятия",
        href: "/sportivnye-meropriyatiya",
        count: 60,
    },
];

const faqItems = [
    {
        question: "С какой документацией вы работаете?",
        answer: "С 44-ФЗ, 223-ФЗ, ЕИС, а также с внутренними закупочными процедурами корпораций.",
    },
    {
        question: "Какие объекты вы обслуживаете?",
        answer: "Государственные учреждения, школы, вузы, больницы, корпорации, муниципалитеты.",
    },
    {
        question: "Как происходит оплата по тендеру?",
        answer: "Банковские переводы, аккредитация у заказчика, работа по договору. Полное сопровождение.",
    },
];
---

<Layout
    title={pageTitle}
    description={pageDescription}
    keywords={keywords}
    canonicalURL="/tendery"
>
    <!-- Hero Section -->
    <section
        class="relative min-h-[500px] md:min-h-[600px] flex items-center text-white overflow-hidden"
    >
        <img
            src="/images/tender-hero.jpg"
            alt="Тендеры и госзакупки — организация мероприятий"
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black/50"></div>

        <div
            class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full"
        >
            <div class="max-w-[800px]">
                <nav class="text-sm text-text-light mb-4">
                    <a href="/" class="hover:text-primary">Главная</a> / <a
                        href="/korporativy-moskva"
                        class="hover:text-primary">Услуги</a
                    > / <span class="font-medium text-text">Тендеры</span>
                </nav>
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold mb-6"
                >
                    Тендеры и госзакупки
                </h1>
                <p class="text-lg md:text-xl text-white/90 mb-10">
                    Организация мероприятий для государственных структур по
                    тендерной документации 44-ФЗ и 223-ФЗ. Полный цикл
                    сопровождения.
                </p>
                <a
                    href="/kontakty"
                    class="inline-flex items-center justify-center px-6 py-3 rounded-lg font-semibold bg-primary hover:bg-primary-dark text-white shadow-lg hover:shadow-xl transition-all duration-300"
                >
                    Обсудить проект
                </a>
            </div>
        </div>
    </section>

    <!-- Content Section -->
    <section class="py-16 md:py-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="prose prose-lg max-w-none">
                <h2
                    class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                >
                    Форматы мероприятий для тендеров
                </h2>
                <p class="text-lg text-text-light mb-8">
                    TT Events организует мероприятия для государственных
                    структур по тендерной документации. Мы предлагаем
                    разнообразные форматы — от праздников до деловых
                    мероприятий.
                </p>

                <div
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 mb-12"
                >
                    {services.map((service) => <ServiceCard {...service} />)}
                </div>

                <h2
                    class="text-2xl md:text-3xl font-heading font-bold text-dark mb-6"
                >
                    Как мы работаем
                </h2>
                <div
                    class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12"
                >
                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            01
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Анализ тендера
                        </h3>
                        <p class="text-text-light text-sm">
                            Изучаем требования и формируем предложение.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            02
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Подготовка заявки
                        </h3>
                        <p class="text-text-light text-sm">
                            Формируем полный пакет документов.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            03
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Планирование
                        </h3>
                        <p class="text-text-light text-sm">
                            Разрабатываем программу и бюджет.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            04
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Проведение
                        </h3>
                        <p class="text-text-light text-sm">
                            Организация мероприятия по договору.
                        </p>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow-card">
                        <div class="text-primary text-2xl font-bold mb-3">
                            05
                        </div>
                        <h3 class="text-lg font-heading font-semibold mb-2">
                            Отчётность
                        </h3>
                        <p class="text-text-light text-sm">
                            Акт выполненных работ и фотоотчёт.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-16 md:py-24 bg-gray-50">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2
                    class="text-3xl md:text-4xl font-heading font-bold text-dark mb-4"
                >
                    Часто задаваемые вопросы
                </h2>
            </div>

            <div class="space-y-4">
                {
                    faqItems.map((item) => (
                        <div class="bg-white rounded-xl p-6 shadow-card">
                            <details>
                                <summary class="font-heading font-semibold cursor-pointer text-dark mb-2">
                                    {item.question}
                                </summary>
                                <p class="text-text-light">{item.answer}</p>
                            </details>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section
        class="relative min-h-[400px] flex items-center text-white overflow-hidden py-24"
    >
        <img
            src="/images/tender-hero.jpg"
            alt=""
            class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-primary/80"></div>

        <div
            class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full text-center"
        >
            <h2
                class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold mb-6"
            >
                Свяжитесь с нами
            </h2>
            <p class="text-lg md:text-xl text-white/90 mb-10 max-w-2xl mx-auto">
                Предложим формат и рассчитаем бюджет в течение 1 дня
            </p>
            <div
                class="flex flex-col sm:flex-row gap-4 justify-center items-center"
            >
                <a
                    href="tel:+79169064490"
                    class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-white hover:bg-white/90 text-primary shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                >
                    +7 (916) 906-44-90
                </a>
                <a
                    href="/kontakty"
                    class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-semibold bg-transparent border-2 border-white hover:bg-white hover:text-primary text-white shadow-lg hover:shadow-xl transition-all duration-300 text-lg"
                >
                    Оставить заявку
                </a>
            </div>
        </div>
    </section>
</Layout>
